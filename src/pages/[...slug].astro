---
const lang = 'it' as const;
const slug = Astro.params.slug ?? 'home';

// Astro's router matches this catch-all instead of the dedicated `news/[slug].astro`
// or `formazione/[slug].astro` for `/news/<article>` and `/formazione/<resource>`
// (a nested single-segment dynamic route losing to this root rest-param route —
// reproducible in both `astro dev` and the deployed Cloudflare Worker; root cause
// not identified after investigation). Rendering the article/resource here directly,
// via the same components the dedicated routes use, sidesteps that routing bug
// rather than depending on a fix landing in Astro itself.
//
// Imported dynamically (not as a static top-level import) so each dependency chain
// only loads for its own section's requests — a static import would pull all of
// them into every single page's module graph, including the homepage, and (in this
// project's Cloudflare Workers dev runtime) crashes the entire route table with
// `ReferenceError: document is not defined` the moment any route touches this file.
// See src/lib/tina-rich-text.ts for a related, separate `document is not defined`:
// rendering the rich-text field via `<StaticTinaMarkdown>` JSX crashes under
// @astrojs/react's renderer pipeline on this runtime regardless of static/dynamic
// import, so that field is rendered via a direct react-dom/server call instead.
const newsSlug = slug.startsWith('news/') ? slug.slice('news/'.length) : null;
const resourceSlug = slug.startsWith('formazione/') ? slug.slice('formazione/'.length) : null;
// The Interact sub-section ('interact', 'interact/storia', ...) never collides with
// interact/eventi/<year>/<slug> — that two-segment shape is already caught by the dedicated
// src/pages/interact/eventi/[year]/[slug].astro route before Astro falls back to this catch-all
// (same safe shape as the Rotaract eventi/[year]/[slug].astro route, which needs no guard here
// either — only single-segment nested dynamic routes like news/formazione do, see above).
const interactSlug = slug === 'interact' || slug.startsWith('interact/') ? slug : null;
const NewsArticleView = newsSlug !== null ? (await import('../components/NewsArticleView.astro')).default : null;
const ResourceView = resourceSlug !== null ? (await import('../components/ResourceView.astro')).default : null;
const InteractPageView = interactSlug !== null ? (await import('../components/InteractPageView.astro')).default : null;
const GenericPageView =
	newsSlug === null && resourceSlug === null && interactSlug === null ? (await import('../components/GenericPageView.astro')).default : null;
---

{NewsArticleView && newsSlug !== null ? (
	<NewsArticleView lang={lang} slug={newsSlug} />
) : ResourceView && resourceSlug !== null ? (
	<ResourceView lang={lang} slug={resourceSlug} />
) : InteractPageView && interactSlug !== null ? (
	<InteractPageView lang={lang} slug={interactSlug} />
) : GenericPageView ? (
	<GenericPageView lang={lang} slug={slug} />
) : null}
