---
import { requestWithMetadata, tinaField } from '@tinacms/astro';
import client from '../../../../tina/__generated__/client';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageBanner from '../../../components/PageBanner.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { Image } from 'astro:assets';
import ImageSlot from '../../../components/ImageSlot.astro';
import { uiStrings } from '../../../data/ui-strings';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { localizeEvent, eventTags, isUpcomingEvent } from '../../../lib/events';
import { tagPillStyle } from '../../../lib/news';
import { buildEventJsonLd } from '../../../lib/jsonld';

const lang = 'en' as const;
const t = uiStrings[lang];
const slug = Astro.params.slug ?? '';
const relativePath = `${slug}.md`;

const result = await requestWithMetadata(client.queries.events({ relativePath }), { priority: 'primary' });
const event = result.data.events;

// A non-visible event must not stay reachable via a direct URL either, even once it drops from the archive.
if (!event || event.visible === false) {
	return Astro.redirect(getRelativeLocaleUrl(lang, 'eventi'));
}

const dateFormatter = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const tags = eventTags(event);
const localized = localizeEvent(event, lang);
const titleField = event.titleEn ? 'titleEn' : 'title';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const jsonLd = buildEventJsonLd({
	name: localized.title,
	description: localized.excerpt,
	startDate: event.date,
	imageUrl: new URL(event.image || '/uploads/Loghi/Logo-distretto.png', Astro.site).toString(),
	url: canonicalUrl.toString(),
	locationName: event.locationLavori || event.locationCena,
});
---

<BaseLayout
	lang={lang}
	current="eventi"
	title={localized.title}
	description={localized.excerpt || t.events.empty}
	alternateHref={getRelativeLocaleUrl('it', `eventi/${slug}`)}
	image={event.image}
	type="article"
	publishedTime={event.date}
>
	<PageBanner
		lang={lang}
		eyebrow={t.events.detailEyebrow}
		title={localized.title}
		breadcrumbCurrent={t.nav.eventi}
		titleField={tinaField(event, titleField)}
	/>
	<article class="event-detail">
		<div class="event-detail-inner">
			<a href={getRelativeLocaleUrl(lang, 'eventi')} class="back-link">{t.events.backToArchive}</a>
			<div class="event-detail-meta">
				{tags.length > 0 && (
					<div class="event-detail-tags">
						{tags.map((tag) => (
							<span class="event-detail-tag" style={tagPillStyle(tag.color)}>{tag.label}</span>
						))}
					</div>
				)}
				<span class="event-detail-date" data-tina-field={tinaField(event, 'date')}>
					{isUpcomingEvent(event.date) && <span class="event-detail-upcoming-badge">{t.events.upcomingBadge}</span>}
					{dateFormatter.format(new Date(event.date))}
				</span>
			</div>
			<div data-tina-field={tinaField(event, 'image')}>
				{event.image ? (
					<Image
						src={event.image}
						alt={localized.imageLabel}
						width={960}
						height={420}
						fit="cover"
						style={`--focal-x:${event.imageFocalX ?? 50}%;--focal-y:${event.imageFocalY ?? 50}%;`}
						quality="high"
						class="event-detail-image"
					/>
				) : (
					<ImageSlot label={localized.imageLabel} class="event-detail-image" />
				)}
			</div>
			{event.locationLavori && event.locationCena ? (
				<div class="event-detail-locations">
					<div><span class="event-detail-location-label">{t.events.worksLocationLabel}:</span> {event.locationLavori}</div>
					<div><span class="event-detail-location-label">{t.events.dinnerLocationLabel}:</span> {event.locationCena}</div>
				</div>
			) : (
				(event.locationLavori || event.locationCena) && (
					<div class="event-detail-locations">
						<div><span class="event-detail-location-label">{t.events.locationLabel}:</span> {event.locationLavori || event.locationCena}</div>
					</div>
				)
			)}
			{localized.excerpt && <p class="event-detail-excerpt">{localized.excerpt}</p>}
			{(event.ticketsUrl || event.photoAlbumUrl) && (
				<div class="event-detail-actions">
					{event.ticketsUrl && (
						<a class="event-detail-tickets-btn" href={event.ticketsUrl} target="_blank" rel="noopener">
							{t.events.ticketsButtonLabel}
						</a>
					)}
					{event.photoAlbumUrl && (
						<a class="event-detail-photo-btn" href={event.photoAlbumUrl} target="_blank" rel="noopener">
							{t.events.photoButtonLabel}
						</a>
					)}
				</div>
			)}
			{event.ticketWidgetEmbed && (
				<div class="event-detail-ticket-widget" set:html={event.ticketWidgetEmbed} />
			)}
		</div>
	</article>
	<JsonLd data={jsonLd} />
</BaseLayout>

<style>
	.event-detail {
		background: #fff;
		padding: 50px 40px 90px;
	}

	.event-detail-inner {
		max-width: 760px;
		margin: 0 auto;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 24px;
		color: var(--color-pink);
		font-weight: 700;
		font-size: 14px;
	}

	.back-link:hover {
		text-decoration: underline;
	}

	.event-detail-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px 14px;
		margin-bottom: 20px;
	}

	.event-detail-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.event-detail-tag {
		display: inline-block;
		background: var(--tag-bg, rgba(212, 19, 103, 0.1));
		color: var(--tag-color, var(--color-pink));
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		padding: 4px 10px;
		border-radius: 999px;
	}

	.event-detail-date {
		font-size: 12px;
		color: var(--color-muted);
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.event-detail-upcoming-badge {
		display: inline-block;
		background: var(--color-gold);
		color: var(--color-navy);
		font-weight: 700;
		font-size: 11px;
		letter-spacing: 0.5px;
		padding: 3px 9px;
		border-radius: 999px;
		margin-right: 8px;
	}

	.event-detail-inner :global(.event-detail-image) {
		width: 100%;
		height: 340px;
		object-fit: cover;
		border-radius: 14px;
		margin-bottom: 24px;
	}

	.event-detail-locations {
		font-size: 15px;
		color: var(--color-text);
		line-height: 1.7;
		margin-bottom: 20px;
	}

	.event-detail-location-label {
		color: var(--color-pink);
		font-weight: 700;
	}

	.event-detail-excerpt {
		font-size: 16px;
		color: var(--color-text);
		line-height: 1.75;
		margin: 0 0 24px;
	}

	.event-detail-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.event-detail-tickets-btn {
		display: inline-block;
		background: var(--color-pink);
		color: #fff;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 13px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		padding: 10px 20px;
		border-radius: 999px;
	}

	.event-detail-tickets-btn:hover {
		background: var(--color-pink-dark);
		color: #fff;
	}

	.event-detail-photo-btn {
		display: inline-block;
		background: transparent;
		color: var(--color-navy);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 13px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		padding: 8px 18px;
		border-radius: 999px;
		border: 2px solid var(--color-navy);
	}

	.event-detail-photo-btn:hover {
		background: var(--color-navy);
		color: #fff;
	}
	.event-detail-ticket-widget {
		margin-top: 32px;
	}


	@media (max-width: 720px) {
		.event-detail {
			padding: 40px 20px 60px;
		}

		.event-detail-inner :global(.event-detail-image) {
			height: 220px;
		}
	}
</style>
