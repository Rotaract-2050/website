---
const lang = 'en' as const;
const slug = Astro.params.slug ?? 'home';

// See src/pages/[...slug].astro for why this guard (and the dynamic import) exists —
// same routing issue affects /en/news/<article> and /en/formazione/<resource> too.
const newsSlug = slug.startsWith('news/') ? slug.slice('news/'.length) : null;
const resourceSlug = slug.startsWith('formazione/') ? slug.slice('formazione/'.length) : null;
const NewsArticleView = newsSlug !== null ? (await import('../../components/NewsArticleView.astro')).default : null;
const ResourceView = resourceSlug !== null ? (await import('../../components/ResourceView.astro')).default : null;
const GenericPageView = newsSlug === null && resourceSlug === null ? (await import('../../components/GenericPageView.astro')).default : null;
---

{NewsArticleView && newsSlug !== null ? (
	<NewsArticleView lang={lang} slug={newsSlug} />
) : ResourceView && resourceSlug !== null ? (
	<ResourceView lang={lang} slug={resourceSlug} />
) : GenericPageView ? (
	<GenericPageView lang={lang} slug={slug} />
) : null}
