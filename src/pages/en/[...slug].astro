---
import { requestWithMetadata } from '@tinacms/astro';
import client from '../../../tina/__generated__/client';
import { getRelativeLocaleUrl } from 'astro:i18n';
const lang = 'en' as const;
const slug = Astro.params.slug ?? 'home';

// See src/pages/[...slug].astro for why this guard (and the dynamic import) exists —
// same routing issue affects /en/news/<article> and /en/formazione/<resource> too.
const newsSlug = slug.startsWith('news/') ? slug.slice('news/'.length) : null;
const resourceSlug = slug.startsWith('formazione/') ? slug.slice('formazione/'.length) : null;
// The Interact sub-section ('interact', 'interact/storia', ...) never collides with
// interact/eventi/<year>/<slug> — that two-segment shape is already caught by the dedicated
// src/pages/en/interact/eventi/[year]/[slug].astro route before Astro falls back to this
// catch-all (same safe shape as the Rotaract eventi/[year]/[slug].astro route, which needs no
// guard here either — only single-segment nested dynamic routes like news/formazione do).
const interactSlug = slug === 'interact' || slug.startsWith('interact/') ? slug : null;
const NewsArticleView = newsSlug !== null ? (await import('../../components/NewsArticleView.astro')).default : null;
const ResourceView = resourceSlug !== null ? (await import('../../components/ResourceView.astro')).default : null;
const InteractPageView = interactSlug !== null ? (await import('../../components/InteractPageView.astro')).default : null;
const isGeneric = newsSlug === null && resourceSlug === null && interactSlug === null;
const GenericPageView = isGeneric ? (await import('../../components/GenericPageView.astro')).default : null;

// Existence check for generic pages lives HERE, not in GenericPageView: Astro.rewrite() (like status/headers)
// only works from a page's frontmatter, before the response starts streaming. Called from inside a component
// it yields a blank 200. The fetched result is passed down so GenericPageView doesn't query again.
let pageResult: Awaited<ReturnType<typeof requestWithMetadata<any>>> | null = null;
if (isGeneric) {
	try {
		const r = await requestWithMetadata(client.queries.pages({ relativePath: `${slug}.md` }), { priority: 'primary' });
		pageResult = r?.data?.pages ? r : null;
	} catch {
		// requestWithMetadata normally logs a warning and returns undefined for a missing doc (handled above); catch covers a throw.
		pageResult = null;
	}
	if (!pageResult) return Astro.rewrite(getRelativeLocaleUrl(lang, '404'));
}
---

{NewsArticleView && newsSlug !== null ? (
	<NewsArticleView lang={lang} slug={newsSlug} />
) : ResourceView && resourceSlug !== null ? (
	<ResourceView lang={lang} slug={resourceSlug} />
) : InteractPageView && interactSlug !== null ? (
	<InteractPageView lang={lang} slug={interactSlug} />
) : GenericPageView && pageResult ? (
	<GenericPageView lang={lang} slug={slug} result={pageResult} />
) : null}
