---
import client from '../../../../tina/__generated__/client';
import { getRelativeLocaleUrl } from 'astro:i18n';
import ServiceArticleView from '../../../components/ServiceArticleView.astro';
import { fetchTinaDoc } from '../../../lib/tina-doc';

const lang = 'en' as const;
const slug = Astro.params.slug ?? '';

// Existence check in the page frontmatter (rewrite/status don't work from a component, see lib/tina-doc.ts).
const result = await fetchTinaDoc(client.queries.services({ relativePath: `${slug}.md` }), 'services');
if (!result) return Astro.rewrite(getRelativeLocaleUrl(lang, '404'));
---

<ServiceArticleView lang={lang} slug={slug} result={result} />
