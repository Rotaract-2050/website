---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import JsonLd from '../components/JsonLd.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { requestWithMetadata } from '@tinacms/astro';
import client from '../../tina/__generated__/client';
import type { Lang } from '../data/ui-strings';
import { SITE_NAME, DEFAULT_OG_IMAGE } from '../data/ui-strings';
import { pageSlugs, type PageKey } from '../data/routes';
import { buildOrganizationGraph } from '../lib/jsonld';
import '../styles/global.css';

interface Props {
	lang: Lang;
	current: PageKey;
	title: string;
	description: string;
	/** Override the auto-computed hreflang alternate, e.g. for a dynamic sub-page like a club detail. */
	alternateHref?: string;
	/** Social-share image (page/article/event-specific). Falls back to settings.defaultOgImage, then the district logo. */
	image?: string | null;
	type?: 'website' | 'article';
	publishedTime?: string;
	noindex?: boolean;
}

const {
	lang,
	current,
	title,
	description,
	alternateHref: alternateHrefProp,
	image,
	type = 'website',
	publishedTime,
	noindex = false,
} = Astro.props;
const otherLang: Lang = lang === 'it' ? 'en' : 'it';
const alternateHref = alternateHrefProp ?? getRelativeLocaleUrl(otherLang, pageSlugs[current]);

const { data } = await requestWithMetadata(client.queries.settings({ relativePath: `${lang}.md` }), { priority: 'primary' });
const settings = data.settings;
const resolvedImage = image || settings.defaultOgImage || DEFAULT_OG_IMAGE;
const pageTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const organizationGraph = buildOrganizationGraph(
	{ about: settings.about, logo: new URL(settings.logo || DEFAULT_OG_IMAGE, Astro.site).toString() },
	Astro.site!.toString()
);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Dancing+Script:wght@600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
		<SeoHead
			lang={lang}
			title={title}
			description={description}
			alternateHref={alternateHref}
			image={resolvedImage}
			type={type}
			publishedTime={publishedTime}
			noindex={noindex}
			twitterHandle={settings.twitterHandle}
		/>
		<JsonLd data={organizationGraph} />
	</head>
	<body>
		<div class="page">
			<Header lang={lang} current={current} />
			<main>
				<slot />
			</main>
			<Footer lang={lang} settings={settings} />
		</div>
	</body>
</html>

<style>
	.page {
		background: var(--color-bg);
		min-height: 100vh;
	}
</style>

<script>
	console.log(
		'%c ROTARACT %c DISTRETTO 2050 %c\n\nConfezionato con cura da Alessandro Gorla & Gabriele Groppo',
		'background:#d41367;color:#fff;font-weight:700;padding:6px 12px;border-radius:6px 0 0 6px;font-family:"Open Sans",sans-serif;font-size:13px;',
		'background:#17458f;color:#f7a81b;font-weight:700;padding:6px 12px;border-radius:0 6px 6px 0;font-family:"Open Sans",sans-serif;font-size:13px;',
		'color:#54565a;font-style:italic;font-family:"Open Sans",sans-serif;font-size:12px;'
	);

	function initScrollReveal() {
		const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
		if (!els.length) return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;

		els.forEach((el) => el.classList.add('reveal-init'));

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				}
			},
			// threshold: 0.12 + a shrunk root worked for short sections, but a tall one (e.g.
			// CommitteeGrid's stacked commission cards) needs 12% of its own height scrolled
			// into view before it fires — long enough that you'd scroll past still-invisible
			// content first. Fire on the first visible pixel instead, so reveal never lags
			// behind scroll regardless of how tall the target is.
			{ threshold: 0, rootMargin: '0px 0px 0px 0px' }
		);

		els.forEach((el) => observer.observe(el));
	}

	initScrollReveal();
</script>
