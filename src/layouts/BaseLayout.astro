---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../data/ui-strings';
import { pageSlugs, type PageKey } from '../data/routes';
import '../styles/global.css';

interface Props {
	lang: Lang;
	current: PageKey;
	title: string;
	description: string;
	/** Override the auto-computed hreflang alternate, e.g. for a dynamic sub-page like a club detail. */
	alternateHref?: string;
}

const { lang, current, title, description, alternateHref: alternateHrefProp } = Astro.props;
const otherLang: Lang = lang === 'it' ? 'en' : 'it';
const alternateHref = alternateHrefProp ?? getRelativeLocaleUrl(otherLang, pageSlugs[current]);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<SeoHead lang={lang} title={title} description={description} alternateHref={alternateHref} />
	</head>
	<body>
		<div class="page">
			<Header lang={lang} current={current} />
			<main>
				<slot />
			</main>
			<Footer lang={lang} />
		</div>
	</body>
</html>

<style>
	.page {
		background: var(--color-bg);
		min-height: 100vh;
	}
</style>

<script>
	function initScrollReveal() {
		const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
		if (!els.length) return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;

		els.forEach((el) => el.classList.add('reveal-init'));

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				}
			},
			{ threshold: 0.12, rootMargin: '0px 0px -10% 0px' }
		);

		els.forEach((el) => observer.observe(el));
	}

	initScrollReveal();
</script>
