---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InteractHeader from '../components/InteractHeader.astro';
import InteractFooter from '../components/InteractFooter.astro';
import SeoHead from '../components/SeoHead.astro';
import JsonLd from '../components/JsonLd.astro';
import FormazioneChatWidget from '../components/FormazioneChatWidget.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { requestWithMetadata } from '@tinacms/astro';
import client from '../../tina/__generated__/client';
import type { Lang } from '../data/ui-strings';
import { SITE_NAME, DEFAULT_OG_IMAGE, SOCIAL_LINKS } from '../data/ui-strings';
import { pageSlugs, type PageKey } from '../data/routes';
import { buildOrganizationGraph } from '../lib/jsonld';
import { isProdHost } from '../lib/env';
import '../styles/global.css';
import '../styles/interact-theme.css';

interface Props {
	lang: Lang;
	current: PageKey;
	title: string;
	description: string;
	/** Override the auto-computed hreflang alternate, e.g. for a dynamic sub-page like a club detail. */
	alternateHref?: string;
	/** Social-share image (page/article/event-specific). Falls back to settings.defaultOgImage, then the district logo. */
	image?: string | null;
	type?: 'website' | 'article';
	publishedTime?: string;
	noindex?: boolean;
	/** Which header/footer + color theme to render — see src/styles/interact-theme.css. Default
	 * 'rotaract' keeps today's exact behavior (Header/Footer, no [data-theme] attribute). */
	theme?: 'rotaract' | 'interact';
	/** "<title> | X" suffix override — the Interact sub-section uses its own site name instead
	 * of SITE_NAME ("Rotaract Distretto 2050"). */
	siteName?: string;
}

const {
	lang,
	current,
	title,
	description,
	alternateHref: alternateHrefProp,
	image,
	type = 'website',
	publishedTime,
	noindex = false,
	theme = 'rotaract',
	siteName = SITE_NAME,
} = Astro.props;
const otherLang: Lang = lang === 'it' ? 'en' : 'it';
const alternateHref = alternateHrefProp ?? getRelativeLocaleUrl(otherLang, pageSlugs[current]);

const { data } = await requestWithMetadata(client.queries.settings({ relativePath: 'settings.md' }), { priority: 'primary' });
const settings = data.settings;
// Staging/preview hosts (e.g. beta.rotaract2050.org) always noindex, regardless of the page's own SEO
// setting, so Google never has a chance to index test content under a different host than the canonical
// URL it points to — and never load Google Analytics on test traffic either (see CookieConsent below).
const onProdHost = isProdHost(Astro.url, Astro.site);
const effectiveNoindex = noindex || !onProdHost;
const resolvedImage = image || settings.defaultOgImage || DEFAULT_OG_IMAGE;
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const localizedAbout = (lang === 'en' && settings.aboutEn) || settings.about;
// Rotaract Distretto 2050 e Interact Distretto 2050 sono due entità distinte sotto lo stesso
// ombrello Rotary International (vedi references/interact-section.md) — mai emettere un solo
// grafo Organization/WebSite "Rotaract" su pagine /interact/*. Interact non ha ancora un proprio
// logo/testo "chi siamo"/codice fiscale confermati in Tina (vedi placeholder wordmark in
// InteractHeader): li si omette piuttosto che riusare per finzione quelli del Rotaract. `sameAs`
// resta condiviso perché Header/Footer Interact già promuovono gli stessi canali social del
// distretto (decisione già presa, non una scorciatoia presa qui).
const organizationGraph =
	theme === 'interact'
		? buildOrganizationGraph(
				{
					name: siteName,
					idSuffix: 'interact-organization',
					url: new URL('/interact', Astro.site).toString(),
					sameAs: SOCIAL_LINKS.map((s) => s.href),
				},
				Astro.site!.toString()
			)
		: buildOrganizationGraph(
				{
					name: siteName,
					about: localizedAbout,
					logo: new URL(settings.logo || DEFAULT_OG_IMAGE, Astro.site).toString(),
					fiscalCode: settings.fiscalCode,
					sameAs: SOCIAL_LINKS.map((s) => s.href),
				},
				Astro.site!.toString()
			);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{settings.gscVerification && <meta name="google-site-verification" content={settings.gscVerification} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!--
			Open Sans ships from Google Fonts as a variable font: every weight in the
			400/500/600/700 request below (for the "latin" subset our Italian/English copy
			needs — à/è/ì/ò/ù already sit inside U+0000-00FF) resolves to this same physical
			file. Preloading it lets the browser fetch it in parallel with HTML parsing
			instead of waiting to discover it via the stylesheet below, which shortens the
			fallback-to-webfont swap window that Lighthouse was attributing most of the
			page's CLS to (the <main> reflow when headings/buttons re-flow into Open Sans).
			If Google rotates this URL on a future font update, this preload just becomes a
			harmless no-op — the stylesheet link still loads the font normally either way.
		-->
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			href="https://fonts.gstatic.com/s/opensans/v44/memvYaGs126MiZpBA-UvWbX2vVnXBbObj2OVTS-muw.woff2"
			crossorigin
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Dancing+Script:wght@600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
		<SeoHead
			lang={lang}
			title={title}
			description={description}
			alternateHref={alternateHref}
			image={resolvedImage}
			type={type}
			publishedTime={publishedTime}
			noindex={effectiveNoindex}
			twitterHandle={settings.twitterHandle}
		/>
		<JsonLd data={organizationGraph} />
	</head>
	<body>
		<div class="page" data-theme={theme === 'interact' ? 'interact' : undefined}>
			{theme === 'interact'
				? <InteractHeader lang={lang} current={current} />
				: <Header lang={lang} current={current} />}
			<main>
				<slot />
			</main>
			{theme === 'interact'
				? <InteractFooter lang={lang} settings={settings} />
				: <Footer lang={lang} settings={settings} />}
			<FormazioneChatWidget lang={lang} chatSettings={settings.chatAssistant} />
		</div>
		<CookieConsent lang={lang} gaMeasurementId={onProdHost ? settings.gaMeasurementId : null} />
	</body>
</html>

<style>
	.page {
		background: var(--color-bg);
		min-height: 100vh;
	}
</style>

<script>
	console.log(
		'%c ROTARACT %c DISTRETTO 2050 %c\n\nConfezionato con cura da Alessandro Gorla & Gabriele Groppo',
		'background:#d41367;color:#fff;font-weight:700;padding:6px 12px;border-radius:6px 0 0 6px;font-family:"Open Sans",sans-serif;font-size:13px;',
		'background:#0b2545;color:#f7a81b;font-weight:700;padding:6px 12px;border-radius:0 6px 6px 0;font-family:"Open Sans",sans-serif;font-size:13px;',
		'color:#54565a;font-style:italic;font-family:"Open Sans",sans-serif;font-size:12px;'
	);

	function initScrollReveal() {
		const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
		if (!els.length) return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;

		els.forEach((el) => el.classList.add('reveal-init'));

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				}
			},
			// threshold: 0.12 + a shrunk root worked for short sections, but a tall one (e.g.
			// CommitteeGrid's stacked commission cards) needs 12% of its own height scrolled
			// into view before it fires — long enough that you'd scroll past still-invisible
			// content first. Fire on the first visible pixel instead, so reveal never lags
			// behind scroll regardless of how tall the target is.
			{ threshold: 0, rootMargin: '0px 0px 0px 0px' }
		);

		els.forEach((el) => observer.observe(el));
	}

	declare global {
		interface Window {
			/** No-ops until CookieConsent's loadGa() defines the real gtag after consent — safe to call anywhere, anytime. */
			trackEvent?: (name: string, params?: Record<string, unknown>) => void;
			gtag?: (...args: unknown[]) => void;
		}
	}

	// Generic GA4 event tracking, opt-in via data attributes so components stay plain HTML —
	// no per-component script needed for a click or a "scrolled this far" signal.
	window.trackEvent = (name, params) => {
		if (typeof window.gtag === 'function') window.gtag('event', name, params ?? {});
	};

	function readTrackParams(el: HTMLElement): Record<string, unknown> {
		if (!el.dataset.trackParams) return {};
		try {
			return JSON.parse(el.dataset.trackParams);
		} catch {
			return {};
		}
	}

	/** Any element with `data-track="event_name"` (+ optional `data-track-params='{"k":"v"}'`) fires a GA4 event on click. */
	function initClickTracking() {
		document.addEventListener('click', (e) => {
			const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
			if (!el?.dataset.track) return;
			window.trackEvent?.(el.dataset.track, readTrackParams(el));
		});
	}

	/** Any element with `data-track-sentinel="event_name"` fires a GA4 event once, the first time it scrolls into view
	 * — used for "read to the end" style signals (e.g. reaching the bottom of a Formazione article). */
	function initScrollTracking() {
		const els = document.querySelectorAll<HTMLElement>('[data-track-sentinel]');
		if (!els.length || !('IntersectionObserver' in window)) return;

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					const el = entry.target as HTMLElement;
					if (el.dataset.trackSentinel) window.trackEvent?.(el.dataset.trackSentinel, readTrackParams(el));
					observer.unobserve(el);
				}
			},
			{ threshold: 0 }
		);

		els.forEach((el) => observer.observe(el));
	}

	initScrollReveal();
	initClickTracking();
	initScrollTracking();
</script>
