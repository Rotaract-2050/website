---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from './PageBanner.astro';
import { uiStrings, type Lang } from '../data/ui-strings';

interface Props {
	lang: Lang;
	error?: 'notFound' | 'teapot';
}

const { lang, error = 'notFound' } = Astro.props;
const t = uiStrings[lang][error];
const homeHref = getRelativeLocaleUrl(lang, '');
const donate = error === 'teapot' ? uiStrings[lang].teapot : null;
---

<BaseLayout lang={lang} current="home" title={t.seoTitle} description={t.body} noindex contentGroup={error === 'notFound' ? '404' : undefined}>
	<PageBanner lang={lang} eyebrow={t.eyebrow} title={t.title} breadcrumbCurrent={t.breadcrumbCurrent} />
	<section class="error-page" data-error={error}>
		<p class="error-page__body">{t.body}</p>
		<div class="error-page__actions">
			{donate && <a class="error-page__cta" href={donate.donateHref} target="_blank" rel="noopener">{donate.donateCta}</a>}
			<a class:list={['error-page__cta', { 'error-page__cta--secondary': donate }]} href={homeHref}>{t.homeCta}</a>
		</div>
	</section>
</BaseLayout>

<script>
	import { whenGaReady } from '../lib/ga-ready';

	// trackEvent is a no-op before consent, so wait for gtag: fires immediately if consent was already
	// stored, or right after the visitor accepts on this page. Never fires for non-consenting visitors.
	if (document.querySelector('.error-page[data-error="notFound"]')) {
		whenGaReady(() => {
			window.trackEvent?.('page_not_found', {
				page_path: location.pathname,
				page_referrer: document.referrer,
			});
		});
	}
</script>

<style>
	.error-page {
		max-width: var(--content-max);
		margin: 0 auto;
		padding: 16px 40px 72px;
	}

	.error-page__body {
		max-width: 60ch;
		margin: 0 0 24px;
		font-family: var(--font-body);
		font-size: 18px;
		line-height: 1.6;
	}

	.error-page__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.error-page__cta {
		display: inline-block;
		padding: 12px 28px;
		border-radius: 999px;
		background: var(--color-pink);
		color: #fff;
		font-family: var(--font-heading);
		font-weight: 700;
		text-transform: uppercase;
		text-decoration: none;
		box-shadow: var(--elevation-1);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.error-page__cta:hover {
		transform: translateY(-4px);
		box-shadow: var(--elevation-2);
	}

	.error-page__cta--secondary {
		background: transparent;
		color: var(--color-pink);
		outline: 2px solid var(--color-pink);
		outline-offset: -2px;
	}

	@media (max-width: 640px) {
		.error-page {
			padding: 8px 20px 56px;
		}
	}
</style>
