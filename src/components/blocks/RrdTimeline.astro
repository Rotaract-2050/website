---
interface Props {
	title: string;
	showDisclaimer?: boolean;
	disclaimerText?: string;
	items: { yearRange: string; name: string; surname: string; motto: string; tinaFieldAttr?: string }[];
}

const { title, showDisclaimer = false, disclaimerText, items } = Astro.props;
---

<section class="rrd-timeline">
	<div class="section-inner">
		<h2 class="section-title">{title}</h2>
		{showDisclaimer && disclaimerText && <p class="disclaimer">{disclaimerText}</p>}
		<ol class="timeline">
			{items.map((item, index) => (
				<li class="timeline-item" style={`animation-delay: ${index * 0.25}s`} data-tina-field={item.tinaFieldAttr}>
					<span class="timeline-dot" aria-hidden="true"></span>
					<div class="timeline-card">
						<span class="timeline-year">A.R. {item.yearRange}</span>
						<span class="timeline-name">{item.name} {item.surname}</span>
						{item.motto && <span class="timeline-motto">“{item.motto}”</span>}
					</div>
				</li>
			))}
		</ol>
	</div>
</section>

<style>
	.rrd-timeline {
		background: #fff;
		padding: 90px 40px;
	}

	.section-inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	.section-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 32px;
		color: var(--color-navy);
		text-transform: uppercase;
		text-align: center;
		margin: 0 0 14px;
	}

	.disclaimer {
		font-size: 13px;
		color: var(--color-muted);
		font-style: italic;
		text-align: center;
		margin: 0 0 40px;
	}

	.timeline {
		list-style: none;
		margin: 50px auto 0;
		padding: 0;
		position: relative;
		max-width: 900px;
	}

	.timeline::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 0;
		bottom: 0;
		width: 6px;
		background: var(--color-border);
		border-radius: 999px;
		transform: translateX(-50%);
	}

	.timeline-item {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 56px 1fr;
		align-items: start;
		padding-bottom: 56px;
		opacity: 0;
		animation: timeline-item-fade-in 0.7s ease-out forwards;
	}

	@keyframes timeline-item-fade-in {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.timeline-item {
			animation: none;
			opacity: 1;
		}
	}

	.timeline-item:last-child {
		padding-bottom: 0;
	}

	.timeline-dot {
		grid-column: 2;
		justify-self: center;
		margin-top: 6px;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: var(--color-pink);
		border: 4px solid #fff;
		box-shadow: 0 0 0 3px var(--color-pink);
		z-index: 1;
	}

	.timeline-item:first-child .timeline-dot {
		background: var(--color-gold);
		box-shadow: 0 0 0 3px var(--color-gold);
	}

	.timeline-card {
		display: flex;
		flex-direction: column;
		gap: 6px;
		background: var(--color-bg);
		border-radius: 16px;
		padding: 22px 26px;
	}

	.timeline-item:nth-child(odd) .timeline-card {
		grid-column: 1;
		text-align: right;
		align-items: flex-end;
		margin-right: 32px;
	}

	.timeline-item:nth-child(even) .timeline-card {
		grid-column: 3;
		text-align: left;
		align-items: flex-start;
		margin-left: 32px;
	}

	.timeline-year {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 15px;
		letter-spacing: 0.5px;
		color: var(--color-pink);
		text-transform: uppercase;
	}

	.timeline-item:first-child .timeline-year {
		color: var(--color-gold);
	}

	.timeline-name {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 24px;
		color: var(--color-navy);
	}

	.timeline-motto {
		font-size: 16px;
		color: var(--color-text);
		font-style: italic;
	}

	@media (max-width: 720px) {
		.rrd-timeline {
			padding-left: 20px;
			padding-right: 20px;
		}

		.timeline::before {
			left: 10px;
		}

		.timeline-item {
			grid-template-columns: 24px 1fr;
			padding-bottom: 36px;
		}

		.timeline-dot {
			grid-column: 1;
			justify-self: start;
			margin-top: 4px;
			width: 16px;
			height: 16px;
			border-width: 3px;
			box-shadow: 0 0 0 2px var(--color-pink);
		}

		.timeline-item:first-child .timeline-dot {
			box-shadow: 0 0 0 2px var(--color-gold);
		}

		.timeline-item:nth-child(odd) .timeline-card,
		.timeline-item:nth-child(even) .timeline-card {
			grid-column: 2;
			text-align: left;
			align-items: flex-start;
			margin-left: 20px;
			margin-right: 0;
		}
	}
</style>
