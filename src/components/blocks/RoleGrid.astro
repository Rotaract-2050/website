---
import { Image } from 'astro:assets';
import PersonCard from '../PersonCard.astro';

interface Props {
	title: string;
	showDisclaimer?: boolean;
	disclaimerText?: string;
	highlightFirst?: boolean;
	items: {
		initials?: string;
		photo?: string;
		name: string;
		role: string;
		email?: string;
		themeMotto?: string;
		themeLogo?: string;
		tinaFieldAttr?: string;
	}[];
}

const { title, showDisclaimer = false, disclaimerText, highlightFirst = false, items } = Astro.props;
const [featured, ...rest] = items;
const hasTheme = Boolean(featured?.themeMotto || featured?.themeLogo);
---

<section class="governance">
	<div class="section-inner">
		<h2 class="section-title center tight">{title}</h2>
		{showDisclaimer && disclaimerText && <p class="disclaimer">{disclaimerText}</p>}
		{highlightFirst && featured && (
			<div class="featured-row" data-themed={hasTheme}>
				{hasTheme && featured.themeMotto && <p class="theme-motto">“{featured.themeMotto}”</p>}
				<PersonCard
					name={featured.name}
					role={featured.role}
					photo={featured.photo}
					initials={featured.initials}
					email={featured.email}
					tinaFieldAttr={featured.tinaFieldAttr}
					size="lg"
				/>
				{hasTheme && featured.themeLogo && (
					<Image src={featured.themeLogo} alt={`Logo del tema distrettuale — ${featured.themeMotto ?? title}`} width={160} height={226} class="theme-logo" />
				)}
			</div>
		)}
		<div class="roles-grid">
			{(highlightFirst ? rest : items).map((role) => (
				<PersonCard
					name={role.name}
					role={role.role}
					photo={role.photo}
					initials={role.initials}
					email={role.email}
					tinaFieldAttr={role.tinaFieldAttr}
				/>
			))}
		</div>
	</div>
</section>

<style>
	.governance {
		background: #fff;
		padding: 80px 40px;
	}

	.section-inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	.section-title {
		font-family: var(--font-script);
		font-weight: 700;
		font-size: 48px;
		color: var(--color-pink);
		text-transform: none;
		margin: 0 0 34px;
	}

	.section-title.center {
		text-align: center;
	}

	.section-title.tight {
		margin-bottom: 14px;
	}

	.disclaimer {
		font-size: 12px;
		color: var(--color-muted);
		font-style: italic;
		text-align: center;
		margin: 0 0 34px;
	}

	.featured-row {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 32px;
		margin-bottom: 34px;
	}

	.featured-row :global(.person-card) {
		max-width: 280px;
		flex-shrink: 0;
	}

	.featured-row[data-themed='true'] {
		padding: 36px;
		border-radius: 22px;
		background:
			repeating-linear-gradient(
				135deg,
				rgba(247, 168, 27, 0.16) 0px,
				rgba(247, 168, 27, 0.16) 14px,
				rgba(23, 69, 143, 0.1) 14px,
				rgba(23, 69, 143, 0.1) 28px
			),
			var(--color-bg);
	}

	.theme-motto {
		flex: 1 1 200px;
		max-width: 260px;
		font-family: var(--font-script);
		font-weight: 700;
		font-size: 30px;
		line-height: 1.25;
		color: var(--color-navy);
		text-align: right;
		margin: 0;
	}

	.theme-logo {
		flex: 0 0 auto;
		width: 130px;
		height: auto;
	}

	@media (max-width: 720px) {
		.featured-row[data-themed='true'] {
			flex-direction: column;
			padding: 28px 20px;
		}

		.theme-motto {
			text-align: center;
			max-width: 320px;
		}
	}

	.roles-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 24px;
	}

	.role-card {
		background: var(--color-bg);
		border-radius: 14px;
		padding: 26px 18px;
		text-align: center;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.role-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 24px rgba(11, 37, 69, 0.12);
	}

	.role-initials {
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background: var(--color-navy);
		color: #fff;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 18px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 14px;
	}

	.role-name {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 15px;
		color: var(--color-navy);
		margin-bottom: 4px;
	}

	.role-title {
		font-size: 12px;
		color: var(--color-text);
	}

	@media (max-width: 900px) {
		.roles-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 720px) {
		.governance {
			padding-left: 20px;
			padding-right: 20px;
		}
	}
</style>
