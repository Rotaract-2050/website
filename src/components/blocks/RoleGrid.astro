---
import { Image } from 'astro:assets';
import PersonCard from '../PersonCard.astro';

interface Props {
	title: string;
	showDisclaimer?: boolean;
	disclaimerText?: string;
	highlightFirst?: boolean;
	items: {
		initials?: string;
		photo?: string;
		photoFocalX?: number | null;
		photoFocalY?: number | null;
		photoZoom?: number | null;
		name: string;
		role: string;
		email?: string;
		club?: { name: string; zoneColor?: string | null } | null;
		clubCustom?: string;
		themeMotto?: string;
		themeLogo?: string;
		tinaFieldAttr?: string;
	}[];
}

const { title, showDisclaimer = false, disclaimerText, highlightFirst = false, items } = Astro.props;
const [featured, ...rest] = items;
const hasTheme = Boolean(featured?.themeMotto || featured?.themeLogo);
---

<section class="governance">
	<div class="section-inner">
		<h2 class="section-title center tight">{title}</h2>
		{showDisclaimer && disclaimerText && <p class="disclaimer">{disclaimerText}</p>}
		{highlightFirst && featured && (
			<div class="featured-row" data-themed={hasTheme}>
				{hasTheme && featured.themeLogo && (
					<Image src={featured.themeLogo} alt={`Logo del tema distrettuale — ${featured.themeMotto ?? title}`} width={520} height={520} quality="high" class="theme-logo" />
				)}
				<PersonCard
					name={featured.name}
					role={featured.role}
					photo={featured.photo}
					photoFocalX={featured.photoFocalX}
					photoFocalY={featured.photoFocalY}
					photoZoom={featured.photoZoom}
					initials={featured.initials}
					email={featured.email}
					club={featured.club}
					clubCustom={featured.clubCustom}
					tinaFieldAttr={featured.tinaFieldAttr}
					size="lg"
				/>
				{hasTheme && featured.themeMotto && <p class="theme-motto">{featured.themeMotto}</p>}
			</div>
		)}
		<div class="roles-grid">
			{(highlightFirst ? rest : items).map((role) => (
				<PersonCard
					name={role.name}
					role={role.role}
					photo={role.photo}
					photoFocalX={role.photoFocalX}
					photoFocalY={role.photoFocalY}
					photoZoom={role.photoZoom}
					initials={role.initials}
					email={role.email}
					club={role.club}
					clubCustom={role.clubCustom}
					tinaFieldAttr={role.tinaFieldAttr}
				/>
			))}
		</div>
	</div>
</section>

<style>
	.governance {
		background: #fff;
		padding: 80px 40px;
	}

	.section-inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	.section-title {
		font-family: var(--font-script);
		font-weight: 700;
		font-size: 48px;
		color: var(--color-pink);
		text-transform: none;
		margin: 0 0 34px;
	}

	.section-title.center {
		text-align: center;
	}

	.section-title.tight {
		margin-bottom: 14px;
	}

	.disclaimer {
		font-size: 12px;
		color: var(--color-muted);
		font-style: italic;
		text-align: center;
		margin: 0 0 34px;
	}

	.featured-row {
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 34px;
	}

	.featured-row :global(.person-card) {
		max-width: 280px;
		flex-shrink: 0;
		justify-self: center;
	}

	/* Three equal columns, each element centered within its own — not just pushed
	   toward the middle — so motto/logo have real room to grow independently of the card. */
	.featured-row[data-themed='true'] {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		align-items: center;
		gap: 32px;
		width: 100%;
		padding: 36px;
		border-radius: var(--shape-large);
		background-color: var(--color-bg);
		background-image:
			linear-gradient(rgba(250, 250, 251, 0.6), rgba(250, 250, 251, 0.6)),
			url('/uploads/Squadra/2026-2027/sfondo.png');
		background-repeat: no-repeat, no-repeat;
		background-size: 100% 100%, cover;
		background-position: center, center;
	}

	.theme-motto {
		justify-self: center;
		max-width: 380px;
		font-family: var(--font-script);
		font-weight: 700;
		font-size: 66px;
		line-height: 1.2;
		color: var(--color-navy);
		text-align: center;
		margin: 0;
	}

	.theme-logo {
		justify-self: center;
		width: 460px;
		height: auto;
	}

	@media (max-width: 720px) {
		.featured-row[data-themed='true'] {
			grid-template-columns: 1fr;
			justify-items: center;
			padding: 28px 20px;
		}

		.theme-motto,
		.theme-logo {
			justify-self: center;
			text-align: center;
			max-width: 320px;
		}
	}

	.roles-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 24px;
	}

	.role-card {
		background: var(--color-bg);
		border-radius: var(--shape-medium);
		padding: 26px 18px;
		text-align: center;
		transition: transform var(--motion-duration-medium) var(--motion-easing-emphasized), box-shadow var(--motion-duration-medium) var(--motion-easing-emphasized);
	}

	.role-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--elevation-2);
	}

	.role-initials {
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background: var(--color-navy);
		color: #fff;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 18px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 14px;
	}

	.role-name {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 15px;
		color: var(--color-navy);
		margin-bottom: 4px;
	}

	.role-title {
		font-size: 12px;
		color: var(--color-text);
	}

	@media (max-width: 900px) {
		.roles-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 720px) {
		.governance {
			padding-left: 20px;
			padding-right: 20px;
		}
	}
</style>
