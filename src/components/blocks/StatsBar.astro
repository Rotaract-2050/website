---
interface Props {
	items: { value: string; label: string; tinaFieldAttr?: string }[];
}

const { items } = Astro.props;
---

<section class="stats">
	<div class="stats-card">
		{items.map((stat) => (
			<div class="stat" data-tina-field={stat.tinaFieldAttr}>
				<div class="stat-value">{stat.value}</div>
				<div class="stat-label">{stat.label}</div>
			</div>
		))}
	</div>
</section>

<style>
	/* One unified card instead of separate tonal tiles — a single "proof" surface with
	   thin dividers between stats, each number colored (cycling the Rotary palette)
	   rather than each stat getting its own colored background. */
	.stats {
		background: var(--color-bg);
		padding: 0 40px 96px;
	}

	.stats-card {
		max-width: var(--content-max);
		margin: 0 auto;
		background: #f6f8fa;
		border-radius: var(--shape-extra-large);
		padding: 32px;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 20px;
	}

	.stat {
		--tone: var(--color-pink);
		position: relative;
		text-align: center;
		padding: 44px 20px;
		background: #ffffff;
		border-radius: var(--shape-large);
		box-shadow: var(--elevation-1);
		transition: transform var(--motion-duration-medium) var(--motion-easing-emphasized), box-shadow var(--motion-duration-medium) var(--motion-easing-emphasized);
	}

	.stat:hover {
		transform: translateY(-4px);
		box-shadow: var(--elevation-2);
	}

	.stat:nth-child(4n + 2) {
		--tone: var(--color-gold);
	}

	.stat:nth-child(4n + 3) {
		--tone: var(--color-royal-blue);
	}

	.stat:nth-child(4n + 4) {
		--tone: var(--color-azure);
	}

	.stat-value {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 52px;
		color: var(--tone);
		line-height: 1;
	}

	.stat-label {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 1px;
		color: var(--color-text);
		text-transform: uppercase;
		margin-top: 8px;
	}

	@media (max-width: 768px) {
		.stats-card {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 480px) {
		.stats-card {
			grid-template-columns: 1fr;
		}
		.stat {
			padding: 28px 16px;
		}
	}
</style>

<script>
	import { revealOnScroll, cappedStagger } from '../../lib/motion';

	function initStatsReveal(section: Element) {
		const stats = Array.from(section.querySelectorAll<HTMLElement>('.stat'));
		revealOnScroll(section, stats, { opacity: [0, 1], scale: [0.92, 1] }, { delay: cappedStagger(0.07) });
	}

	function initStatsCountUp(section: Element) {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;

		const values = Array.from(section.querySelectorAll<HTMLElement>('.stat-value'));

		function animate(el: HTMLElement) {
			const match = (el.textContent ?? '').match(/^(\d+)(.*)$/);
			if (!match) return;
			const target = parseInt(match[1], 10);
			const suffix = match[2];
			const duration = 1200;
			const start = performance.now();

			function tick(now: number) {
				const progress = Math.min((now - start) / duration, 1);
				const eased = 1 - Math.pow(1 - progress, 3);
				el.textContent = `${Math.round(target * eased)}${suffix}`;
				if (progress < 1) requestAnimationFrame(tick);
			}

			requestAnimationFrame(tick);
		}

		const observer = new IntersectionObserver(
			(entries, obs) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						values.forEach(animate);
						obs.disconnect();
					}
				}
			},
			{ threshold: 0.3 }
		);

		observer.observe(section);
	}

	document.querySelectorAll<HTMLElement>('.stats').forEach((section) => {
		initStatsCountUp(section);
		initStatsReveal(section);
	});
</script>
