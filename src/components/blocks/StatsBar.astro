---
interface Props {
	items: { value: string; label: string; tinaFieldAttr?: string }[];
}

const { items } = Astro.props;
---

<section class="stats">
	{items.map((stat) => (
		<div class="stat" data-tina-field={stat.tinaFieldAttr}>
			<div class="stat-value">{stat.value}</div>
			<div class="stat-label">{stat.label}</div>
		</div>
	))}
</section>

<style>
	.stats {
		background: var(--color-pink-dark);
		padding: 40px;
		display: flex;
		justify-content: center;
		gap: 70px;
		flex-wrap: wrap;
	}

	.stat {
		text-align: center;
	}

	.stat-value {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 42px;
		color: var(--color-gold);
		line-height: 1;
	}

	.stat-label {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 1px;
		color: rgba(255, 255, 255, 0.75);
		text-transform: uppercase;
		margin-top: 6px;
	}
</style>

<script>
	function initStatsCountUp(section: Element) {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;

		const values = Array.from(section.querySelectorAll<HTMLElement>('.stat-value'));

		function animate(el: HTMLElement) {
			const match = (el.textContent ?? '').match(/^(\d+)(.*)$/);
			if (!match) return;
			const target = parseInt(match[1], 10);
			const suffix = match[2];
			const duration = 1200;
			const start = performance.now();

			function tick(now: number) {
				const progress = Math.min((now - start) / duration, 1);
				const eased = 1 - Math.pow(1 - progress, 3);
				el.textContent = `${Math.round(target * eased)}${suffix}`;
				if (progress < 1) requestAnimationFrame(tick);
			}

			requestAnimationFrame(tick);
		}

		const observer = new IntersectionObserver(
			(entries, obs) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						values.forEach(animate);
						obs.disconnect();
					}
				}
			},
			{ threshold: 0.3 }
		);

		observer.observe(section);
	}

	document.querySelectorAll('.stats').forEach(initStatsCountUp);
</script>
