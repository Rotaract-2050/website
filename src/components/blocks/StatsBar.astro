---
interface Props {
	items: { value: string; label: string; tinaFieldAttr?: string }[];
}

const { items } = Astro.props;
---

<section class="stats">
	<div class="stats-card">
		{items.map((stat) => (
			<div class="stat" data-tina-field={stat.tinaFieldAttr}>
				<div class="stat-value">{stat.value}</div>
				<div class="stat-label">{stat.label}</div>
			</div>
		))}
	</div>
</section>

<style>
	/* One unified card instead of separate tonal tiles — a single "proof" surface with
	   thin dividers between stats, each number colored (cycling the Rotary palette)
	   rather than each stat getting its own colored background. */
	.stats {
		background: var(--color-bg);
		padding: 24px 40px 96px;
	}

	.stats-card {
		max-width: var(--content-max);
		margin: 0 auto;
		background: #fff;
		border-radius: var(--shape-extra-large);
		box-shadow: var(--elevation-4);
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
	}

	.stat {
		--tone: var(--color-pink);
		position: relative;
		flex: 1 1 180px;
		text-align: center;
		padding: 44px 32px;
	}

	.stat:not(:last-child)::after {
		content: '';
		position: absolute;
		top: 22%;
		bottom: 22%;
		right: 0;
		width: 1px;
		background: var(--color-border);
	}

	.stat:nth-child(4n + 2) {
		--tone: var(--color-gold);
	}

	.stat:nth-child(4n + 3) {
		--tone: var(--color-royal-blue);
	}

	.stat:nth-child(4n + 4) {
		--tone: var(--color-navy);
	}

	.stat-value {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 52px;
		color: var(--tone);
		line-height: 1;
	}

	.stat-label {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 1px;
		color: var(--color-text);
		text-transform: uppercase;
		margin-top: 8px;
	}

	@media (max-width: 640px) {
		.stat {
			flex: 1 1 45%;
			padding: 28px 16px;
		}

		.stat:nth-child(2n)::after {
			display: none;
		}
	}
</style>

<script>
	function initStatsCountUp(section: Element) {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;

		const values = Array.from(section.querySelectorAll<HTMLElement>('.stat-value'));

		function animate(el: HTMLElement) {
			const match = (el.textContent ?? '').match(/^(\d+)(.*)$/);
			if (!match) return;
			const target = parseInt(match[1], 10);
			const suffix = match[2];
			const duration = 1200;
			const start = performance.now();

			function tick(now: number) {
				const progress = Math.min((now - start) / duration, 1);
				const eased = 1 - Math.pow(1 - progress, 3);
				el.textContent = `${Math.round(target * eased)}${suffix}`;
				if (progress < 1) requestAnimationFrame(tick);
			}

			requestAnimationFrame(tick);
		}

		const observer = new IntersectionObserver(
			(entries, obs) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						values.forEach(animate);
						obs.disconnect();
					}
				}
			},
			{ threshold: 0.3 }
		);

		observer.observe(section);
	}

	document.querySelectorAll('.stats').forEach(initStatsCountUp);
</script>
