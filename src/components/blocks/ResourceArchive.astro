---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { tinaField } from '@tinacms/astro';
import ResourceCard from '../ResourceCard.astro';
import { getKnowledgeResources, localizeResource, resourceSlug, tagSlug, tagColor, resourceTags, localizeTag, buildWikilinkResolver, isRoleTag } from '../../lib/resources';
import { extractResourcePlainText } from '../../lib/resource-markdown';
import { buildItemListJsonLd } from '../../lib/jsonld';
import JsonLd from '../JsonLd.astro';
import { uiStrings, type Lang } from '../../data/ui-strings';

interface Props {
	lang: Lang;
	emptyMessage?: string;
}

const { lang, emptyMessage } = Astro.props;
const t = uiStrings[lang];

const resources = await getKnowledgeResources();
const tags = resourceTags(resources);
const roleTags = tags.filter(isRoleTag);
const categoryTags = tags.filter((tag) => !isRoleTag(tag));
const resolveWikilink = buildWikilinkResolver(resources, lang);
// Tells search engines this page is a hub linking to N articles, not just prose — see
// buildItemListJsonLd in lib/jsonld.ts. Absolute URLs (schema.org's own examples use them
// for ItemList) since Astro.site is always configured (see astro.config.mjs).
const itemListJsonLd = buildItemListJsonLd(
	resources.map((resource) => ({
		name: localizeResource(resource, lang).title,
		url: new URL(getRelativeLocaleUrl(lang, `formazione/${resourceSlug(resource)}`), Astro.site).toString(),
	})),
);
---

<section class="archive">
	{resources.length > 0 && <JsonLd data={itemListJsonLd} />}
	<div class="archive-inner">
		{resources.length > 0 ? (
			<>
				<div class="archive-toolbar">
					<label class="archive-search">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="11" cy="11" r="7"></circle>
							<path d="m21 21-4.3-4.3"></path>
						</svg>
						<span class="sr-only">{t.resources.searchPlaceholder}</span>
						<input type="search" placeholder={t.resources.searchPlaceholder} data-resource-search />
					</label>
					<div class="archive-filter-rows">
						<div class="archive-filters" role="group" aria-label={t.resources.filterAll}>
							<button type="button" class="filter-pill active" data-filter="all" aria-pressed="true">{t.resources.filterAll}</button>
							{roleTags.length > 0 && <span class="filter-divider" aria-hidden="true"></span>}
							{roleTags.map((tag) => (
								<button type="button" class="filter-pill" data-filter={tagSlug(tag)} style={`--pill-color: ${tagColor(tag)};`} aria-pressed="false">{localizeTag(tag, lang)}</button>
							))}
						</div>
						{categoryTags.length > 0 && (
							<div class="archive-filters" role="group" aria-label={t.resources.filterAll}>
								{categoryTags.map((tag) => (
									<button type="button" class="filter-pill" data-filter={tagSlug(tag)} style={`--pill-color: ${tagColor(tag)};`} aria-pressed="false">{localizeTag(tag, lang)}</button>
								))}
							</div>
						)}
					</div>
				</div>
				<div class="resource-grid" data-resource-grid>
					{resources.map((resource) => {
						const localized = localizeResource(resource, lang);
						return (
							<ResourceCard
								href={getRelativeLocaleUrl(lang, `formazione/${resourceSlug(resource)}`)}
								tags={localized.tags}
								tagKeys={(resource.tags ?? []).filter((tag): tag is string => Boolean(tag))}
								title={localized.title}
								excerpt={localized.excerpt}
								bodyText={extractResourcePlainText(localized.body, resolveWikilink)}
								readMoreLabel={t.resources.readMore}
								tinaFieldAttr={tinaField(resource)}
							/>
						);
					})}
				</div>
				<p class="resource-empty" data-resource-no-results hidden>{t.resources.noResults}</p>
			</>
		) : (
			<p class="resource-empty">{emptyMessage || t.resources.empty}</p>
		)}
	</div>
</section>

<style>
	.archive {
		padding: 70px 40px 90px;
	}

	.archive-inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	.resource-empty {
		font-size: 14px;
		color: var(--color-muted);
		font-style: italic;
	}

	.archive-toolbar {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
		margin-bottom: 36px;
	}

	.archive-filter-rows {
		display: flex;
		flex-direction: column;
		gap: 10px;
		width: 100%;
	}

	.archive-search {
		display: flex;
		align-items: center;
		gap: 10px;
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: var(--shape-full);
		padding: 10px 18px;
		color: var(--color-muted);
		width: 100%;
		max-width: 320px;
	}

	.archive-search input {
		border: none;
		outline: none;
		font-size: 14px;
		color: var(--color-text);
		flex: 1;
		background: transparent;
		font-family: inherit;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.archive-filters {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
	}

	.filter-pill {
		font-family: inherit;
		font-size: 13px;
		font-weight: 600;
		color: var(--color-navy);
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: var(--shape-full);
		padding: 8px 18px;
		cursor: pointer;
		transition: background var(--motion-duration-short) var(--motion-easing-standard), color var(--motion-duration-short) var(--motion-easing-standard), border-color var(--motion-duration-short) var(--motion-easing-standard);
	}

	.filter-pill:hover {
		border-color: var(--pill-color, var(--color-pink));
	}

	.filter-pill.active {
		background: var(--pill-color, var(--color-pink));
		border-color: var(--pill-color, var(--color-pink));
		color: #fff;
	}

	.filter-divider {
		width: 1px;
		align-self: stretch;
		background: var(--color-border);
		margin: 4px 2px;
	}

	.resource-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	@media (max-width: 900px) {
		.resource-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.archive {
			padding: 50px 20px 70px;
		}

		.archive-search {
			max-width: 100%;
		}
	}
</style>

<script>
	import { revealOnScroll, cappedStagger } from '../../lib/motion';

	document.querySelectorAll<HTMLElement>('.archive').forEach((section) => {
		const cards = Array.from(section.querySelectorAll<HTMLElement>('.resource-card'));
		revealOnScroll(section, cards, { opacity: [0, 1], scale: [0.92, 1] }, { delay: cappedStagger(0.08) });

		const searchInput = section.querySelector<HTMLInputElement>('[data-resource-search]');
		const filterPills = Array.from(section.querySelectorAll<HTMLButtonElement>('.filter-pill'));
		const noResults = section.querySelector<HTMLElement>('[data-resource-no-results]');
		if (!searchInput && filterPills.length === 0) return;

		let activeFilter = 'all';

		const applyFilters = () => {
			const query = (searchInput?.value ?? '').trim().toLowerCase();
			let visibleCount = 0;
			for (const card of cards) {
				const cardTags = (card.dataset.tags ?? '').split(' ').filter(Boolean);
				const matchesFilter = activeFilter === 'all' || cardTags.includes(activeFilter);
				const haystack = `${card.textContent ?? ''} ${card.dataset.search ?? ''}`.toLowerCase();
				const matchesQuery = query === '' || haystack.includes(query);
				const visible = matchesFilter && matchesQuery;
				card.hidden = !visible;
				if (visible) visibleCount += 1;
			}
			if (noResults) noResults.hidden = visibleCount > 0;
		};

		searchInput?.addEventListener('input', applyFilters);

		for (const pill of filterPills) {
			pill.addEventListener('click', () => {
				activeFilter = pill.dataset.filter ?? 'all';
				for (const other of filterPills) {
					const isActive = other === pill;
					other.classList.toggle('active', isActive);
					other.setAttribute('aria-pressed', String(isActive));
				}
				applyFilters();
			});
		}
	});
</script>
