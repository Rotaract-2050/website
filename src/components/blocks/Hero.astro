---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image } from 'astro:assets';
import ImageSlot from '../ImageSlot.astro';
import type { Lang } from '../../data/ui-strings';

interface Slide {
	eyebrow: string;
	title: string;
	subtitle: string;
	ctaLabel: string;
	image?: string;
	imageFocalX?: number | null;
	imageFocalY?: number | null;
	tinaFieldAttr?: string;
}

interface Props {
	lang: Lang;
	ctaHref: string;
	slides: Slide[];
	autoplay?: boolean;
}

const { lang, ctaHref, slides, autoplay = true } = Astro.props;
const resolvedCtaHref = getRelativeLocaleUrl(lang, ctaHref);
---

<section class="hero">
	<div class="hero-card" data-hero data-autoplay={autoplay ? 'true' : 'false'}>
		<div class="hero-slides">
			{slides.map((slide, i) => (
				<div class="hero-slide" data-slide data-index={i} data-active={i === 0 ? 'true' : 'false'} data-tina-field={slide.tinaFieldAttr}>
					{slide.image ? (
						<Image
							src={slide.image}
							alt={slide.title}
							width={1600}
							height={900}
							quality="high"
							class="hero-image"
							style={`--focal-x:${slide.imageFocalX ?? 50}%;--focal-y:${slide.imageFocalY ?? 50}%;`}
							loading={i === 0 ? 'eager' : 'lazy'}
							fetchpriority={i === 0 ? 'high' : 'auto'}
						/>
					) : (
						<ImageSlot label="Foto banner distrettuale" class="hero-image" />
					)}
					<div class="hero-overlay" aria-hidden="true"></div>
					<div class="hero-copy" data-hero-copy data-anim-hide>
						<span class="hero-eyebrow">{slide.eyebrow}</span>
						<h1 class="hero-title">{slide.title}</h1>
						<p class="hero-subtitle">{slide.subtitle}</p>
						<a class="hero-cta" href={resolvedCtaHref}>{slide.ctaLabel}</a>
					</div>
					<noscript><style>.hero-copy[data-anim-hide] { opacity: 1; }</style></noscript>
				</div>
			))}
		</div>

		<button type="button" class="hero-arrow hero-prev" data-prev aria-label="Previous slide">‹</button>
		<button type="button" class="hero-arrow hero-next" data-next aria-label="Next slide">›</button>

		<div class="hero-dots" data-dots>
			{slides.map((_, i) => (
				<button type="button" class="hero-dot" data-dot data-index={i} data-active={i === 0 ? 'true' : 'false'} aria-label={`Slide ${i + 1}`}></button>
			))}
		</div>

		<span class="mark" aria-hidden="true">2050</span>
	</div>
</section>

<style>
	/* The hero is a big rounded M3 "expressive" card, inset from the page edges like the
	   rest of the site's content — not a full-bleed band — with the photo filling it. */
	.hero {
		padding: 32px 40px 40px;
		background: var(--color-bg);
	}

	/* No max-width here on purpose: the hero card fills the .hero band edge-to-edge
	   (minus its padding), big on both axes — everything else on the page stays
	   capped at --content-max, the hero is the one deliberate exception. */
	.hero-card {
		position: relative;
		min-height: 82vh;
		border-radius: var(--shape-extra-large);
		overflow: hidden;
		box-shadow: var(--elevation-4);
	}

	.hero-slides {
		position: absolute;
		inset: 0;
	}

	.hero-slide {
		position: absolute;
		inset: 0;
		opacity: 0;
		z-index: 1;
		transition: opacity 0.6s ease;
	}

	.hero-slide[data-active='true'] {
		opacity: 1;
		z-index: 2;
	}

	.hero-slide :global(.hero-image) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--focal-x, 50%) var(--focal-y, 50%);
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			100deg,
			color-mix(in srgb, var(--color-pink-dark) 92%, transparent) 10%,
			color-mix(in srgb, var(--color-pink-dark) 55%, transparent) 55%,
			color-mix(in srgb, var(--color-pink-dark) 25%, transparent) 100%
		);
		pointer-events: none;
	}

	/* Signature mark: the district's own number, echoed faintly on the hero and every
	   inner page's PageBanner/CtaBanner — a quiet recurring identity cue, not a one-off. */
	.mark {
		position: absolute;
		right: -0.05em;
		bottom: -0.28em;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: clamp(8rem, 24vw, 18rem);
		line-height: 1;
		color: rgba(255, 255, 255, 0.22);
		pointer-events: none;
		user-select: none;
		z-index: 3;
	}

	.hero-copy {
		position: absolute;
		left: 0;
		bottom: 0;
		padding: 60px;
		max-width: 640px;
	}

	.hero-eyebrow {
		display: inline-block;
		background: var(--color-pink);
		color: #fff;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		padding: 5px 14px;
		border-radius: var(--shape-full);
		margin-bottom: 18px;
	}

	.hero-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 48px;
		line-height: 1.08;
		color: #fff;
		text-transform: uppercase;
		margin: 0 0 16px;
	}

	.hero-subtitle {
		font-size: 17px;
		color: #e4e7ee;
		line-height: 1.5;
		margin: 0 0 26px;
		max-width: 520px;
	}

	.hero-cta {
		display: inline-block;
		background: #fff;
		color: var(--color-navy);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 14px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		padding: 14px 28px;
		border-radius: var(--shape-full);
	}

	.hero-cta:hover {
		background: var(--color-bg);
		color: var(--color-navy);
	}

	.hero-arrow {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 0;
		background: rgba(255, 255, 255, 0.15);
		color: #fff;
		font-size: 22px;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		z-index: 10;
	}

	.hero-arrow:hover {
		background: rgba(255, 255, 255, 0.28);
	}

	.hero-prev {
		left: 20px;
	}

	.hero-next {
		right: 20px;
	}

	.hero-dots {
		position: absolute;
		bottom: 22px;
		left: 0;
		right: 0;
		display: flex;
		justify-content: center;
		gap: 8px;
		z-index: 10;
	}

	.hero-dot {
		width: 9px;
		height: 9px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.5);
		cursor: pointer;
	}

	.hero-dot[data-active='true'] {
		background: var(--color-pink);
	}

	@media (max-width: 720px) {
		.hero {
			padding: 16px 16px 24px;
		}

		.hero-card {
			min-height: 640px;
			border-radius: var(--shape-large);
		}

		.hero-copy {
			padding: 32px;
		}

		.hero-title {
			font-size: 34px;
		}
	}
</style>

<script>
	import { revealOnLoad } from '../../lib/motion';

	function initHero(hero: Element) {
		const slides = Array.from(hero.querySelectorAll<HTMLElement>('[data-slide]'));
		const dots = Array.from(hero.querySelectorAll<HTMLElement>('[data-dot]'));
		const prevBtn = hero.querySelector<HTMLButtonElement>('[data-prev]');
		const nextBtn = hero.querySelector<HTMLButtonElement>('[data-next]');
		let index = 0;
		let timer: ReturnType<typeof setInterval> | undefined;

		function show(next: number) {
			index = (next + slides.length) % slides.length;
			slides.forEach((slide, i) => slide.setAttribute('data-active', String(i === index)));
			dots.forEach((dot, i) => dot.setAttribute('data-active', String(i === index)));
		}

		prevBtn?.addEventListener('click', () => show(index - 1));
		nextBtn?.addEventListener('click', () => show(index + 1));
		dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));

		if (hero.getAttribute('data-autoplay') === 'true' && slides.length > 1) {
			timer = setInterval(() => show(index + 1), 6000);
			hero.addEventListener('mouseenter', () => timer && clearInterval(timer));
			hero.addEventListener('mouseleave', () => {
				timer = setInterval(() => show(index + 1), 6000);
			});
		}
	}

	document.querySelectorAll('[data-hero]').forEach(initHero);

	document.querySelectorAll<HTMLElement>('[data-hero-copy]').forEach((copy) => {
		revealOnLoad(copy, { opacity: [0, 1], y: [24, 0] });
	});
</script>
