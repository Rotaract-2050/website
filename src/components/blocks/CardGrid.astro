---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../../data/ui-strings';

interface Props {
	lang: Lang;
	title: string;
	items: { title: string; meta: string; href: string; color?: string; tinaFieldAttr?: string }[];
}

const { lang, title, items } = Astro.props;
---

<section class="card-grid">
	<div class="section-inner">
		<h2 class="section-title center">{title}</h2>
		<div class="card-row">
			{items.map((item) => (
				<a
					href={getRelativeLocaleUrl(lang, item.href)}
					class="card"
					data-tina-field={item.tinaFieldAttr}
					style={item.color ? `--tint:${item.color};` : undefined}
				>
					<div class="card-title">{item.title}</div>
					<div class="card-meta">{item.meta}</div>
				</a>
			))}
		</div>
	</div>
</section>

<style>
	.card-grid {
		background: var(--color-bg);
		padding: 96px 40px;
	}

	.section-inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	.section-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 34px;
		color: var(--color-navy);
		text-transform: uppercase;
		margin: 0 0 34px;
	}

	.section-title.center {
		text-align: center;
		font-size: 32px;
	}

	.card-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 24px;
		padding-top: 10px;
	}

	/* Big M3 tonal container per card, tinted by the item's own color (--tint) instead of
	   a small colored label pill on a white card — the color IS the surface now. */
	.card {
		--tint: var(--color-navy);
		flex: 0 0 auto;
		width: 240px;
		background: color-mix(in srgb, var(--tint) 14%, white);
		border-radius: var(--shape-extra-large);
		box-shadow: var(--elevation-1);
		padding: 40px 28px;
		text-align: center;
		color: inherit;
		transition: transform var(--motion-duration-medium) var(--motion-easing-emphasized), box-shadow var(--motion-duration-medium) var(--motion-easing-emphasized);
	}

	.card:hover {
		transform: translateY(-6px) scale(1.02);
		box-shadow: var(--elevation-3);
	}

	.card-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 26px;
		color: color-mix(in srgb, var(--tint) 80%, black 25%);
		text-transform: uppercase;
		margin: 0 0 8px;
	}

	.card-meta {
		font-size: 14px;
		font-weight: 600;
		letter-spacing: 0.3px;
		color: color-mix(in srgb, var(--tint) 80%, black 25%);
		opacity: 0.75;
	}

	@media (max-width: 720px) {
		.card-grid {
			padding-left: 20px;
			padding-right: 20px;
		}

		.card {
			width: 100%;
			max-width: 280px;
		}
	}
</style>

<script>
	import { revealOnScroll, cappedStagger } from '../../lib/motion';

	document.querySelectorAll<HTMLElement>('.card-grid').forEach((section) => {
		const cards = Array.from(section.querySelectorAll<HTMLElement>('.card'));
		revealOnScroll(section, cards, { opacity: [0, 1], scale: [0.92, 1] }, { delay: cappedStagger(0.08) });
	});
</script>
