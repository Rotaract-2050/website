---
import { tinaField } from '@tinacms/astro';
import EventCard from '../EventCard.astro';
import {
	getArchiveEvents,
	groupEventsByYear,
	eventSlug,
	eventTags,
	isUpcomingEvent,
	currentRotaryYearLabel,
	localizeEvent,
	yearLabelSlug,
} from '../../lib/events';
import { uiStrings, type Lang } from '../../data/ui-strings';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
	lang: Lang;
	emptyMessage?: string;
}

const { lang, emptyMessage } = Astro.props;
const t = uiStrings[lang];

const events = await getArchiveEvents();
const yearGroups = groupEventsByYear(events);
const dateFormatter = new Intl.DateTimeFormat(lang === 'it' ? 'it-IT' : 'en-GB', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});

// Server-rendered default: whichever `?anno=` names (if it matches a real group), else today's
// Rotary year, else the newest group with any events (e.g. the current year has none yet). The
// <script> below swaps panels client-side afterwards; this is only what a no-JS / first-paint
// request sees, same pattern as EventsCalendar's `?month=`. `?anno=` itself takes the short slug
// form (`2026-2027`, not the encoded display label `AR%202026%2F2027`) — friendlier to read/share.
const yearParam = Astro.url.searchParams.get('anno');
const activeYear =
	yearGroups.find((g) => yearLabelSlug(g.yearLabel) === yearParam)?.yearLabel ??
	yearGroups.find((g) => g.yearLabel === currentRotaryYearLabel())?.yearLabel ??
	yearGroups[0]?.yearLabel ??
	null;
---

<section class="archive" id="archivio-eventi">
	<div class="archive-inner">
	<div class="archive-card">
		{yearGroups.length === 0 ? (
			<p class="events-empty">{emptyMessage || t.events.empty}</p>
		) : (
			<div data-events-archive>
				{/* Empty data-tina-field stops Tina's quick-edit click-capture here (BlockRenderer wraps
					the whole block in one), so a tab-pill click isn't swallowed as "select this block"
					before it reaches the tab-switch script below — EventCard's own field wins inside a panel. */}
				<div class="year-tabs" role="tablist" aria-label={t.events.yearFilterLabel} data-tina-field="">
					{yearGroups.map((group) => (
						<a
							href={`?anno=${yearLabelSlug(group.yearLabel)}#archivio-eventi`}
							class:list={['year-tab', { active: group.yearLabel === activeYear }]}
							data-year-tab={yearLabelSlug(group.yearLabel)}
						>
							{group.yearLabel}
						</a>
					))}
				</div>
				{yearGroups.map((group) => (
					<div class="year-panel" data-year-panel={yearLabelSlug(group.yearLabel)} hidden={group.yearLabel !== activeYear}>
						{group.events.map((event) => {
							const localized = localizeEvent(event, lang);
							return (
								<EventCard
									id={eventSlug(event)}
									href={getRelativeLocaleUrl(lang, `eventi/${eventSlug(event)}`)}
									image={event.image}
									imageFocalX={event.imageFocalX}
									imageFocalY={event.imageFocalY}
									imageLabel={localized.imageLabel}
									tags={eventTags(event)}
									title={localized.title}
									dateLabel={dateFormatter.format(new Date(event.date))}
									upcoming={isUpcomingEvent(event.date)}
									upcomingLabel={t.events.upcomingBadge}
									locationLavori={event.locationLavori}
									locationCena={event.locationCena}
									locationLabel={t.events.locationLabel}
									worksLocationLabel={t.events.worksLocationLabel}
									dinnerLocationLabel={t.events.dinnerLocationLabel}
									excerpt={localized.excerpt}
									ticketsUrl={event.ticketsUrl}
									ticketsButtonLabel={t.events.ticketsButtonLabel}
									photoAlbumUrl={event.photoAlbumUrl}
									photoButtonLabel={t.events.photoButtonLabel}
									tinaFieldAttr={tinaField(event)}
								/>
							);
						})}
					</div>
				))}
			</div>
		)}
	</div>
	</div>
</section>

<style>
	.archive {
		background: var(--color-bg);
		padding: 70px 40px 90px;
		scroll-margin-top: 90px;
	}

	.archive-inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	/* Everything else on the site floats as a big rounded card by now — this was still
	   flush with the page background (same fix as EventsCalendar's .calendar-card). */
	.archive-card {
		background: #fff;
		border-radius: var(--shape-extra-large);
		box-shadow: var(--elevation-3);
		padding: 48px 40px;
	}

	.year-panel {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	/* Author styles beat the UA's [hidden] rule on a specificity tie — without this, the
	   flex display above would unhide every year's panel at once (same bug caught and
	   fixed in EventsCalendar's .agenda-content). */
	.year-panel[hidden] {
		display: none;
	}

	.events-empty {
		font-size: 14px;
		color: var(--color-muted);
		font-style: italic;
	}

	.year-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-bottom: 20px;
	}

	.year-tab {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 13px;
		letter-spacing: 0.4px;
		text-transform: uppercase;
		color: var(--color-royal-blue);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--shape-small);
		padding: 8px 22px;
	}

	.year-tab:hover {
		border-color: var(--color-pink);
	}

	.year-tab.active {
		background: var(--color-pink);
		border-color: var(--color-pink);
		color: #fff;
	}

	@media (max-width: 720px) {
		.archive {
			padding: 50px 20px 70px;
		}

		.archive-card {
			border-radius: var(--shape-large);
			padding: 28px 20px;
		}
	}
</style>

<script>
	// Progressive enhancement over the plain `?anno=...` links: swap the visible year panel in
	// place instead of reloading the page. Mirrors the `?month=`/`?day=` pattern in
	// EventsCalendar.astro. If a target year has no panel (shouldn't happen, tabs are generated
	// from the same data), the click falls through to a real navigation.
	function initArchive(root: HTMLElement) {
		const tabs = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-year-tab]'));
		const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-year-panel]'));

		function showYear(year: string): boolean {
			const panel = panels.find((p) => p.dataset.yearPanel === year);
			if (!panel) return false;
			panels.forEach((p) => {
				p.hidden = p !== panel;
			});
			tabs.forEach((tab) => {
				tab.classList.toggle('active', tab.dataset.yearTab === year);
			});
			return true;
		}

		root.addEventListener('click', (event) => {
			const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-year-tab]');
			if (!link) return;
			const year = link.dataset.yearTab;
			if (!year || !showYear(year)) return;
			event.preventDefault();
			const url = new URL(link.href);
			history.pushState(null, '', url.pathname + url.search + url.hash);
		});
	}

	window.addEventListener('popstate', () => {
		const year = new URLSearchParams(location.search).get('anno');
		if (!year) return;
		document.querySelectorAll<HTMLElement>('[data-events-archive]').forEach((root) => {
			const panel = root.querySelector<HTMLElement>(`[data-year-panel="${CSS.escape(year)}"]`);
			if (!panel) return;
			root.querySelectorAll<HTMLElement>('[data-year-panel]').forEach((p) => {
				p.hidden = p !== panel;
			});
			root.querySelectorAll<HTMLAnchorElement>('[data-year-tab]').forEach((tab) => {
				tab.classList.toggle('active', tab.dataset.yearTab === year);
			});
		});
	});

	document.querySelectorAll<HTMLElement>('[data-events-archive]').forEach(initArchive);
</script>
