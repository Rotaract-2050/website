---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../../data/ui-strings';

interface Props {
	lang: Lang;
	title: string;
	body: string;
	buttonLabel: string;
	buttonHref: string;
}

const { lang, title, body, buttonLabel, buttonHref } = Astro.props;
---

<section class="cta-banner">
	<h2 class="cta-title">{title}</h2>
	<p class="cta-body">{body}</p>
	<a href={getRelativeLocaleUrl(lang, buttonHref)} class="cta-button">{buttonLabel}</a>
</section>

<style>
	.cta-banner {
		background: var(--color-pink);
		padding: 70px 40px;
		text-align: center;
		color: #fff;
	}

	.cta-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 32px;
		text-transform: uppercase;
		margin: 0 0 14px;
	}

	.cta-body {
		font-size: 16px;
		max-width: 560px;
		margin: 0 auto 28px;
		opacity: 0.92;
		line-height: 1.6;
	}

	.cta-button {
		display: inline-block;
		background: #fff;
		color: var(--color-pink);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 14px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		padding: 14px 30px;
		border-radius: var(--shape-full);
	}

	.cta-button:hover {
		background: var(--color-bg);
		color: var(--color-pink);
	}
</style>
