---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../../data/ui-strings';

interface Props {
	lang: Lang;
	title: string;
	body: string;
	buttonLabel: string;
	buttonHref: string;
}

const { lang, title, body, buttonLabel, buttonHref } = Astro.props;
---

<section class="cta-banner">
	<div class="cta-card">
		<span class="mark" aria-hidden="true">2050</span>
		<h2 class="cta-title">{title}</h2>
		<p class="cta-body">{body}</p>
		<a href={getRelativeLocaleUrl(lang, buttonHref)} class="cta-button">{buttonLabel}</a>
	</div>
</section>

<style>
	/* A big rounded filled card, inset from the edges like the rest of Home's
	   surfaces — full-bleed solid-color bands were the pre-M3 pattern. */
	.cta-banner {
		background: var(--color-bg);
		padding: 0 40px 96px;
	}

	.cta-card {
		position: relative;
		overflow: hidden;
		max-width: var(--content-max);
		margin: 0 auto;
		background: var(--color-pink);
		border-radius: var(--shape-extra-large);
		box-shadow: var(--elevation-3);
		padding: 80px 40px;
		text-align: center;
		color: #fff;
	}

	/* Signature mark: same recurring "2050" identity cue as Hero/PageBanner, centered
	   here since the CTA's content is centered too (not corner-anchored). */
	.mark {
		position: absolute;
		left: 50%;
		bottom: -0.3em;
		transform: translateX(-50%);
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: clamp(6rem, 20vw, 13rem);
		line-height: 1;
		color: rgba(255, 255, 255, 0.05);
		pointer-events: none;
		user-select: none;
	}

	.cta-title {
		position: relative;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 38px;
		text-transform: uppercase;
		margin: 0 0 14px;
	}

	.cta-body {
		position: relative;
		font-size: 16px;
		max-width: 560px;
		margin: 0 auto 28px;
		opacity: 0.92;
		line-height: 1.6;
	}

	.cta-button {
		position: relative;
		display: inline-block;
		background: #fff;
		color: var(--color-pink);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 14px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		padding: 14px 30px;
		border-radius: var(--shape-full);
	}

	.cta-button:hover {
		background: var(--color-bg);
		color: var(--color-pink);
	}

	@media (max-width: 720px) {
		.cta-banner {
			padding: 0 20px 48px;
		}

		.cta-card {
			border-radius: var(--shape-large);
			padding: 48px 24px;
		}
	}
</style>
