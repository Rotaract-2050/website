---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../../data/ui-strings';

interface Props {
	lang: Lang;
	title: string;
	body: string;
	buttonLabel: string;
	buttonHref: string;
}

const { lang, title, body, buttonLabel, buttonHref } = Astro.props;
---

<section class="cta-banner">
	<div class="cta-card">
		<span class="mark" aria-hidden="true">2050</span>
		<h2 class="cta-title">{title}</h2>
		<p class="cta-body">{body}</p>
		<a href={getRelativeLocaleUrl(lang, buttonHref)} class="cta-button">{buttonLabel}</a>
	</div>
</section>

<style>
	/* A big rounded filled card, inset from the edges like the rest of Home's
	   surfaces — full-bleed solid-color bands were the pre-M3 pattern. */
	.cta-banner {
		background: var(--color-bg);
		padding: 0 40px 96px;
	}

	.cta-card {
		position: relative;
		overflow: hidden;
		max-width: var(--content-max);
		margin: 0 auto;
		border-radius: var(--shape-extra-large);
		padding: 80px 40px;
		text-align: center;
		
		/* Piastrina (Metallic Pink Plate) */
		background: linear-gradient(105deg, var(--color-pink) 0%, color-mix(in srgb, var(--color-pink) 85%, white) 25%, var(--color-pink) 50%, color-mix(in srgb, var(--color-pink) 85%, white) 75%, var(--color-pink) 100%);
		color: #fff;
		box-shadow:
			inset 0 2px 4px rgba(255, 255, 255, 0.4),
			inset 0 -2px 6px rgba(0, 0, 0, 0.2),
			0 12px 32px rgba(0,0,0,0.15);
		border: 1px solid color-mix(in srgb, var(--color-pink) 50%, white);

		/* Movimento leggero: solo transform, il riflesso è nel ::after qui sotto */
		animation: float 6s ease-in-out infinite;
	}

	/* Riflesso in movimento su transform anziché su background-position (non composito,
	   ripaga a ogni frame — segnalato da Lighthouse): il gradiente di base resta statico,
	   si muove solo questo pseudo-elemento, cosa che la GPU gestisce senza toccare il
	   thread principale. */
	.cta-card::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(105deg, transparent 42%, rgba(255, 255, 255, 0.4) 50%, transparent 58%);
		transform: translateX(-120%);
		animation: cta-card-shine 6s linear infinite;
		pointer-events: none;
	}

	@keyframes cta-card-shine {
		0% { transform: translateX(-120%); }
		100% { transform: translateX(120%); }
	}

	@keyframes float {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-8px); }
	}

	/* Signature mark: same recurring "2050" identity cue as Hero/PageBanner, centered
	   here since the CTA's content is centered too (not corner-anchored). */
	.mark {
		position: absolute;
		left: 50%;
		bottom: -0.15em;
		transform: translateX(-50%);
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: clamp(7rem, 22vw, 15rem);
		line-height: 1;
		color: rgba(255, 255, 255, 0.18);
		pointer-events: none;
		user-select: none;
	}

	.cta-title {
		position: relative;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 38px;
		text-transform: uppercase;
		margin: 0 0 14px;
	}

	.cta-body {
		position: relative;
		font-size: 16px;
		max-width: 560px;
		margin: 0 auto 28px;
		opacity: 0.92;
		line-height: 1.6;
	}

	.cta-button {
		position: relative;
		display: inline-block;
		background: #fff;
		color: var(--color-pink);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 14px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		padding: 14px 30px;
		border-radius: var(--shape-full);
		box-shadow: var(--elevation-1);
		transition: transform var(--motion-duration-medium) var(--motion-easing-emphasized), box-shadow var(--motion-duration-medium) var(--motion-easing-emphasized), background var(--motion-duration-medium) var(--motion-easing-emphasized);
	}

	.cta-button:hover {
		transform: translateY(-2px);
		box-shadow: var(--elevation-2);
		background: var(--color-bg);
	}

	@media (max-width: 720px) {
		.cta-banner {
			padding: 0 20px 48px;
		}

		.cta-card {
			border-radius: var(--shape-large);
			padding: 48px 24px;
		}
	}
</style>
