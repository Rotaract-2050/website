---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { tinaField } from '@tinacms/astro';
import NewsCard from '../NewsCard.astro';
import { getDistrictNews, localizeNews, newsSlug, newsTagLabels, newsDateLabel, rotaryYearLabel } from '../../lib/news';
import { uiStrings, type Lang } from '../../data/ui-strings';

interface Props {
	lang: Lang;
	title: string;
	limit?: number;
	showDate?: boolean;
	showYear?: boolean;
}

const { lang, title, limit = 3, showDate = true, showYear = true } = Astro.props;
const t = uiStrings[lang].news;

const articles = await getDistrictNews(limit);
const dateFormatter = new Intl.DateTimeFormat(lang === 'it' ? 'it-IT' : 'en-US', {
	day: 'numeric',
	month: 'short',
	year: 'numeric',
});
---

<section class="news">
	<div class="section-inner">
		<h2 class="section-title">{title}</h2>
		{articles.length > 0 ? (
			<>
				<div class="news-grid">
					{articles.map((article) => {
						const localized = localizeNews(article, lang);
						return (
							<NewsCard
								href={getRelativeLocaleUrl(lang, `news/${newsSlug(article)}`)}
								image={article.image}
								imageFocalX={article.imageFocalX}
								imageFocalY={article.imageFocalY}
								imageLabel={localized.imageLabel}
								tags={newsTagLabels(article)}
								title={localized.title}
								excerpt={localized.excerpt}
								dateLabel={newsDateLabel(article, dateFormatter)}
								yearLabel={rotaryYearLabel(article.date)}
								showDate={showDate}
								showYear={showYear}
								tinaFieldAttr={tinaField(article)}
							/>
						);
					})}
				</div>
				<a href={getRelativeLocaleUrl(lang, 'news')} class="news-view-all">{t.viewAll}</a>
			</>
		) : (
			<p class="news-empty">{t.empty}</p>
		)}
	</div>
</section>

<style>
	.news {
		background: var(--color-bg);
		padding: 80px 40px;
	}

	.section-inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	.section-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 34px;
		color: var(--color-navy);
		text-transform: uppercase;
		margin: 0 0 30px;
	}

	.news-empty {
		font-size: 14px;
		color: var(--color-muted);
		font-style: italic;
	}

	.news-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	.news-view-all {
		display: inline-block;
		margin-top: 30px;
		color: var(--color-pink);
		font-weight: 700;
		font-size: 14px;
	}

	.news-view-all:hover {
		text-decoration: underline;
	}

	@media (max-width: 900px) {
		.news-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.news {
			padding-left: 20px;
			padding-right: 20px;
		}
	}
</style>
