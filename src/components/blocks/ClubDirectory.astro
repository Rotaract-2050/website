---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { requestWithMetadata, tinaField } from '@tinacms/astro';
import client from '../../../tina/__generated__/client';
import ImageSlot from '../ImageSlot.astro';
import type { Lang } from '../../data/ui-strings';
import { uiStrings } from '../../data/ui-strings';

interface Props {
	lang: Lang;
	intro: string;
	disclaimer: string;
}

const { lang, intro, disclaimer } = Astro.props;
const t = uiStrings[lang].clubDetail;

const { data: zonesData } = await requestWithMetadata(client.queries.zonesConnection());
const { data: clubsData } = await requestWithMetadata(client.queries.clubsConnection());

const zones = (zonesData.zonesConnection.edges ?? []).map((edge) => edge?.node).filter((z) => z != null);
const clubs = (clubsData.clubsConnection.edges ?? []).map((edge) => edge?.node).filter((c) => c != null);

const zoneGroups = zones.map((zone) => ({
	name: zone.name,
	clubs: clubs.filter((club) => club.zone?.name === zone.name),
}));
---

<section class="club-list">
	<div class="section-inner">
		<p class="intro">{intro}</p>
		<p class="disclaimer">{disclaimer}</p>

		{zoneGroups.map((zone) => (
			<div class="zone-block">
				<h2 class="zone-heading">{zone.name}</h2>
				<div class="club-grid">
					{zone.clubs.map((club) => (
						<a
							href={getRelativeLocaleUrl(lang, `club/${club._sys.filename}`)}
							class="club-card"
							data-tina-field={tinaField(club)}
						>
							{club.photo ? (
								<Image src={club.photo} alt={`${t.photoAltPrefix} ${club.name}`} width={320} height={180} class="club-photo" />
							) : (
								<ImageSlot label={t.photoMissing} class="club-photo" />
							)}
							<div class="club-body">
								<div class="club-name">{club.name}</div>
								<div class="club-zone">{zone.name}</div>
							</div>
						</a>
					))}
				</div>
			</div>
		))}
	</div>
</section>

<style>
	.club-list {
		background: #fff;
		padding: 70px 40px 90px;
	}

	.section-inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	.intro {
		font-size: 16px;
		color: var(--color-text);
		line-height: 1.7;
		max-width: 720px;
		margin: 0 0 8px;
	}

	.disclaimer {
		font-size: 12px;
		color: var(--color-muted);
		font-style: italic;
		margin: 0 0 40px;
	}

	.zone-block {
		margin-bottom: 36px;
	}

	.zone-heading {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 20px;
		color: var(--color-navy);
		border-bottom: 3px solid var(--color-pink);
		display: inline-block;
		padding-bottom: 6px;
		margin: 0 0 18px;
	}

	.club-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 18px;
	}

	.club-card {
		display: block;
		background: var(--color-bg);
		border-radius: 12px;
		overflow: hidden;
		color: inherit;
		box-shadow: 0 4px 16px rgba(11, 37, 69, 0.07);
		transition: box-shadow 0.2s ease;
	}

	.club-card:hover {
		box-shadow: 0 8px 24px rgba(11, 37, 69, 0.12);
	}

	.club-card :global(.club-photo) {
		width: 100%;
		height: 180px;
		object-fit: cover;
	}

	.club-body {
		padding: 20px;
	}

	.club-name {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 16px;
		color: var(--color-navy);
		margin-bottom: 4px;
	}

	.club-zone {
		font-size: 13px;
		color: var(--color-text);
		margin-bottom: 10px;
	}

	@media (max-width: 900px) {
		.club-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.club-list {
			padding: 50px 20px 70px;
		}

		.club-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
