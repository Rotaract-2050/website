---
interface Props {
	title: string;
	accent?: string;
	layout?: 'badge' | 'path' | 'icon';
	items: { letter: string; icon?: string; title: string; description: string; tinaFieldAttr?: string }[];
}

const { title, accent = '#d41367', layout, items } = Astro.props;
---

<section class="values" data-layout={layout} style={`--accent: ${accent}`}>
	<div class="section-inner">
		<h2 class="section-title center"><span class="section-title-bar" aria-hidden="true"></span>{title}</h2>
		<div class="values-grid">
			{items.map((val) => (
				<div class="value-card" data-tina-field={val.tinaFieldAttr}>
					<div class="value-marker">
						{layout === 'icon' && val.icon ? (
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								{val.icon === 'peace' && (
									<>
										<circle cx="9" cy="12" r="6"></circle>
										<circle cx="15" cy="12" r="6"></circle>
									</>
								)}
								{val.icon === 'health' && (
									<>
										<circle cx="12" cy="12" r="9"></circle>
										<path d="M12 8v8M8 12h8"></path>
									</>
								)}
								{val.icon === 'water' && <path d="M12 3c3.5 4 7 8.4 7 12a7 7 0 0 1-14 0c0-3.6 3.5-8 7-12z"></path>}
								{val.icon === 'family' && (
									<>
										<path d="M12 20s-7-4.3-9.3-8.4C1 8.4 2.7 5 6 5c2 0 3.6 1.1 4 2.6.4-1.5 2-2.6 4-2.6 3.3 0 5 3.4 3.3 6.6C19 15.7 12 20 12 20z"></path>
										<line x1="12" y1="10.5" x2="12" y2="10.5"></line>
									</>
								)}
								{val.icon === 'education' && (
									<>
										<path d="M12 6c-2-1.3-5-1.7-8-1v13c3-.7 6-.3 8 1 2-1.3 5-1.7 8-1V5c-3-.7-6-.3-8 1z"></path>
										<path d="M12 6v13"></path>
									</>
								)}
								{val.icon === 'growth' && (
									<>
										<path d="M3 17l6-6 4 4 7-7"></path>
										<path d="M14 8h6v6"></path>
									</>
								)}
								{val.icon === 'leaf' && (
									<>
										<path d="M12 3c4 2 6 6 6 9 0 3-2 7-6 9-4-2-6-6-6-9 0-3 2-7 6-9z"></path>
										<path d="M12 6v13"></path>
									</>
								)}
							</svg>
						) : (
							<span class="value-letter">{val.letter}</span>
						)}
					</div>
					<div class="value-title">{val.title}</div>
					<div class="value-desc">{val.description}</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.values {
		background: var(--color-bg);
		padding: 80px 40px;
	}

	.section-inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	.section-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 28px;
		color: var(--color-navy);
		text-transform: uppercase;
		margin: 0 0 34px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 14px;
	}

	.section-title-bar {
		display: inline-block;
		width: 36px;
		height: 4px;
		border-radius: 2px;
		background: var(--accent);
	}

	.section-title.center {
		text-align: center;
	}

	.values-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 24px;
	}

	.value-card {
		position: relative;
		background: #fff;
		border-radius: 14px;
		padding: 28px 22px 24px;
		text-align: center;
		box-shadow: 0 4px 16px rgba(11, 37, 69, 0.06);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.value-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 26px rgba(11, 37, 69, 0.13);
	}

	.value-marker {
		width: 56px;
		height: 56px;
		margin: 0 auto 16px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		background: var(--accent);
		color: #fff;
	}

	.value-letter {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 20px;
	}

	.value-marker svg {
		width: 26px;
		height: 26px;
	}

	.value-title {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 16px;
		color: var(--color-navy);
		margin-bottom: 8px;
	}

	.value-desc {
		font-size: 13px;
		color: var(--color-text);
		line-height: 1.5;
	}

	/* --- Badge: a held mark, not a filled icon — outline ring for abstract values --- */
	.values[data-layout='badge'] .value-marker {
		background: none;
		border: 2px solid var(--accent);
		color: var(--accent);
	}

	/* --- Badge & Path: five items read best as one row (a seal band / a route) --- */
	.values[data-layout='badge'] .values-grid,
	.values[data-layout='path'] .values-grid {
		grid-template-columns: repeat(2, 1fr);
	}

	@media (min-width: 901px) {
		.values[data-layout='badge'] .values-grid,
		.values[data-layout='path'] .values-grid {
			grid-template-columns: repeat(5, 1fr);
		}

		/* --- Path only: connect the sequence with a route running through the gaps --- */
		.values[data-layout='path'] .value-card:not(:last-child)::after {
			content: '';
			position: absolute;
			top: 56px;
			right: -24px;
			width: 24px;
			height: 3px;
			background: var(--color-border);
		}
	}

	@media (max-width: 900px) {
		.values-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 720px) {
		.values {
			padding-left: 20px;
			padding-right: 20px;
		}

		.section-title {
			flex-direction: column;
			gap: 10px;
		}
	}
</style>
