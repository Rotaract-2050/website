---
import { Image } from 'astro:assets';

interface Props {
	title: string;
	intro?: string;
	accent?: string;
	layout?: 'badge' | 'path' | 'icon';
	items: { letter: string; icon?: string; title: string; description: string; tinaFieldAttr?: string }[];
}

const { title, intro, accent = '#d41367', layout, items } = Astro.props;

// Official Rotary Areas of Focus icons (brandcenter.rotary.org), full color, one per
// area — each already carries its own official AOF color baked into the PNG, so this
// replaces the earlier hand-drawn single-color SVG set. Maps our existing Tina `icon`
// option keys to the asset's filename segment.
const AOF_ICON_FILE: Record<string, string> = {
	peace: 'peace',
	health: 'disease',
	water: 'water',
	family: 'maternal',
	education: 'education',
	growth: 'economic',
	leaf: 'environment',
};
const aofIconSrc = (icon: string) => `/uploads/Aree-Azione/color/no_title/AOF_${AOF_ICON_FILE[icon]}_color_no_title.png`;

// The official artwork's own baked-in color per area, read off the source PNGs —
// each matches a color already in the Rotary secondary palette (references/rotary-brand.md):
// Azure, Cardinal, Sky Blue, Violet, Orange, Turquoise, Grass respectively. Used to tint
// each card's own tonal surface, same pattern as the zone cards on Home.
const AOF_ICON_COLOR: Record<string, string> = {
	peace: '#0067c8',
	health: '#e02927',
	water: '#00a2e0',
	family: '#901f93',
	education: '#ff7600',
	growth: '#00adbb',
	leaf: '#009739',
};
---

<section class="values" data-layout={layout} style={`--accent: ${accent}`}>
	<div class="section-inner">
		<h2 class="section-title center"><span class="section-title-bar" aria-hidden="true"></span>{title}</h2>
		{intro && <p class="values-intro">{intro}</p>}
		<div class="values-grid" style={`--grid-cols: ${items.length}`}>
			{items.map((val) => (
				<div
					class="value-card"
					data-tina-field={val.tinaFieldAttr}
					style={layout === 'icon' && val.icon ? `--tint:${AOF_ICON_COLOR[val.icon]};` : undefined}
				>
					<div class="value-marker">
						{layout === 'icon' && val.icon ? (
							<Image src={aofIconSrc(val.icon)} alt="" width={200} height={200} quality="high" />
						) : (
							<span class="value-letter">{val.letter}</span>
						)}
					</div>
					<div class="value-title">{val.title}</div>
					<div class="value-desc">{val.description}</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.values {
		background: var(--color-bg);
		padding: 80px 40px;
	}

	.section-inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	.section-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 28px;
		color: var(--color-navy);
		text-transform: uppercase;
		margin: 0 0 34px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 14px;
	}

	.section-title-bar {
		display: inline-block;
		width: 36px;
		height: 4px;
		border-radius: 2px;
		background: var(--accent);
	}

	.section-title.center {
		text-align: center;
	}

	.values-intro {
		max-width: 640px;
		margin: -14px auto 34px;
		font-size: 15px;
		color: var(--color-text);
		font-style: italic;
		text-align: center;
	}

	.values-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 24px;
	}

	.value-card {
		position: relative;
		background: #fff;
		border-radius: var(--shape-medium);
		padding: 28px 22px 24px;
		text-align: center;
		box-shadow: var(--elevation-1);
		transition: transform var(--motion-duration-medium) var(--motion-easing-emphasized), box-shadow var(--motion-duration-medium) var(--motion-easing-emphasized);
	}

	.value-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--elevation-3);
	}

	.value-marker {
		width: 56px;
		height: 56px;
		margin: 0 auto 16px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		background: var(--accent);
		color: #fff;
	}

	.value-letter {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 20px;
	}

	.value-marker :global(img) {
		width: 26px;
		height: 26px;
	}

	.value-title {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 16px;
		color: var(--color-navy);
		margin-bottom: 8px;
	}

	.value-desc {
		font-size: 13px;
		color: var(--color-text);
		line-height: 1.5;
	}

	/* --- Badge: a held mark, not a filled icon — a seal band, not a product card.
	   No box, no shadow: values are principles you hold, not features you ship. --- */
	.values[data-layout='badge'] .value-card {
		background: none;
		box-shadow: var(--elevation-0);
		border-radius: var(--shape-none);
		padding: 8px 20px;
	}

	.values[data-layout='badge'] .value-card:hover {
		transform: none;
		box-shadow: none;
	}

	.values[data-layout='badge'] .value-marker {
		width: 64px;
		height: 64px;
		background: none;
		border: 2px solid var(--accent);
		color: var(--accent);
		transition: transform var(--motion-duration-medium) var(--motion-easing-emphasized);
	}

	.values[data-layout='badge'] .value-card:hover .value-marker {
		transform: scale(1.08);
	}

	.values[data-layout='badge'] .value-title {
		font-size: 17px;
	}

	/* --- Icon: the official AOF artwork already carries its own area color baked in
	   (peace=Azure, environment=Grass, water=Sky Blue, disease=Cardinal, ...), read off
	   the source PNGs into --tint. The card becomes a tonal surface in that same color
	   (same color-mix pattern as the Home zone cards) instead of a plain white card, and
	   the marker turns into a plain white disc so the artwork's own color stays the only
	   color doing work — no --accent circle fighting it. --- */
	.values[data-layout='icon'] .value-card {
		background: color-mix(in srgb, var(--tint, var(--color-navy)) 12%, white);
	}

	.values[data-layout='icon'] .value-marker {
		width: 88px;
		height: 88px;
		background: #fff;
		box-shadow: var(--elevation-1);
	}

	.values[data-layout='icon'] .value-marker :global(img) {
		width: 56px;
		height: 56px;
	}

	/* --- Badge & Path: five items read best as one row (a seal band / a route) --- */
	.values[data-layout='badge'] .values-grid,
	.values[data-layout='path'] .values-grid {
		grid-template-columns: repeat(2, 1fr);
	}

	/* --- Icon: seven distinct causes read better centered than left-anchored,
	   so a ragged last row (4+3) doesn't dangle on the left. --- */
	.values[data-layout='icon'] .values-grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
	}

	.values[data-layout='icon'] .value-card {
		flex: 1 1 240px;
		max-width: 280px;
	}

	@media (min-width: 901px) {
		.values[data-layout='badge'] .values-grid,
		.values[data-layout='path'] .values-grid {
			grid-template-columns: repeat(var(--grid-cols, 5), 1fr);
		}

		.values[data-layout='badge'] .value-card:not(:last-child)::after {
			content: '';
			position: absolute;
			top: 15%;
			bottom: 15%;
			right: 0;
			width: 1px;
			background: var(--color-border);
		}

		/* --- Path only: a waypoint chevron bridging each gap in the route --- */
		.values[data-layout='path'] .value-card:not(:last-child)::after {
			content: '›';
			position: absolute;
			top: 45px;
			right: -23px;
			z-index: 2;
			width: 22px;
			height: 22px;
			border-radius: 50%;
			background: #fff;
			border: 1.5px solid var(--color-border);
			color: var(--accent);
			font-family: var(--font-heading);
			font-weight: 700;
			font-size: 13px;
			line-height: 1;
			display: flex;
			align-items: center;
			justify-content: center;
		}
	}

	@media (max-width: 900px) {
		.values-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 720px) {
		.values {
			padding-left: 20px;
			padding-right: 20px;
		}

		.section-title {
			flex-direction: column;
			gap: 10px;
		}
	}
</style>
