---
// "La nostra famiglia" — Rotary/Rotaract/Interact, one big card per organization, each tinted
// with its own official brand color (not CardGrid: that block's `color` is the secondary
// zone-tag palette, not a primary brand identity color — see tina/config.ts's familyGridTemplate).
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../../data/ui-strings';

interface FamilyCard {
	title: string;
	body?: string;
	buttonLabel?: string;
	buttonHref?: string;
	color?: string;
	tinaFieldAttr?: string;
}

interface Props {
	lang: Lang;
	title: string;
	intro?: string;
	items: FamilyCard[];
}

const { lang, title, intro, items } = Astro.props;
const isExternal = (href: string) => /^https?:\/\//.test(href);

const getWatermark = (t?: string) => {
	if (!t) return '';
	const upper = t.toUpperCase();
	if (upper.includes('ROTARACT')) return 'RAC';
	if (upper.includes('INTERACT')) return 'INT';
	if (upper.includes('ROTARY')) return 'ROT';
	return upper.substring(0, 3);
};
---

<section class="family-grid">
	<div class="section-inner">
		<h2 class="section-title">{title}</h2>
		{intro && <p class="intro">{intro}</p>}
		<div class="card-row">
			{items.map((item) => {
				// buttonHref: '' is a real, valid target — the site root (home) — so only a genuinely
				// missing field (null/undefined) means "no button", not an empty string.
				const href = item.buttonHref;
				const external = href != null && isExternal(href);
				const resolvedHref = href == null ? undefined : external ? href : getRelativeLocaleUrl(lang, href);
				return (
					<div class="card" data-tina-field={item.tinaFieldAttr} style={item.color ? `--tint:${item.color};` : undefined} data-letter={getWatermark(item.title)}>
						<h3 class="card-title">{item.title}</h3>
						{item.body && <p class="card-body">{item.body}</p>}
						{item.buttonLabel && resolvedHref && (
							<a
								href={resolvedHref}
								class="card-button"
								target={external ? '_blank' : undefined}
								rel={external ? 'noopener noreferrer' : undefined}
								data-track="family_card_click"
								data-track-params={JSON.stringify({ family_org: item.title })}
							>
								{item.buttonLabel}
							</a>
						)}
					</div>
				);
			})}
		</div>
	</div>
</section>

<style>
	.family-grid {
		background: var(--color-bg);
		padding: 96px 40px;
	}

	.section-inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	.section-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 34px;
		color: var(--color-navy);
		text-transform: uppercase;
		text-align: center;
		margin: 0 0 12px;
	}

	.intro {
		font-size: 16px;
		color: var(--color-text);
		line-height: 1.7;
		max-width: 640px;
		margin: 0 auto 40px;
		text-align: center;
	}

	/* auto-fit rather than a fixed repeat(3, ...): this section shows all 3 orgs on some pages
	   and only 2 on others (each site skips its own card — see home.md/interact.md), so the
	   layout needs to center and size cleanly either way, not leave a lopsided empty column. */
	.card-row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		max-width: 900px;
		gap: 28px;
		margin: 40px auto 0;
	}

	/* Big M3 tonal container per organization, tinted by its own brand color (--tint) — same
	   "the color IS the surface" pattern as Home's zone CardGrid, just richer (body + button,
	   not just a title/meta link). */
	.card {
		--tint: var(--color-navy);
		position: relative;
		display: flex;
		flex-direction: column;
		background: color-mix(in srgb, var(--tint) 8%, transparent);
		border-radius: 24px;
		padding: 40px 32px;
		overflow: hidden;
		text-align: left;
		z-index: 1;
		transition: transform var(--motion-duration-medium) var(--motion-easing-emphasized), background var(--motion-duration-medium) var(--motion-easing-emphasized);
	}

	.card:hover {
		transform: translateY(-6px) scale(1.02);
		background: color-mix(in srgb, var(--tint) 15%, transparent);
	}

	.card::before {
		content: attr(data-letter);
		position: absolute;
		bottom: -24px;
		right: 8px;
		font-family: var(--font-heading);
		font-size: 140px;
		font-weight: 900;
		color: var(--tint);
		opacity: 0.08;
		line-height: 1;
		z-index: -1;
		transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
		pointer-events: none;
	}

	.card:hover::before {
		transform: scale(1.1) rotate(-5deg);
	}

	.card-title {
		font-family: var(--font-heading);
		font-weight: 800;
		font-size: 22px;
		color: var(--tint);
		text-transform: uppercase;
		margin: 0 0 12px;
	}

	.card-body {
		font-size: 15px;
		color: var(--color-text);
		line-height: 1.65;
		margin: 0 0 28px;
		flex-grow: 1;
	}

	.card-button {
		display: inline-block;
		background: var(--tint);
		color: #fff;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 13px;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		padding: 12px 26px;
		border-radius: var(--shape-full);
		margin-top: auto;
		align-self: flex-start;
		transition: transform var(--motion-duration-short) var(--motion-easing-standard), box-shadow var(--motion-duration-short) var(--motion-easing-standard);
	}

	.card-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 16px color-mix(in srgb, var(--tint) 45%, transparent);
		color: #fff;
	}

	@media (max-width: 900px) {
		.card-row {
			grid-template-columns: 1fr;
			max-width: 380px;
			margin-left: auto;
			margin-right: auto;
		}
	}

	@media (max-width: 720px) {
		.family-grid {
			padding: 60px 20px;
		}
	}
</style>

<script>
	import { revealOnScroll, cappedStagger } from '../../lib/motion';

	document.querySelectorAll<HTMLElement>('.family-grid').forEach((section) => {
		const cards = Array.from(section.querySelectorAll<HTMLElement>('.card'));
		revealOnScroll(section, cards, { opacity: [0, 1], y: [16, 0] }, { delay: cappedStagger(0.1) });
	});
</script>
