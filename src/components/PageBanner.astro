---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../data/ui-strings';
import { uiStrings } from '../data/ui-strings';
import { pageSlugs } from '../data/routes';
import JsonLd from './JsonLd.astro';
import { buildBreadcrumbList } from '../lib/jsonld';

interface Props {
	lang: Lang;
	eyebrow: string;
	title: string;
	breadcrumbCurrent: string;
	titleField?: string;
}

const { lang, eyebrow, title, breadcrumbCurrent, titleField } = Astro.props;
const t = uiStrings[lang];
const homeHref = getRelativeLocaleUrl(lang, pageSlugs.home);
const breadcrumbJsonLd = buildBreadcrumbList([
	{ name: t.breadcrumbHome, url: new URL(homeHref, Astro.site).toString() },
	{ name: breadcrumbCurrent, url: new URL(Astro.url.pathname, Astro.site).toString() },
]);
---

<JsonLd data={breadcrumbJsonLd} />
<div class="page-banner">
	<div class="banner-card">
		<div class="breadcrumb">
			<a href={homeHref}>{t.breadcrumbHome}</a> / {breadcrumbCurrent}
		</div>
		<div class="eyebrow">{eyebrow}</div>
		<h1 class="title" data-tina-field={titleField}>{title}</h1>
	</div>
</div>

<style>
	/* Same big-rounded-card language as the Home hero, applied to every inner page's
	   banner instead of a flat full-bleed band. */
	.page-banner {
		background: var(--color-bg);
		padding: 32px 40px;
	}

	.banner-card {
		max-width: var(--content-max);
		margin: 0 auto;
		background: var(--color-pink);
		border-radius: var(--shape-extra-large);
		box-shadow: var(--elevation-3);
		padding: 72px 48px;
	}

	.breadcrumb {
		font-size: 13px;
		color: rgba(255, 255, 255, 0.6);
		margin-bottom: 16px;
	}

	.breadcrumb a {
		color: inherit;
	}

	.breadcrumb a:hover {
		color: #fff;
	}

	.eyebrow {
		color: #fff;
		font-weight: 700;
		font-size: 13px;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		margin-bottom: 8px;
	}

	.title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 52px;
		color: #fff;
		text-transform: uppercase;
		margin: 0;
	}

	@media (max-width: 720px) {
		.page-banner {
			padding: 16px 16px 0;
		}

		.banner-card {
			border-radius: var(--shape-large);
			padding: 40px 24px;
		}

		.title {
			font-size: 34px;
		}
	}
</style>
