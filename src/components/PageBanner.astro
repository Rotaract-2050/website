---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../data/ui-strings';
import { uiStrings } from '../data/ui-strings';
import { pageSlugs, type PageKey } from '../data/routes';
import JsonLd from './JsonLd.astro';
import { buildBreadcrumbList } from '../lib/jsonld';

interface Props {
	lang: Lang;
	eyebrow: string;
	title: string;
	breadcrumbCurrent: string;
	titleField?: string;
	theme?: 'default' | 'family';
	/** Which page the breadcrumb's "Home" points to — Interact pages must link back to the Interact
	 * home (`interactHome`), never the Rotaract root: two distinct entities under Rotary
	 * International, not one site with a color theme (see references/interact-section.md). */
	homeSlug?: PageKey;
}

const { lang, eyebrow, title, breadcrumbCurrent, titleField, theme = 'default', homeSlug = 'home' } = Astro.props;
const t = uiStrings[lang];
const homeHref = getRelativeLocaleUrl(lang, pageSlugs[homeSlug]);
const breadcrumbJsonLd = buildBreadcrumbList([
	{ name: t.breadcrumbHome, url: new URL(homeHref, Astro.site).toString() },
	{ name: breadcrumbCurrent, url: new URL(Astro.url.pathname, Astro.site).toString() },
]);
---

<JsonLd data={breadcrumbJsonLd} />
<div class="page-banner">
	<div class={`banner-card theme-${theme}`}>
		<span class="mark" aria-hidden="true">2050</span>
		<div class="breadcrumb">
			<a href={homeHref}>{t.breadcrumbHome}</a> / {breadcrumbCurrent}
		</div>
		<div class="eyebrow">{eyebrow}</div>
		<h1 class="title" data-tina-field={titleField}>{title}</h1>
	</div>
</div>

<style>
	/* Same big-rounded-card language as the Home hero, applied to every inner page's
	   banner instead of a flat full-bleed band. */
	.page-banner {
		background: var(--color-bg);
		padding: 32px 40px;
	}

	.banner-card {
		position: relative;
		overflow: hidden;
		max-width: var(--content-max);
		margin: 0 auto;
		background: var(--color-pink);
		border-radius: var(--shape-extra-large);
		box-shadow: var(--elevation-3);
		padding: 72px 48px;
	}

	.banner-card.theme-family {
		background: linear-gradient(135deg, var(--color-kind-rotary) 0%, var(--color-kind-rotaract) 50%, var(--color-kind-interact) 100%) !important;
	}

	/* Signature mark: the district's own number, echoed faintly on every inner page —
	   a quiet recurring identity cue rather than a one-off decoration. */
	.mark {
		position: absolute;
		right: -0.1em;
		bottom: -0.22em;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: clamp(6rem, 18vw, 12rem);
		line-height: 1;
		color: rgba(255, 255, 255, 0.1);
		pointer-events: none;
		user-select: none;
	}

	.breadcrumb {
		position: relative;
		font-size: 13px;
		color: rgba(255, 255, 255, 0.6);
		margin-bottom: 16px;
	}

	.breadcrumb a {
		color: inherit;
	}

	.breadcrumb a:hover {
		color: #fff;
	}

	.eyebrow {
		position: relative;
		color: #fff;
		font-weight: 700;
		font-size: 13px;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		margin-bottom: 8px;
	}

	.title {
		position: relative;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 52px;
		color: #fff;
		text-transform: uppercase;
		margin: 0;
	}

	@media (max-width: 720px) {
		.page-banner {
			padding: 16px 16px 0;
		}

		.banner-card {
			border-radius: var(--shape-large);
			padding: 40px 24px;
		}

		.title {
			font-size: 34px;
		}
	}
</style>
