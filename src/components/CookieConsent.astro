---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { uiStrings, type Lang } from '../data/ui-strings';
import { pageSlugs } from '../data/routes';
import type { ContentGroup } from '../lib/analytics';

interface Props {
	lang: Lang;
	/** Google Analytics 4 Measurement ID from settings. When empty, no banner/script is rendered at all. */
	gaMeasurementId?: string | null;
	/** Site section sent to GA4 as `content_group` on every page view — computed once in BaseLayout. */
	contentGroup: ContentGroup;
}

const { lang, gaMeasurementId, contentGroup } = Astro.props;
const t = uiStrings[lang].cookieConsent;
const privacyHref = getRelativeLocaleUrl(lang, pageSlugs.privacy);
---

{
	gaMeasurementId && (
		<div id="cookie-consent" class="cookie-consent" hidden>
			<p class="cookie-consent__text">
				{t.body} <a href={privacyHref}>{t.policyLink}</a>
			</p>
			<div class="cookie-consent__actions">
				<button type="button" id="cookie-reject" class="cookie-consent__btn cookie-consent__btn--ghost">
					{t.reject}
				</button>
				<button type="button" id="cookie-accept" class="cookie-consent__btn cookie-consent__btn--solid">
					{t.accept}
				</button>
			</div>
		</div>
	)
}

{
	gaMeasurementId && (
		<script is:inline define:vars={{ gaMeasurementId, contentGroup }}>
			const STORAGE_KEY = 'cookie-consent';
			const banner = document.getElementById('cookie-consent');

			// localStorage can throw (sandboxed iframe/webview, private browsing, storage disabled)
			// — if reading it threw, writing it will too, so both read/write go through these and
			// degrade to "banner works, choice just isn't remembered" instead of a dead script that
			// never reaches the addEventListener calls below.
			function readConsent() {
				try {
					return localStorage.getItem(STORAGE_KEY);
				} catch {
					return null;
				}
			}
			function writeConsent(value) {
				try {
					localStorage.setItem(STORAGE_KEY, value);
				} catch {
					/* no-op: consent just won't persist across reloads in this context */
				}
			}

			// UTM-tagged links (Instagram bio, WhatsApp, convocazioni — see the "Link tracciati per
			// la condivisione" field in the Tina events editor) only get attributed if gtag sees the
			// utm_* params. gtag reads them from the current URL, which is lost when the visitor
			// accepts the banner on a later page than the one they landed on. So the landing page's utm_* values are kept
			// in sessionStorage (this tab only, nothing sent anywhere) and handed to gtag on consent.
			const UTM_KEY = 'utm-landing';
			// utm_* query param → gtag config field (GA4 names utm_campaign "campaign_name").
			const UTM_FIELDS = {
				utm_source: 'campaign_source',
				utm_medium: 'campaign_medium',
				utm_campaign: 'campaign_name',
				utm_content: 'campaign_content',
				utm_term: 'campaign_term',
			};
			function captureUtm() {
				const params = new URLSearchParams(location.search);
				if (!params.has('utm_source')) return;
				const utm = {};
				for (const [param, field] of Object.entries(UTM_FIELDS)) {
					const value = params.get(param);
					if (value) utm[field] = value;
				}
				try {
					sessionStorage.setItem(UTM_KEY, JSON.stringify(utm));
				} catch {
					/* no-op: attribution then only works if consent is given on the landing page */
				}
			}
			function takeUtm() {
				try {
					const raw = sessionStorage.getItem(UTM_KEY);
					sessionStorage.removeItem(UTM_KEY);
					return raw ? JSON.parse(raw) : {};
				} catch {
					return {};
				}
			}
			captureUtm();

			// GA is never requested from Google until the visitor explicitly accepts — no
			// gtag.js fetch, no cookie, no request of any kind happens pre-consent.
			function loadGa() {
				if (window.__gaLoaded) return;
				window.__gaLoaded = true;
				const script = document.createElement('script');
				script.async = true;
				script.src = `https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`;
				document.head.appendChild(script);
				window.dataLayer = window.dataLayer || [];
				window.gtag = function gtag() {
					window.dataLayer.push(arguments);
				};
				window.gtag('js', new Date());
				window.gtag('config', gaMeasurementId, { content_group: contentGroup, ...takeUtm() });
				// Lets bundled scripts (BaseLayout: web-vitals, 404 tracking) react to consent given
				// on this very page — see whenGaReady() in src/lib/ga-ready.ts.
				window.dispatchEvent(new Event('ga:ready'));
			}

			const stored = readConsent();
			if (stored === 'granted') {
				loadGa();
			} else if (stored !== 'denied') {
				banner.hidden = false;
			}

			document.getElementById('cookie-accept')?.addEventListener('click', () => {
				writeConsent('granted');
				banner.hidden = true;
				loadGa();
			});
			document.getElementById('cookie-reject')?.addEventListener('click', () => {
				writeConsent('denied');
				banner.hidden = true;
			});

			// Exposed so the footer's "cookie preferences" link can reopen the banner to change a past choice.
			window.openCookieSettings = () => {
				banner.hidden = false;
			};
		</script>
	)
}

<style>
	.cookie-consent {
		position: fixed;
		z-index: 200;
		left: 20px;
		bottom: 20px;
		width: min(420px, calc(100vw - 40px));
		background: var(--color-navy);
		color: #fff;
		border-radius: 16px;
		padding: 20px 24px;
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
		flex-wrap: wrap;
		gap: 16px;
		align-items: center;
		justify-content: space-between;
	}

	/* An author-stylesheet `display` rule always beats the browser's built-in
	   `[hidden] { display: none }` UA rule, regardless of specificity — so `display: flex` can't
	   live on the bare `.cookie-consent` selector above or toggling the `hidden` attribute in JS
	   would never actually hide it (see the same fix in FormazioneChatWidget.astro). */
	.cookie-consent:not([hidden]) {
		display: flex;
	}

	.cookie-consent__text {
		margin: 0;
		font-size: 14px;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.85);
		flex: 1 1 260px;
	}

	.cookie-consent__text a {
		color: var(--color-gold);
		text-decoration: underline;
	}

	.cookie-consent__actions {
		display: flex;
		gap: 10px;
		flex-shrink: 0;
	}

	.cookie-consent__btn {
		font-family: inherit;
		font-size: 14px;
		font-weight: 600;
		border-radius: 999px;
		padding: 10px 20px;
		cursor: pointer;
		border: 1px solid transparent;
	}

	.cookie-consent__btn--ghost {
		background: transparent;
		border-color: rgba(255, 255, 255, 0.4);
		color: #fff;
	}

	.cookie-consent__btn--solid {
		background: var(--color-gold);
		color: var(--color-navy);
	}
</style>
