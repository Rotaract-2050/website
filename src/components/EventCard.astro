---
import { Image } from 'astro:assets';
import ImageSlot from './ImageSlot.astro';
import { tagPillStyle, type NewsTag } from '../lib/news';

interface Props {
	id: string;
	href: string;
	image?: string | null;
	imageFocalX?: number | null;
	imageFocalY?: number | null;
	imageLabel: string;
	typeTags?: NewsTag[];
	clubTags?: NewsTag[];
	hostClubLabel: string;
	title: string;
	dateLabel: string;
	upcoming?: boolean;
	upcomingLabel: string;
	locationLavori?: string | null;
	locationCena?: string | null;
	locationLabel: string;
	worksLocationLabel: string;
	dinnerLocationLabel: string;
	excerpt?: string | null;
	ticketsUrl?: string | null;
	ticketsButtonLabel: string;
	photoAlbumUrl?: string | null;
	photoButtonLabel: string;
	tinaFieldAttr?: string;
}

const {
	id,
	href,
	image,
	imageFocalX,
	imageFocalY,
	imageLabel,
	typeTags = [],
	clubTags = [],
	hostClubLabel,
	title,
	dateLabel,
	upcoming = false,
	upcomingLabel,
	locationLavori,
	locationCena,
	locationLabel,
	worksLocationLabel,
	dinnerLocationLabel,
	excerpt,
	ticketsUrl,
	ticketsButtonLabel,
	photoAlbumUrl,
	photoButtonLabel,
	tinaFieldAttr,
} = Astro.props;
const focalStyle = `--focal-x:${imageFocalX ?? 50}%;--focal-y:${imageFocalY ?? 50}%;`;
---

<article class="event-entry" id={id} data-tina-field={tinaFieldAttr}>
	<div class="event-media">
		<a href={href} class="event-media-link">
			{image ? (
				<Image src={image} alt={imageLabel} width={480} height={270} quality="high" class="event-image" style={focalStyle} />
			) : (
				<ImageSlot label={imageLabel} class="event-image" />
			)}
		</a>
		<div class="event-media-scrim" aria-hidden="true"></div>
		{(upcoming || typeTags.length > 0) && (
			<div class="event-badges">
				{upcoming && <span class="event-upcoming-badge">{upcomingLabel}</span>}
				{typeTags.map((tag) => (
					<span class="event-tag" style={tagPillStyle(tag.color)}>{tag.label}</span>
				))}
			</div>
		)}
	</div>
	<div class="event-content">
		<h2 class="event-title"><a href={href}>{title}</a></h2>
		<div class="event-meta">{dateLabel}</div>
		{clubTags.length > 0 && (
			<div class="event-clubs">
				<span class="event-clubs-label">{hostClubLabel}</span>
				{clubTags.map((tag) => (
					<span class="event-club-tag" style={tagPillStyle(tag.color)}>{tag.label}</span>
				))}
			</div>
		)}
		{locationLavori && locationCena ? (
			<>
				<div class="event-meta event-location"><span class="event-location-label">{worksLocationLabel}:</span> {locationLavori}</div>
				<div class="event-meta event-location"><span class="event-location-label">{dinnerLocationLabel}:</span> {locationCena}</div>
			</>
		) : (
			(locationLavori || locationCena) && (
				<div class="event-meta event-location"><span class="event-location-label">{locationLabel}:</span> {locationLavori || locationCena}</div>
			)
		)}
		{excerpt && <p class="event-excerpt">{excerpt}</p>}
		{(ticketsUrl || photoAlbumUrl) && (
			<div class="event-actions">
				{ticketsUrl && (
					<a
						class="event-tickets-btn"
						href={ticketsUrl}
						target="_blank"
						rel="noopener"
						data-track="event_tickets_click"
						data-track-params={JSON.stringify({ event_name: title })}
					>
						{ticketsButtonLabel}
					</a>
				)}
				{photoAlbumUrl && (
					<a
						class="event-photo-btn"
						href={photoAlbumUrl}
						target="_blank"
						rel="noopener"
						data-track="event_photos_click"
						data-track-params={JSON.stringify({ event_name: title })}
					>
						{photoButtonLabel}
					</a>
				)}
			</div>
		)}
	</div>
</article>

<style>
	/* Same photo-forward material card as NewsCard: badges float on the image over a
	   scrim, the whole entry is an elevated tonal card instead of a border-separated
	   row, image zooms on hover. */
	.event-entry {
		display: grid;
		grid-template-columns: 320px 1fr;
		gap: 28px;
		align-items: center;
		background: var(--color-bg);
		border-radius: var(--shape-large);
		padding: 20px;
		box-shadow: var(--elevation-1);
		scroll-margin-top: 90px;
		transition: transform var(--motion-duration-medium) var(--motion-easing-emphasized), box-shadow var(--motion-duration-medium) var(--motion-easing-emphasized);
	}

	.event-entry:hover {
		transform: translateY(-4px);
		box-shadow: var(--elevation-3);
	}

	.event-media {
		position: relative;
		border-radius: var(--shape-medium);
		overflow: hidden;
	}

	.event-media-link {
		display: block;
	}

	.event-entry :global(.event-image) {
		width: 100%;
		height: 200px;
		object-fit: cover;
		object-position: var(--focal-x, 50%) var(--focal-y, 50%);
		transition: transform var(--motion-duration-long) var(--motion-easing-emphasized);
	}

	.event-entry:hover :global(.event-image) {
		transform: scale(1.06);
	}

	.event-media-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(11, 37, 69, 0.5) 0%, rgba(11, 37, 69, 0) 45%);
		pointer-events: none;
	}

	.event-badges {
		position: absolute;
		top: 12px;
		left: 12px;
		right: 12px;
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.event-content {
		min-width: 0;
	}

	.event-tag {
		display: inline-block;
		background: var(--tag-bg, rgba(255, 255, 255, 0.85));
		color: var(--tag-color, var(--color-pink));
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		padding: 5px 11px;
		border-radius: var(--shape-small);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		box-shadow: var(--elevation-1);
	}

	/* Club tags live on the card's white body, not the photo: a zone-tinted pill floated over a
	   photo (behind a scrim, blurred) reads poorly for darker hues — same fix as the featured
	   role card on La Squadra. Off-photo they just need a light tint + solid text, like the
	   person/news tag pills. */
	.event-clubs {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 6px;
		margin-bottom: 14px;
	}

	.event-clubs-label {
		font-size: 12px;
		font-weight: 700;
		color: var(--color-navy);
		text-transform: uppercase;
		letter-spacing: 0.4px;
	}

	.event-club-tag {
		display: inline-block;
		background: var(--tag-bg, var(--color-navy-container));
		color: var(--tag-color, var(--color-navy));
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.2px;
		padding: 3px 10px;
		border-radius: var(--shape-full);
	}

	.event-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 22px;
		color: var(--color-navy);
		text-transform: uppercase;
		margin: 0 0 8px;
	}

	.event-title a {
		color: inherit;
	}

	.event-entry:hover .event-title a {
		color: var(--color-pink);
	}

	.event-meta {
		font-size: 14px;
		color: var(--color-muted);
		text-transform: uppercase;
		letter-spacing: 0.4px;
		margin-bottom: 6px;
	}

	.event-meta:last-of-type {
		margin-bottom: 14px;
	}

	.event-location {
		text-transform: none;
		letter-spacing: normal;
	}

	.event-location-label {
		color: var(--color-pink);
		font-weight: 700;
	}

	.event-upcoming-badge {
		display: inline-block;
		background: var(--color-gold);
		color: var(--color-navy);
		font-weight: 700;
		font-size: 11px;
		letter-spacing: 0.5px;
		padding: 5px 11px;
		border-radius: var(--shape-small);
		box-shadow: var(--elevation-1);
	}

	.event-excerpt {
		font-size: 15px;
		color: var(--color-text);
		line-height: 1.6;
		margin: 0 0 16px;
	}

	.event-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.event-tickets-btn {
		display: inline-block;
		background: var(--color-pink);
		color: #fff;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 13px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		padding: 10px 20px;
		border-radius: var(--shape-full);
	}

	.event-tickets-btn:hover {
		background: var(--color-pink-dark);
		color: #fff;
	}

	.event-photo-btn {
		display: inline-block;
		background: transparent;
		color: var(--color-navy);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 13px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		padding: 8px 18px;
		border-radius: var(--shape-full);
		border: 2px solid var(--color-navy);
	}

	.event-photo-btn:hover {
		background: var(--color-navy);
		color: #fff;
	}

	@media (max-width: 720px) {
		.event-entry {
			grid-template-columns: 1fr;
			gap: 16px;
			padding: 16px;
			border-radius: var(--shape-medium);
		}
	}
</style>
