---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../data/ui-strings';
import { uiStrings, SOCIAL_LINKS, UTILITY_LINKS } from '../data/ui-strings';
import { pageSlugs, type PageKey } from '../data/routes';
import SocialIcon from './SocialIcon.astro';

interface Props {
	lang: Lang;
	current: PageKey;
}

const { lang, current } = Astro.props;
const t = uiStrings[lang];

const href = (page: PageKey) => getRelativeLocaleUrl(lang, pageSlugs[page]);
const otherLang: Lang = lang === 'it' ? 'en' : 'it';
const langSwitchHref = getRelativeLocaleUrl(otherLang, pageSlugs[current]);

const distrettoActive = (['distretto', 'story', 'rrd', 'squadra'] as PageKey[]).includes(current);
---

<div class="utility-bar">
	<div class="utility-links">
		{UTILITY_LINKS.map((link) => (
			<a href={link.href} target="_blank" rel="noopener">{link.label}</a>
		))}
	</div>
	<div class="utility-right">
		<div class="lang-switch">
			{lang === 'it'
				? <span class="lang-btn active" aria-current="true">IT</span>
				: <a href={langSwitchHref} class="lang-btn" hreflang="it">IT</a>}
			{lang === 'en'
				? <span class="lang-btn active" aria-current="true">EN</span>
				: <a href={langSwitchHref} class="lang-btn" hreflang="en">EN</a>}
		</div>
		<div class="divider" aria-hidden="true"></div>
		<div class="social-icons">
			{SOCIAL_LINKS.map((soc) => (
				<a href={soc.href} target="_blank" rel="noopener" class="social-icon" aria-label={soc.label}>
					<SocialIcon name={soc.name} />
				</a>
			))}
		</div>
	</div>
</div>

<header class="main-nav">
	<a href={href('home')} class="brand">
		<Image src="/uploads/Loghi/Logo-distretto-nav.png" alt="Rotaract Distretto 2050" width={429} height={158} quality="high" class="brand-logo" />
	</a>

	<button
		type="button"
		class="menu-toggle"
		aria-expanded="false"
		aria-controls="primary-nav"
		aria-label={t.nav.menuOpen}
		data-menu-toggle
		data-label-open={t.nav.menuOpen}
		data-label-close={t.nav.menuClose}
	>
		<span class="menu-toggle-bar" aria-hidden="true"></span>
		<span class="menu-toggle-bar" aria-hidden="true"></span>
		<span class="menu-toggle-bar" aria-hidden="true"></span>
	</button>

	<nav class="nav-links" id="primary-nav" aria-label="Main">
		<a href={href('home')} class:list={['nav-link', { active: current === 'home' }]}>{t.nav.home}</a>

		<div class="nav-dropdown">
			<a href={href('distretto')} class:list={['nav-link', { active: distrettoActive }]}>
				{t.nav.distrettoMenu} <span aria-hidden="true">▾</span>
			</a>
			<div class="dropdown-panel">
				<a href={href('distretto')}>{t.nav.distrettoSub}</a>
				<a href={href('story')}>{t.nav.story}</a>
				<a href={href('rrd')}>{t.nav.rrd}</a>
				<a href={href('squadra')}>{t.nav.squadra}</a>
			</div>
		</div>

		<a href={href('club')} class:list={['nav-link', { active: current === 'club' }]}>{t.nav.club}</a>
		<a href={href('news')} class:list={['nav-link', { active: current === 'news' }]}>{t.nav.news}</a>
		<a href={href('eventi')} class:list={['nav-link', { active: current === 'eventi' }]}>{t.nav.eventi}</a>
		<a href={href('materiali')} class:list={['materials-link', { active: current === 'materiali' }]}>⬇ {t.nav.materials}</a>
		<a href={href('club')} class="join-btn">{t.nav.join}</a>
	</nav>
</header>

<style>
	.utility-bar {
		background: var(--color-navy);
		padding: 8px 40px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px;
	}

	.utility-links {
		display: flex;
		gap: 20px;
		flex-wrap: wrap;
	}

	.utility-links a {
		color: #b9c6e0;
		font-size: 12px;
		letter-spacing: 0.4px;
		text-transform: uppercase;
		font-weight: 500;
	}

	.utility-links a:hover {
		color: #fff;
	}

	.utility-right {
		display: flex;
		gap: 16px;
		align-items: center;
	}

	.lang-switch {
		display: flex;
		gap: 6px;
	}

	.lang-btn {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.5px;
		padding: 2px 6px;
		color: rgba(255, 255, 255, 0.55);
	}

	.lang-btn.active {
		color: var(--color-gold);
	}

	a.lang-btn:hover {
		color: #fff;
	}

	.divider {
		width: 1px;
		height: 14px;
		background: rgba(255, 255, 255, 0.2);
	}

	.social-icons {
		display: flex;
		gap: 8px;
	}

	.social-icon {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.12);
		color: #fff;
		padding: 5px;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.social-icon:hover {
		background: rgba(255, 255, 255, 0.22);
		color: #fff;
	}

	.main-nav {
		background: #fff;
		padding: 14px 40px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 16px;
		box-shadow: 0 2px 10px rgba(11, 37, 69, 0.06);
		position: sticky;
		top: 0;
		z-index: 50;
	}

	.brand {
		display: flex;
		align-items: center;
	}

	.brand-logo {
		height: 48px;
		width: auto;
	}

	.menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 5px;
		width: 40px;
		height: 40px;
		padding: 0;
		border: none;
		background: transparent;
		flex-shrink: 0;
	}

	.menu-toggle-bar {
		width: 24px;
		height: 2px;
		border-radius: 2px;
		background: var(--color-navy);
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle-bar:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle-bar:nth-child(2) {
		opacity: 0;
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle-bar:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 26px;
		flex-wrap: wrap;
	}

	.nav-link {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 15px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		color: var(--color-navy);
		padding: 8px 2px;
		border-bottom: 3px solid transparent;
	}

	.nav-link:hover {
		color: var(--color-pink);
	}

	.nav-link.active {
		color: var(--color-pink);
		border-bottom-color: var(--color-pink);
	}

	.nav-dropdown {
		position: relative;
	}

	.dropdown-panel {
		position: absolute;
		top: 100%;
		left: 0;
		background: #fff;
		box-shadow: 0 10px 30px rgba(11, 37, 69, 0.15);
		border-radius: 10px;
		min-width: 230px;
		padding: 10px;
		z-index: 60;
		display: none;
		flex-direction: column;
	}

	.nav-dropdown:hover .dropdown-panel,
	.nav-dropdown:focus-within .dropdown-panel {
		display: flex;
	}

	.dropdown-panel a {
		font-size: 14px;
		color: var(--color-navy);
		padding: 10px 12px;
		border-radius: 6px;
	}

	.dropdown-panel a:hover {
		background: var(--color-bg);
		color: var(--color-pink);
	}

	.materials-link {
		color: var(--color-navy);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 13px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		padding: 10px 18px;
		border-radius: 999px;
		border: 2px solid var(--color-navy);
	}

	.materials-link:hover {
		background: var(--color-navy);
		color: #fff;
	}

	.join-btn {
		background: var(--color-pink);
		color: #fff;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 13px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		padding: 11px 22px;
		border-radius: 999px;
	}

	.join-btn:hover {
		background: var(--color-pink-dark);
		color: #fff;
	}

	@media (max-width: 860px) {
		.main-nav {
			padding: 14px 20px;
		}

		.utility-bar {
			padding: 8px 20px;
		}

		.brand-logo {
			height: 38px;
		}

		.menu-toggle {
			display: flex;
		}

		.nav-links {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 4px;
			background: #fff;
			padding: 8px 20px 24px;
			box-shadow: 0 10px 30px rgba(11, 37, 69, 0.15);
			max-height: calc(100vh - 100%);
			overflow-y: auto;
		}

		.nav-links[data-open] {
			display: flex;
		}

		.nav-link {
			padding: 12px 4px;
			border-bottom: 1px solid var(--color-bg);
		}

		.nav-dropdown {
			display: flex;
			flex-direction: column;
		}

		.dropdown-panel {
			position: static;
			display: flex;
			flex-direction: column;
			min-width: 0;
			padding: 0 0 8px 16px;
			box-shadow: none;
			border-radius: 0;
		}

		.dropdown-panel a {
			padding: 8px 12px;
			font-size: 13px;
		}

		.materials-link,
		.join-btn {
			text-align: center;
			margin-top: 8px;
		}
	}
</style>

<script>
	function initMenu(header: Element) {
		const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
		const panel = header.querySelector<HTMLElement>('#primary-nav');
		if (!toggle || !panel) return;

		const openLabel = toggle.dataset.labelOpen ?? '';
		const closeLabel = toggle.dataset.labelClose ?? '';

		function setOpen(open: boolean) {
			toggle!.setAttribute('aria-expanded', String(open));
			toggle!.setAttribute('aria-label', open ? closeLabel : openLabel);
			panel!.toggleAttribute('data-open', open);
		}

		toggle.addEventListener('click', () => {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		panel.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) setOpen(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
				setOpen(false);
				toggle.focus();
			}
		});

		const desktopQuery = window.matchMedia('(min-width: 861px)');
		desktopQuery.addEventListener('change', (event) => {
			if (event.matches) setOpen(false);
		});
	}

	document.querySelectorAll('.main-nav').forEach(initMenu);
</script>
