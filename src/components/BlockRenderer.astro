---
import type { PagesQuery } from '../../tina/__generated__/types';
import type { Lang } from '../data/ui-strings';
import BlockItem from './BlockItem.astro';

function nonNull<T>(value: T | null | undefined): value is T {
	return value != null;
}

interface Props {
	lang: Lang;
	blocks: NonNullable<PagesQuery['pages']['blocks']>;
}

const { lang, blocks } = Astro.props;
---

{blocks.filter(nonNull).map((block) => (
	<BlockItem lang={lang} block={block} />
))}
