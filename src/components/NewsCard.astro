---
import { Image } from 'astro:assets';
import ImageSlot from './ImageSlot.astro';
import { tagPillStyle, type NewsTag } from '../lib/news';

interface Props {
	href: string;
	image?: string | null;
	imageLabel: string;
	tags?: NewsTag[];
	title: string;
	excerpt: string;
	dateLabel: string;
	yearLabel: string;
	tinaFieldAttr?: string;
}

const { href, image, imageLabel, tags = [], title, excerpt, dateLabel, yearLabel, tinaFieldAttr } = Astro.props;
---

<article class="news-card" data-tina-field={tinaFieldAttr}>
	<a href={href} class="news-link">
		{image ? (
			<Image src={image} alt={imageLabel} width={400} height={170} class="news-image" />
		) : (
			<ImageSlot label={imageLabel} class="news-image" />
		)}
		<div class="news-body">
			{tags.length > 0 && (
				<div class="news-tags">
					{tags.map((tag) => (
						<span class="news-tag" style={tagPillStyle(tag.color)}>{tag.label}</span>
					))}
				</div>
			)}
			<h3 class="news-title">{title}</h3>
			<p class="news-excerpt">{excerpt}</p>
			<div class="news-date">{dateLabel} · {yearLabel}</div>
		</div>
	</a>
</article>

<style>
	.news-card {
		background: #fff;
		border-radius: 14px;
		overflow: hidden;
		box-shadow: 0 4px 16px rgba(11, 37, 69, 0.07);
	}

	.news-link {
		display: block;
		color: inherit;
	}

	.news-card :global(.news-image) {
		width: 100%;
		height: 170px;
		object-fit: cover;
	}

	.news-body {
		padding: 20px;
	}

	.news-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-bottom: 12px;
	}

	.news-tag {
		display: inline-block;
		background: var(--tag-bg, rgba(212, 19, 103, 0.1));
		color: var(--tag-color, var(--color-pink));
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		padding: 4px 10px;
		border-radius: 999px;
	}

	.news-title {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 17px;
		color: var(--color-navy);
		line-height: 1.3;
		margin: 0 0 8px;
	}

	.news-excerpt {
		font-size: 14px;
		color: var(--color-text);
		line-height: 1.5;
		margin: 0 0 12px;
	}

	.news-date {
		font-size: 12px;
		color: var(--color-muted);
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}
</style>
