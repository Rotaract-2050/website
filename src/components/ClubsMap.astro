---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../data/ui-strings';
import { uiStrings } from '../data/ui-strings';
import 'leaflet/dist/leaflet.css';

interface MapClub {
	name: string;
	lat?: number | null;
	lng?: number | null;
	_sys: { filename: string };
}

interface Props {
	lang: Lang;
	clubs: MapClub[];
}

const { lang, clubs } = Astro.props;
const t = uiStrings[lang].clubMap;

const markers = clubs
	.filter((club): club is MapClub & { lat: number; lng: number } => typeof club.lat === 'number' && typeof club.lng === 'number')
	.map((club) => ({
		name: club.name,
		lat: club.lat,
		lng: club.lng,
		href: getRelativeLocaleUrl(lang, `club/${club._sys.filename}`),
	}));
---

<section class="clubs-map-section">
	<div class="section-inner">
		<h2 class="map-title">{t.title}</h2>
		<p class="map-disclaimer">{t.disclaimer}</p>
		{markers.length > 0 ? (
			<div
				id="clubs-map"
				class="clubs-map"
				data-clubs={JSON.stringify(markers)}
				data-view-label={t.viewClub}
				role="application"
				aria-label={t.title}
			>
			</div>
		) : (
			<p class="map-unavailable">{t.unavailable}</p>
		)}
	</div>
</section>

<script>
	import L from 'leaflet';

	interface MapMarker {
		name: string;
		lat: number;
		lng: number;
		href: string;
	}

	function initClubsMap(container: HTMLElement) {
		const markers: MapMarker[] = JSON.parse(container.dataset.clubs ?? '[]');
		const viewClubLabel = container.dataset.viewLabel ?? '';
		if (markers.length === 0) return;

		const map = L.map(container, { scrollWheelZoom: false });
		L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
			maxZoom: 19,
			attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors',
		}).addTo(map);

		const pinIcon = L.divIcon({
			className: 'club-pin',
			html: '<svg viewBox="0 0 24 32" width="28" height="36" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12c0 9 12 20 12 20s12-11 12-20c0-6.6-5.4-12-12-12z" fill="#d41367" stroke="#fff" stroke-width="1.5"/><circle cx="12" cy="12" r="4.5" fill="#fff"/></svg>',
			iconSize: [28, 36],
			iconAnchor: [14, 36],
			popupAnchor: [0, -32],
		});

		// Several clubs share the same town-level coordinates (no precise address on file):
		// fan overlapping pins out slightly around the shared point so every club stays clickable.
		const seen = new Map<string, number>();
		const bounds: [number, number][] = [];

		for (const club of markers) {
			const key = `${club.lat.toFixed(4)},${club.lng.toFixed(4)}`;
			const occurrence = seen.get(key) ?? 0;
			seen.set(key, occurrence + 1);

			const angle = (occurrence * 137.5 * Math.PI) / 180;
			const radius = occurrence === 0 ? 0 : 0.006 + occurrence * 0.0015;
			const lat = club.lat + radius * Math.cos(angle);
			const lng = club.lng + radius * Math.sin(angle);

			const marker = L.marker([lat, lng], { icon: pinIcon }).addTo(map);
			marker.bindPopup(() => {
				const wrapper = document.createElement('div');
				const title = document.createElement('strong');
				title.textContent = club.name;
				const link = document.createElement('a');
				link.href = club.href;
				link.textContent = viewClubLabel;
				wrapper.append(title, document.createElement('br'), link);
				return wrapper;
			});

			bounds.push([lat, lng]);
		}

		if (bounds.length === 1) {
			map.setView(bounds[0], 12);
		} else {
			map.fitBounds(bounds, { padding: [30, 30], maxZoom: 12 });
		}
	}

	document.querySelectorAll<HTMLElement>('#clubs-map').forEach(initClubsMap);
</script>

<style>
	.clubs-map-section {
		background: var(--color-bg);
		padding: 60px 40px 20px;
	}

	.section-inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	.map-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 30px;
		color: var(--color-navy);
		margin: 0 0 8px;
	}

	.map-disclaimer {
		font-size: 12px;
		color: var(--color-muted);
		font-style: italic;
		margin: 0 0 24px;
	}

	.clubs-map {
		width: 100%;
		height: 480px;
		border-radius: 14px;
		overflow: hidden;
		box-shadow: 0 4px 16px rgba(11, 37, 69, 0.07);
	}

	.map-unavailable {
		font-size: 14px;
		color: var(--color-muted);
	}

	@media (max-width: 600px) {
		.clubs-map-section {
			padding: 40px 20px 10px;
		}

		.clubs-map {
			height: 360px;
		}
	}
</style>
