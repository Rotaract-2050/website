---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { tinaField } from '@tinacms/astro';
import type { SettingsQuery } from '../../tina/__generated__/types';
import type { Lang } from '../data/ui-strings';
import { uiStrings, SOCIAL_LINKS } from '../data/ui-strings';
import { pageSlugs, type PageKey } from '../data/routes';
import SocialIcon from './SocialIcon.astro';

interface Props {
	lang: Lang;
	settings: SettingsQuery['settings'];
}

const { lang, settings } = Astro.props;
const t = uiStrings[lang];
const href = (page: PageKey) => getRelativeLocaleUrl(lang, pageSlugs[page]);
---

<footer class="site-footer">
	<div class="footer-grid">
		<div>
			<div class="footer-title">ROTARACT DISTRETTO 2050</div>
			<p class="footer-about" data-tina-field={tinaField(settings, 'about')}>{settings.about}</p>
		</div>
		<div>
			<div class="footer-heading">{t.footer.linksTitle}</div>
			<div class="footer-links">
				<a href={href('home')}>{t.nav.home}</a>
				<a href={href('distretto')}>{t.nav.distrettoMenu}</a>
				<a href={href('club')}>{t.nav.club}</a>
				<a href={href('squadra')}>{t.nav.squadra}</a>
				<a href={href('privacy')}>{t.footer.privacyLink}</a>
			</div>
		</div>
		<div>
			<div class="footer-heading">{t.footer.contactTitle}</div>
			<p class="footer-contact">
				<span data-tina-field={tinaField(settings, 'address')}>{settings.address}</span>
				{settings.fiscalCode && (
					<>
						<br />
						<span data-tina-field={tinaField(settings, 'fiscalCode')}>
							{t.footer.fiscalCodeLabel}: {settings.fiscalCode}
						</span>
					</>
				)}
				<br />
				<span data-tina-field={tinaField(settings, 'email')}>{settings.email}</span>
			</p>
		</div>
		<div>
			<div class="footer-heading">{t.footer.socialTitle}</div>
			<div class="footer-social">
				{SOCIAL_LINKS.map((soc) => (
					<a href={soc.href} target="_blank" rel="noopener" class="social-icon" aria-label={soc.label}>
						<SocialIcon name={soc.name} />
					</a>
				))}
			</div>
		</div>
	</div>
	<div class="footer-bottom">
		<div class="footer-copyright">
			<span>{t.footer.copyright}</span>
			<span class="separator">|</span>
			<a href="https://github.com/Rotaract-2050/website" target="_blank" rel="noopener noreferrer" class="github-link">
				<span class="icon-wrap"><SocialIcon name="github" /></span>
				<span>{t.footer.sourceCode}</span>
			</a>
		</div>
		<div>{t.footer.underRotary}</div>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-navy);
		color: #fff;
		padding: 60px 40px 0;
	}

	.footer-grid {
		max-width: var(--content-max);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.4fr 0.8fr 1fr 0.8fr;
		gap: 40px;
		padding-bottom: 40px;
	}

	.footer-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 20px;
		margin-bottom: 14px;
	}

	.footer-about {
		font-size: 14px;
		color: rgba(255, 255, 255, 0.65);
		line-height: 1.6;
		margin: 0;
	}

	.footer-heading {
		font-weight: 700;
		font-size: 12px;
		letter-spacing: 1px;
		text-transform: uppercase;
		margin-bottom: 16px;
		color: var(--color-gold);
	}

	.footer-links {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.footer-links a {
		font-size: 14px;
		color: rgba(255, 255, 255, 0.75);
	}

	.footer-links a:hover {
		color: #fff;
	}

	.footer-contact {
		font-size: 14px;
		color: rgba(255, 255, 255, 0.75);
		line-height: 1.7;
		margin: 0;
	}

	.footer-social {
		display: flex;
		gap: 10px;
	}

	.social-icon {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.1);
		color: #fff;
		padding: 7px;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.social-icon:hover {
		background: rgba(255, 255, 255, 0.2);
		color: #fff;
	}

	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		padding: 20px 0;
		display: flex;
		justify-content: space-between;
		max-width: var(--content-max);
		margin: 0 auto;
		font-size: 12px;
		color: rgba(255, 255, 255, 0.5);
		flex-wrap: wrap;
		gap: 8px;
	}

	.footer-copyright {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
	}

	.separator {
		opacity: 0.5;
	}

	.github-link {
		display: flex;
		align-items: center;
		gap: 4px;
		color: inherit;
		text-decoration: none;
		transition: opacity 0.2s;
	}

	.github-link:hover {
		opacity: 0.8;
		text-decoration: underline;
	}

	.icon-wrap {
		width: 14px;
		height: 14px;
		display: flex;
	}

	@media (max-width: 900px) {
		.site-footer {
			padding: 60px 20px 0;
		}

		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 540px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
