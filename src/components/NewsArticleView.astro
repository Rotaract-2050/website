---
import { requestWithMetadata, tinaField } from '@tinacms/astro';
import client from '../../tina/__generated__/client';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from './PageBanner.astro';
import { Image } from 'astro:assets';
import ImageSlot from './ImageSlot.astro';
import { uiStrings, type Lang } from '../data/ui-strings';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { localizeNews, newsTagLabels, rotaryYearLabel, tagPillStyle } from '../lib/news';
import JsonLd from './JsonLd.astro';
import { buildNewsArticleJsonLd } from '../lib/jsonld';
import { renderTinaMarkdown } from '../lib/tina-rich-text';

interface Props {
	lang: Lang;
	/** News article slug, e.g. `made-in` — never a multi-segment path. */
	slug: string;
}

const { lang, slug } = Astro.props;
const t = uiStrings[lang];
const relativePath = `${slug}.md`;

const result = await requestWithMetadata(client.queries.news({ relativePath }), { priority: 'primary' });
const article = result.data.news;

if (!article) {
	return Astro.redirect(getRelativeLocaleUrl(lang, 'news'));
}

const dateFormatter = new Intl.DateTimeFormat(lang === 'it' ? 'it-IT' : 'en-US', { day: 'numeric', month: 'short', year: 'numeric' });
const tags = newsTagLabels(article);
const localized = localizeNews(article, lang);
const titleField = lang === 'en' && article.titleEn ? 'titleEn' : 'title';
const bodyField = lang === 'en' && article.bodyEn ? 'bodyEn' : 'body';
const jsonLd = buildNewsArticleJsonLd({
	headline: localized.title,
	description: localized.excerpt,
	imageUrl: new URL(article.image || '/uploads/Loghi/Logo-distretto.png', Astro.site).toString(),
	datePublished: article.date,
	url: new URL(Astro.url.pathname, Astro.site).toString(),
	lang,
	publisherLogoUrl: new URL('/uploads/Loghi/Logo-distretto.png', Astro.site).toString(),
});
const bodyHtml = renderTinaMarkdown(localized.body);
---

<BaseLayout
	lang={lang}
	current="news"
	title={localized.title}
	description={localized.excerpt}
	alternateHref={getRelativeLocaleUrl(lang === 'it' ? 'en' : 'it', `news/${slug}`)}
	image={article.image}
	type="article"
	publishedTime={article.date}
>
	<PageBanner
		lang={lang}
		eyebrow={t.news.articleEyebrow}
		title={localized.title}
		breadcrumbCurrent={t.nav.news}
		titleField={tinaField(article, titleField)}
	/>
	<article class="news-article">
		<div class="article-inner">
			<a href={getRelativeLocaleUrl(lang, 'news')} class="back-link">{t.news.backToArchive}</a>
			<div class="article-meta">
				{tags.length > 0 && (
					<div class="article-tags" data-tina-field={tinaField(article, 'scope')}>
						{tags.map((tag) => (
							<span class="article-tag" style={tagPillStyle(tag.color)}>{tag.label}</span>
						))}
					</div>
				)}
				<span class="article-date" data-tina-field={tinaField(article, 'date')}>
					{dateFormatter.format(new Date(article.date)).toUpperCase()} · {rotaryYearLabel(article.date)}
				</span>
			</div>
			<div data-tina-field={tinaField(article, 'image')}>
				{article.image ? (
					<Image src={article.image} alt={localized.imageLabel} width={960} height={420} fit="contain" quality="high" class="article-image" />
				) : (
					<ImageSlot label={localized.imageLabel} class="article-image" />
				)}
			</div>
			<div class="article-body" data-tina-field={tinaField(article, bodyField)} set:html={bodyHtml} />
		</div>
	</article>
	<JsonLd data={jsonLd} />
</BaseLayout>

<style>
	.news-article {
		background: #fff;
		padding: 50px 40px 90px;
	}

	.article-inner {
		max-width: 760px;
		margin: 0 auto;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 24px;
		color: var(--color-pink);
		font-weight: 700;
		font-size: 14px;
	}

	.back-link:hover {
		text-decoration: underline;
	}

	.article-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px 14px;
		margin-bottom: 20px;
	}

	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.article-tag {
		display: inline-block;
		background: var(--tag-bg, rgba(212, 19, 103, 0.1));
		color: var(--tag-color, var(--color-pink));
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		padding: 4px 10px;
		border-radius: 999px;
	}

	.article-date {
		font-size: 12px;
		color: var(--color-muted);
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.article-inner :global(.article-image) {
		width: 100%;
		height: 340px;
		object-fit: contain;
		border-radius: 14px;
		margin-bottom: 30px;
	}

	.article-body {
		font-size: 16px;
		color: var(--color-text);
		line-height: 1.75;
	}

	.article-body :global(p) {
		margin: 0 0 20px;
	}

	.article-body :global(h2),
	.article-body :global(h3) {
		font-family: var(--font-heading);
		color: var(--color-navy);
		margin: 32px 0 14px;
	}

	.article-body :global(a) {
		color: var(--color-pink);
	}

	@media (max-width: 720px) {
		.news-article {
			padding: 40px 20px 60px;
		}

		.article-inner :global(.article-image) {
			height: 220px;
		}
	}
</style>
