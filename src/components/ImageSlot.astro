---
interface Props {
	/** Caption shown in the empty state, describing what image belongs here. */
	label: string;
	/** 'rect' | 'rounded' | 'circle' */
	shape?: 'rect' | 'rounded' | 'circle';
	class?: string;
}

const { label, shape = 'rect', class: className } = Astro.props;
---

<div class:list={['image-slot', `shape-${shape}`, className]} role="img" aria-label={label}>
	<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
		<rect x="3" y="3" width="18" height="18" rx="2"></rect>
		<circle cx="9" cy="9" r="2"></circle>
		<path d="m21 15-5-5L5 21"></path>
	</svg>
	<span class="image-slot-caption">{label}</span>
</div>

<style>
	.image-slot {
		position: relative;
		overflow: hidden;
		background: rgba(11, 37, 69, 0.06);
		color: #9aa3b2;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 8px;
		text-align: center;
		padding: 16px;
	}

	.image-slot::after {
		content: '';
		position: absolute;
		inset: 0;
		border: 1.5px dashed currentColor;
		opacity: 0.3;
		pointer-events: none;
	}

	.image-slot-caption {
		font-size: 12px;
		line-height: 1.4;
		max-width: 220px;
	}

	.shape-rounded {
		border-radius: var(--shape-large);
	}

	.shape-circle {
		border-radius: 50%;
	}
</style>
