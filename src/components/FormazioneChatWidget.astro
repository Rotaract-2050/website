---
import { uiStrings, type Lang } from '../data/ui-strings';

interface ChatSettings {
	title?: string | null;
	greeting?: string | null;
	autoOpen?: boolean | null;
}

interface Props {
	lang: Lang;
	/** Editor overrides from Tina (`settings.chatAssistant`) — falls back to the hardcoded defaults in `uiStrings` when empty. */
	chatSettings?: ChatSettings | null;
}

const { lang, chatSettings } = Astro.props;
const t = uiStrings[lang];
const title = chatSettings?.title?.trim() || t.chat.title;
const greeting = chatSettings?.greeting?.trim() || t.chat.greeting;
const autoOpen = chatSettings?.autoOpen ?? false;

// Public Turnstile sitekey — safe to expose client-side, mirrors the widget "formazione-chat"
// created for this endpoint (see src/lib/formazione-chat.ts TURNSTILE_ACTION for the matching
// server-side action check).
const TURNSTILE_SITEKEY = '0x4AAAAAAERu2A-bW7ooqBy6';
---

<div
	class="chat-widget"
	data-chat-widget
	data-lang={lang}
	data-sitekey={TURNSTILE_SITEKEY}
	data-chat-strings={JSON.stringify(t.chat)}
	data-auto-open={autoOpen ? '1' : '0'}
>
	<button type="button" class="chat-fab" data-chat-toggle aria-label={t.chat.fabLabel} aria-expanded="false">
		<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
		</svg>
	</button>

	<section class="chat-panel" data-chat-panel hidden aria-label={title}>
		<div class="chat-resize-handle" data-chat-resize aria-hidden="true">
			<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
				<path d="M4 20 20 4"></path>
				<path d="M11 20 20 11"></path>
			</svg>
		</div>
		<header class="chat-header">
			<span class="chat-title">{title}</span>
			<button type="button" class="chat-close" data-chat-close aria-label={t.chat.closeLabel}>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M18 6 6 18"></path>
					<path d="m6 6 12 12"></path>
				</svg>
			</button>
		</header>

		<p class="chat-disclaimer">{t.chat.disclaimer}</p>

		<div class="chat-log" role="log" aria-live="polite" data-chat-log>
			<div class="chat-message assistant">
				<p>{greeting}</p>
			</div>
		</div>

		<div class="chat-turnstile" data-chat-turnstile></div>

		<form class="chat-form" data-chat-form>
			<textarea class="chat-input" data-chat-input placeholder={t.chat.placeholder} maxlength="500" rows="1" required></textarea>
			<button type="submit" class="chat-send" data-chat-send aria-label={t.chat.sendLabel}>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="m22 2-7 20-4-9-9-4Z"></path>
					<path d="M22 2 11 13"></path>
				</svg>
			</button>
		</form>
	</section>
</div>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer is:inline></script>

<style>
	.chat-widget {
		position: fixed;
		right: 20px;
		bottom: 20px;
		z-index: 45;
	}

	.chat-fab {
		width: 56px;
		height: 56px;
		border-radius: var(--shape-full);
		background: var(--color-pink);
		color: #fff;
		border: none;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		box-shadow: var(--elevation-3);
		transition: box-shadow var(--motion-duration-short) var(--motion-easing-standard), transform var(--motion-duration-short) var(--motion-easing-standard);
	}

	.chat-fab:hover {
		box-shadow: var(--elevation-4);
		transform: translateY(-2px);
	}

	.chat-panel {
		position: absolute;
		right: 0;
		bottom: 72px;
		width: 360px;
		height: 480px;
		min-width: 300px;
		min-height: 340px;
		max-width: calc(100vw - 40px);
		max-height: min(80vh, 800px);
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: var(--shape-large);
		box-shadow: var(--elevation-4);
		flex-direction: column;
		overflow: hidden;
	}

	/* An author-stylesheet `display` rule always beats the browser's built-in
	   `[hidden] { display: none }` UA rule, regardless of specificity — so `display: flex` can't
	   live on the bare `.chat-panel` selector above or toggling the `hidden` attribute in JS would
	   never actually hide it. Scoping it to `:not([hidden])` keeps `hidden` in control. */
	.chat-panel:not([hidden]) {
		display: flex;
	}

	/* Native CSS `resize` only ever draws its handle at the bottom-right corner, not configurable —
	   but this panel is anchored bottom-right (`right`/`bottom` above), so growing it should read as
	   "drag the top-left corner outward", the opposite corner from where native resize would put its
	   handle. Custom handle + pointer-drag JS below instead of `resize: both`. */
	.chat-resize-handle {
		position: absolute;
		top: 4px;
		left: 4px;
		width: 20px;
		height: 20px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: rgba(255, 255, 255, 0.6);
		cursor: nwse-resize;
		touch-action: none;
		z-index: 1;
	}

	.chat-resize-handle:hover {
		color: #fff;
	}

	.chat-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 14px 16px;
		background: var(--color-navy);
		color: #fff;
		flex-shrink: 0;
	}

	.chat-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 15px;
	}

	.chat-close {
		background: transparent;
		border: none;
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		padding: 2px;
		opacity: 0.85;
	}

	.chat-close:hover {
		opacity: 1;
	}

	.chat-disclaimer {
		font-size: 11px;
		color: var(--color-muted);
		padding: 10px 16px 0;
		margin: 0;
		flex-shrink: 0;
	}

	.chat-log {
		flex: 1;
		overflow-y: auto;
		padding: 14px 16px;
		display: flex;
		flex-direction: column;
		gap: 10px;
		min-height: 160px;
	}

	.chat-message {
		max-width: 85%;
		padding: 10px 14px;
		border-radius: var(--shape-medium);
		font-size: 14px;
		line-height: 1.5;
	}

	.chat-message p,
	.chat-message ul,
	.chat-message ol {
		margin: 0;
	}

	.chat-message p + p,
	.chat-message p + ul,
	.chat-message p + ol,
	.chat-message ul + p,
	.chat-message ol + p {
		margin-top: 8px;
	}

	.chat-message ul,
	.chat-message ol {
		padding-left: 20px;
	}

	.chat-message li + li {
		margin-top: 4px;
	}

	.chat-message strong {
		font-weight: 700;
	}

	.chat-message.assistant {
		align-self: flex-start;
		background: var(--color-bg);
		color: var(--color-text);
		border: 1px solid var(--color-border);
	}

	.chat-message.user {
		align-self: flex-end;
		background: var(--color-pink);
		color: #fff;
	}

	.chat-message.error {
		align-self: flex-start;
		background: var(--color-pink-container, #fae3ed);
		color: var(--color-pink-dark);
		border: 1px solid var(--color-pink);
	}

	.chat-message.pending {
		align-self: flex-start;
		background: var(--color-bg);
		color: var(--color-muted);
		border: 1px solid var(--color-border);
		font-style: italic;
	}

	.chat-turnstile {
		flex-shrink: 0;
	}

	.chat-form {
		display: flex;
		align-items: flex-end;
		gap: 8px;
		padding: 12px 16px;
		border-top: 1px solid var(--color-border);
		flex-shrink: 0;
	}

	.chat-input {
		flex: 1;
		resize: none;
		border: 1px solid var(--color-border);
		border-radius: var(--shape-medium);
		padding: 10px 12px;
		font-family: inherit;
		font-size: 14px;
		color: var(--color-text);
		max-height: 90px;
	}

	.chat-input:focus {
		outline: 2px solid var(--color-royal-blue);
		outline-offset: 1px;
	}

	.chat-send {
		width: 40px;
		height: 40px;
		flex-shrink: 0;
		border-radius: var(--shape-full);
		background: var(--color-pink);
		color: #fff;
		border: none;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: opacity var(--motion-duration-short) var(--motion-easing-standard);
	}

	.chat-send:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}

	@media (max-width: 480px) {
		.chat-widget {
			right: 12px;
			bottom: 12px;
		}

		.chat-panel {
			width: calc(100vw - 24px);
			right: -8px;
		}

		/* A drag handle is impractical on touch and a resized width could exceed the viewport here,
		   so mobile stays fixed full-width instead. */
		.chat-resize-handle {
			display: none;
		}
	}
</style>

<script>
	interface TurnstileApi {
		render: (container: HTMLElement, options: Record<string, unknown>) => string;
		execute: (widgetId: string) => void;
		reset: (widgetId: string) => void;
	}
	declare global {
		interface Window {
			turnstile?: TurnstileApi;
		}
	}

	interface ChatStrings {
		errorGeneric: string;
		errorQuota: string;
		errorNotConfigured: string;
		errorEmptyCorpus: string;
		errorTurnstile: string;
		errorInvalidInput: string;
	}

	// Mirrors src/lib/formazione-chat.ts MAX_MESSAGES/MAX_MESSAGE_LENGTH — duplicated here so this
	// client bundle stays free of server-only code, the server re-enforces both caps regardless.
	const MAX_MESSAGES = 6;
	const MAX_MESSAGE_LENGTH = 500;
	const TURNSTILE_ACTION = 'formazione-chat';
	const MIN_SEND_INTERVAL_MS = 3000;

	document.querySelectorAll<HTMLElement>('[data-chat-widget]').forEach((widget) => {
		const lang = widget.dataset.lang === 'en' ? 'en' : 'it';
		const sitekey = widget.dataset.sitekey ?? '';
		// A `<script type="application/json">` child was tried first, but `<script>` is an HTML5
		// "raw text" element — entities like `&quot;` never get decoded inside it, so an
		// HTML-escaped JSON payload there parses as garbage. Attribute values don't have that
		// problem (they go through normal HTML attribute decoding), so the strings live here instead.
		const strings: ChatStrings = JSON.parse(widget.dataset.chatStrings ?? '{}');

		const toggle = widget.querySelector<HTMLButtonElement>('[data-chat-toggle]');
		const closeBtn = widget.querySelector<HTMLButtonElement>('[data-chat-close]');
		const panel = widget.querySelector<HTMLElement>('[data-chat-panel]');
		const log = widget.querySelector<HTMLElement>('[data-chat-log]');
		const form = widget.querySelector<HTMLFormElement>('[data-chat-form]');
		const input = widget.querySelector<HTMLTextAreaElement>('[data-chat-input]');
		const sendBtn = widget.querySelector<HTMLButtonElement>('[data-chat-send]');
		const turnstileContainer = widget.querySelector<HTMLElement>('[data-chat-turnstile]');
		if (!toggle || !panel || !log || !form || !input || !sendBtn || !turnstileContainer) return;

		// Custom top-left resize handle (see the CSS comment on .chat-resize-handle for why native
		// `resize` doesn't work here): the panel is anchored bottom-right, so dragging the handle
		// left/up should grow it, not shrink it — the opposite sign from a normal top-left-anchored
		// resize. Optional element, absent/failed lookup just means no resize, not a broken widget.
		const resizeHandle = widget.querySelector<HTMLElement>('[data-chat-resize]');
		if (resizeHandle) {
			let resizing = false;
			let startX = 0;
			let startY = 0;
			let startWidth = 0;
			let startHeight = 0;

			const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);

			resizeHandle.addEventListener('pointerdown', (event) => {
				resizing = true;
				startX = event.clientX;
				startY = event.clientY;
				const rect = panel.getBoundingClientRect();
				startWidth = rect.width;
				startHeight = rect.height;
				resizeHandle.setPointerCapture(event.pointerId);
				event.preventDefault();
			});

			resizeHandle.addEventListener('pointermove', (event) => {
				if (!resizing) return;
				const style = getComputedStyle(panel);
				const minWidth = parseFloat(style.minWidth) || 0;
				const maxWidth = parseFloat(style.maxWidth) || Infinity;
				const minHeight = parseFloat(style.minHeight) || 0;
				const maxHeight = parseFloat(style.maxHeight) || Infinity;
				const nextWidth = clamp(startWidth + (startX - event.clientX), minWidth, maxWidth);
				const nextHeight = clamp(startHeight + (startY - event.clientY), minHeight, maxHeight);
				panel.style.width = `${nextWidth}px`;
				panel.style.height = `${nextHeight}px`;
			});

			const endResize = (event: PointerEvent) => {
				if (!resizing) return;
				resizing = false;
				try {
					resizeHandle.releasePointerCapture(event.pointerId);
				} catch {
					/* no-op: capture may already be released */
				}
			};
			resizeHandle.addEventListener('pointerup', endResize);
			resizeHandle.addEventListener('pointercancel', endResize);
		}

		// This is a multi-page site (full navigation between /formazione and each resource, no
		// client-side router), so without this the widget would reset to empty on every page —
		// sessionStorage survives navigation within the tab but clears on tab close, a reasonable
		// middle ground between "gone on every click" and "stale forever" (localStorage). Scoped by
		// lang so switching IT/EN doesn't mix conversations in different languages.
		const STORAGE_HISTORY_KEY = `formazione-chat-history-${lang}`;
		const STORAGE_OPEN_KEY = `formazione-chat-open-${lang}`;

		function loadHistory(): { role: 'user' | 'model'; text: string }[] {
			try {
				const raw = sessionStorage.getItem(STORAGE_HISTORY_KEY);
				if (!raw) return [];
				const parsed = JSON.parse(raw);
				if (!Array.isArray(parsed)) return [];
				return parsed
					.filter(
						(m): m is { role: 'user' | 'model'; text: string } =>
							!!m && (m.role === 'user' || m.role === 'model') && typeof m.text === 'string',
					)
					.slice(-MAX_MESSAGES);
			} catch {
				return [];
			}
		}

		function saveHistory() {
			try {
				sessionStorage.setItem(STORAGE_HISTORY_KEY, JSON.stringify(history));
			} catch {
				/* no-op: sessionStorage can throw (private browsing, storage disabled) — history
				   just won't survive navigation in that context, same degrade-gracefully pattern
				   as CookieConsent.astro's localStorage use. */
			}
		}

		function saveOpenState(isOpen: boolean) {
			try {
				sessionStorage.setItem(STORAGE_OPEN_KEY, isOpen ? '1' : '0');
			} catch {
				/* no-op */
			}
		}

		const history: { role: 'user' | 'model'; text: string }[] = [];
		let widgetId: string | null = null;
		let pendingResolve: ((token: string | null) => void) | null = null;
		let lastSendAt = 0;

		function openPanel() {
			panel!.hidden = false;
			toggle!.setAttribute('aria-expanded', 'true');
			input!.focus();
			saveOpenState(true);
		}

		function closePanel() {
			panel!.hidden = true;
			toggle!.setAttribute('aria-expanded', 'false');
			saveOpenState(false);
		}

		toggle.addEventListener('click', () => (panel.hidden ? openPanel() : closePanel()));
		closeBtn?.addEventListener('click', closePanel);
		widget.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closePanel();
		});

		// Deliberately restricted Markdown-to-DOM renderer for the assistant's replies only — the
		// system prompt asks the model for this exact subset (bold/italic/lists/paragraphs, no
		// headings/tables/code/links). Every node here is built via createElement/textContent, never
		// innerHTML or set:html, so there is no HTML-injection surface no matter what text the model
		// actually returns: unsupported syntax (or a literal `<script>`, or anything else) just shows
		// up as its own escaped text instead of being parsed as markup.
		function renderInlineMarkdown(parent: HTMLElement, text: string) {
			const pattern = /\*\*(.+?)\*\*|\*(.+?)\*|_(.+?)_/g;
			let lastIndex = 0;
			let match: RegExpExecArray | null;
			while ((match = pattern.exec(text)) !== null) {
				if (match.index > lastIndex) parent.appendChild(document.createTextNode(text.slice(lastIndex, match.index)));
				const el = document.createElement(match[1] !== undefined ? 'strong' : 'em');
				el.textContent = match[1] ?? match[2] ?? match[3] ?? '';
				parent.appendChild(el);
				lastIndex = pattern.lastIndex;
			}
			if (lastIndex < text.length) parent.appendChild(document.createTextNode(text.slice(lastIndex)));
		}

		function renderMarkdown(container: HTMLElement, text: string) {
			const blocks = text
				.split(/\n{2,}/)
				.map((block) => block.trim())
				.filter(Boolean);

			for (const block of blocks.length > 0 ? blocks : [text]) {
				const lines = block
					.split('\n')
					.map((line) => line.trim())
					.filter(Boolean);
				const isBulletList = lines.length > 0 && lines.every((line) => /^[-*]\s+/.test(line));
				const isNumberedList = lines.length > 0 && lines.every((line) => /^\d+[.)]\s+/.test(line));

				if (isBulletList || isNumberedList) {
					const list = document.createElement(isBulletList ? 'ul' : 'ol');
					for (const line of lines) {
						const li = document.createElement('li');
						renderInlineMarkdown(li, line.replace(/^([-*]|\d+[.)])\s+/, ''));
						list.appendChild(li);
					}
					container.appendChild(list);
				} else {
					const p = document.createElement('p');
					lines.forEach((line, i) => {
						if (i > 0) p.appendChild(document.createElement('br'));
						renderInlineMarkdown(p, line);
					});
					container.appendChild(p);
				}
			}
		}

		function appendMessage(role: 'user' | 'assistant' | 'error' | 'pending', text: string): HTMLElement {
			const bubble = document.createElement('div');
			bubble.className = `chat-message ${role}`;
			if (role === 'assistant') {
				renderMarkdown(bubble, text);
			} else {
				// User/error/pending text is never model-instructed to use markdown (and user input
				// specifically shouldn't be re-interpreted as formatting), so it stays plain paragraphs.
				const paragraphs = text.split(/\n{2,}/).filter((part) => part.trim().length > 0);
				for (const part of paragraphs.length > 0 ? paragraphs : [text]) {
					const p = document.createElement('p');
					p.textContent = part;
					bubble.appendChild(p);
				}
			}
			log!.appendChild(bubble);
			log!.scrollTop = log!.scrollHeight;
			return bubble;
		}

		// Restore conversation + open/closed state from the previous page, appended after the
		// static greeting already in the markup rather than replacing it.
		for (const message of loadHistory()) {
			history.push(message);
			appendMessage(message.role === 'user' ? 'user' : 'assistant', message.text);
		}
		try {
			const storedOpen = sessionStorage.getItem(STORAGE_OPEN_KEY);
			// Auto-open (Tina `settings.chatAssistant.autoOpen`) only applies the first time this
			// session sees the widget (no stored state yet) — once the visitor has explicitly opened
			// or closed it, that choice wins on every later page for the rest of the session.
			const shouldOpen = storedOpen !== null ? storedOpen === '1' : widget.dataset.autoOpen === '1';
			if (shouldOpen) {
				// Restore visibility without stealing focus on every page load the way openPanel() does.
				panel.hidden = false;
				toggle.setAttribute('aria-expanded', 'true');
			}
		} catch {
			/* no-op */
		}

		function ensureTurnstile(): Promise<string> {
			return new Promise((resolve, reject) => {
				if (widgetId !== null) {
					resolve(widgetId);
					return;
				}
				const tryRender = () => {
					if (window.turnstile) {
						widgetId = window.turnstile.render(turnstileContainer!, {
							sitekey,
							action: TURNSTILE_ACTION,
							execution: 'execute',
							appearance: 'interaction-only',
							callback: (token: string) => {
								if (pendingResolve) {
									pendingResolve(token);
									pendingResolve = null;
								}
							},
							'error-callback': () => {
								if (pendingResolve) {
									pendingResolve(null);
									pendingResolve = null;
								}
							},
						});
						resolve(widgetId);
					} else {
						setTimeout(tryRender, 150);
					}
				};
				tryRender();
				setTimeout(() => reject(new Error('turnstile-load-timeout')), 15000);
			});
		}

		async function getTurnstileToken(): Promise<string | null> {
			try {
				const id = await ensureTurnstile();
				return await new Promise((resolve) => {
					pendingResolve = resolve;
					window.turnstile!.execute(id);
				});
			} catch {
				return null;
			}
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const question = input.value.trim().slice(0, MAX_MESSAGE_LENGTH);
			if (!question) return;

			const now = Date.now();
			if (now - lastSendAt < MIN_SEND_INTERVAL_MS) return;
			lastSendAt = now;

			input.value = '';
			sendBtn.disabled = true;
			input.disabled = true;

			appendMessage('user', question);
			history.push({ role: 'user', text: question });
			while (history.length > MAX_MESSAGES) history.shift();
			saveHistory();

			const pendingBubble = appendMessage('pending', '…');

			const token = await getTurnstileToken();

			if (!token) {
				if (widgetId !== null) window.turnstile?.reset(widgetId);
				pendingBubble.remove();
				appendMessage('error', strings.errorTurnstile);
				sendBtn.disabled = false;
				input.disabled = false;
				input.focus();
				return;
			}

			try {
				const response = await fetch('/api/formazione-chat', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ messages: history, lang, turnstileToken: token }),
				});
				const data = (await response.json().catch(() => ({}))) as { answer?: string; error?: string };
				pendingBubble.remove();

				if (response.ok && data.answer) {
					appendMessage('assistant', data.answer);
					history.push({ role: 'model', text: data.answer });
					while (history.length > MAX_MESSAGES) history.shift();
					saveHistory();
				} else {
					appendMessage('error', data.error || strings.errorGeneric);
				}
			} catch {
				pendingBubble.remove();
				appendMessage('error', strings.errorGeneric);
			} finally {
				// Reset only after the request has actually completed (success or failure) — per
				// Cloudflare's own guidance, resetting a widget right after obtaining a token but
				// before the request that consumes it finishes can corrupt the widget's internal
				// state for the *next* execute() call (observed live as Turnstile error 600010 on
				// a second message in the same session).
				if (widgetId !== null) window.turnstile?.reset(widgetId);
				sendBtn.disabled = false;
				input.disabled = false;
				input.focus();
			}
		});

		input.addEventListener('keydown', (event) => {
			if (event.key === 'Enter' && !event.shiftKey) {
				event.preventDefault();
				form.requestSubmit();
			}
		});
	});
</script>
