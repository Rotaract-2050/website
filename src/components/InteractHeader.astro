---
// Deliberately NOT a parametrized Header.astro (606 lines, tightly coupled to Rotaract's own
// PageKey/nav structure and decorative elements with no Interact equivalent, e.g. the
// .formazione-btn rainbow gradient) — see the Interact implementation plan. Reuses what IS
// site-wide/generic: SOCIAL_LINKS, UTILITY_LINKS, the lang switch, the mobile menu-toggle script.
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../data/ui-strings';
import { uiStrings, SOCIAL_LINKS, UTILITY_LINKS } from '../data/ui-strings';
import { pageSlugs, type PageKey } from '../data/routes';
import SocialIcon from './SocialIcon.astro';

interface Props {
	lang: Lang;
	current: PageKey;
}

const { lang, current } = Astro.props;
const t = uiStrings[lang];
const ti = t.interact;

const href = (page: PageKey) => getRelativeLocaleUrl(lang, pageSlugs[page]);
const otherLang: Lang = lang === 'it' ? 'en' : 'it';
const langSwitchHref = getRelativeLocaleUrl(otherLang, pageSlugs[current]);
const rotaractHomeHref = getRelativeLocaleUrl(lang, '');
---

<div class="utility-bar">
	<div class="utility-links">
		{UTILITY_LINKS.map((link) => (
			<a href={link.href} target="_blank" rel="noopener" data-track="utility_link_click" data-track-params={JSON.stringify({ link_label: link.label })}>
				{link.label}
			</a>
		))}
	</div>
	<div class="utility-right">
		<div class="lang-switch">
			{lang === 'it'
				? <span class="lang-btn active" aria-current="true">IT</span>
				: (
					<a href={langSwitchHref} class="lang-btn" hreflang="it" data-track="lang_switch_click" data-track-params={JSON.stringify({ to_lang: 'it' })}>
						IT
					</a>
				)}
			{lang === 'en'
				? <span class="lang-btn active" aria-current="true">EN</span>
				: (
					<a href={langSwitchHref} class="lang-btn" hreflang="en" data-track="lang_switch_click" data-track-params={JSON.stringify({ to_lang: 'en' })}>
						EN
					</a>
				)}
		</div>
		<div class="divider" aria-hidden="true"></div>
		<div class="social-icons">
			{SOCIAL_LINKS.map((soc) => (
				<a
					href={soc.href}
					target="_blank"
					rel="noopener"
					class="social-icon"
					aria-label={soc.label}
					data-track="social_link_click"
					data-track-params={JSON.stringify({ network: soc.name })}
				>
					<SocialIcon name={soc.name} />
				</a>
			))}
		</div>
	</div>
</div>

<header class="main-nav">
	<a href={href('interactHome')} class="brand">
		{/* Wordmark placeholder — swap for the official Interact logo (Rotary Brand Center) once
		    supplied; keep the link/markup shape, only the visual mark changes. */}
		<span class="brand-mark">INTERACT</span>
		<span class="brand-sub">Distretto 2050</span>
	</a>

	<button
		type="button"
		class="menu-toggle"
		aria-expanded="false"
		aria-controls="primary-nav"
		aria-label={t.nav.menuOpen}
		data-menu-toggle
		data-label-open={t.nav.menuOpen}
		data-label-close={t.nav.menuClose}
	>
		<span class="menu-toggle-bar" aria-hidden="true"></span>
		<span class="menu-toggle-bar" aria-hidden="true"></span>
		<span class="menu-toggle-bar" aria-hidden="true"></span>
	</button>

	<nav class="nav-links" id="primary-nav" aria-label="Interact">
		<a href={href('interactHome')} class:list={['nav-link', { active: current === 'interactHome' }]}>{ti.navHome}</a>
		<a href={href('interactStoria')} class:list={['nav-link', { active: current === 'interactStoria' }]}>{ti.navStoria}</a>
		<a href={href('interactClub')} class:list={['nav-link', { active: current === 'interactClub' }]}>{ti.navClub}</a>
		<a href={href('interactAlbo')} class:list={['nav-link', { active: current === 'interactAlbo' }]}>{ti.navAlbo}</a>
		<a href={href('interactEventi')} class:list={['nav-link', { active: current === 'interactEventi' }]}>{ti.navEventi}</a>
		<a href={rotaractHomeHref} class="back-pill">{ti.backToRotaract}</a>
	</nav>
</header>

<style>
	.utility-bar {
		background: var(--color-navy);
		padding: 8px 40px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px;
	}

	.utility-links {
		display: flex;
		gap: 20px;
		flex-wrap: wrap;
	}

	.utility-links a {
		color: #b9d9eb;
		font-size: 12px;
		letter-spacing: 0.4px;
		text-transform: uppercase;
		font-weight: 500;
	}

	.utility-links a:hover {
		color: #fff;
	}

	.utility-right {
		display: flex;
		gap: 16px;
		align-items: center;
	}

	.lang-switch {
		display: flex;
		gap: 6px;
	}

	.lang-btn {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.5px;
		padding: 2px 6px;
		color: rgba(255, 255, 255, 0.55);
	}

	.lang-btn.active {
		color: var(--color-gold);
	}

	a.lang-btn:hover {
		color: #fff;
	}

	.divider {
		width: 1px;
		height: 14px;
		background: rgba(255, 255, 255, 0.2);
	}

	.social-icons {
		display: flex;
		gap: 8px;
	}

	.social-icon {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.12);
		color: #fff;
		padding: 5px;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.social-icon:hover {
		background: rgba(255, 255, 255, 0.22);
		color: #fff;
	}

	.main-nav {
		background: #fff;
		padding: 14px 40px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 16px;
		box-shadow: var(--elevation-1);
		position: sticky;
		top: 0;
		z-index: 50;
	}

	.brand {
		display: flex;
		flex-direction: column;
		line-height: 1.1;
	}

	.brand-mark {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 24px;
		letter-spacing: 0.5px;
		color: var(--color-pink);
	}

	.brand-sub {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 12px;
		letter-spacing: 0.5px;
		color: var(--color-navy);
	}

	.menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 5px;
		width: 40px;
		height: 40px;
		padding: 0;
		border: none;
		background: transparent;
		flex-shrink: 0;
	}

	.menu-toggle-bar {
		width: 24px;
		height: 2px;
		border-radius: 2px;
		background: var(--color-navy);
		transition: transform var(--motion-duration-short) var(--motion-easing-standard), opacity var(--motion-duration-short) var(--motion-easing-standard);
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle-bar:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle-bar:nth-child(2) {
		opacity: 0;
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle-bar:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 26px;
		flex-wrap: wrap;
	}

	.nav-link {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 15px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		color: var(--color-navy);
		padding: 8px 2px;
		border-bottom: 3px solid transparent;
	}

	.nav-link:hover {
		color: var(--color-pink);
	}

	.nav-link.active {
		color: var(--color-pink);
		border-bottom-color: var(--color-pink);
	}

	/* Not present on the Rotaract header — makes the "second home, one click back" framing
	   legible in the UI itself, not just implied by the URL. */
	.back-pill {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 12px;
		letter-spacing: 0.3px;
		color: var(--color-navy);
		padding: 8px 16px;
		border-radius: var(--shape-full);
		border: 2px solid var(--color-border);
	}

	.back-pill:hover {
		background: var(--color-bg);
		border-color: var(--color-navy);
	}

	@media (max-width: 860px) {
		.main-nav {
			padding: 14px 20px;
		}

		.utility-bar {
			padding: 8px 20px;
		}

		.brand-mark {
			font-size: 20px;
		}

		.menu-toggle {
			display: flex;
		}

		.nav-links {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 4px;
			background: #fff;
			padding: 8px 20px 24px;
			box-shadow: var(--elevation-3);
			max-height: calc(100vh - 100%);
			overflow-y: auto;
		}

		.nav-links[data-open] {
			display: flex;
		}

		.nav-link {
			padding: 12px 4px;
			border-bottom: 1px solid var(--color-bg);
		}

		.back-pill {
			text-align: center;
			margin-top: 8px;
		}
	}
</style>

<script>
	function initMenu(header: Element) {
		const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
		const panel = header.querySelector<HTMLElement>('#primary-nav');
		if (!toggle || !panel) return;

		const openLabel = toggle.dataset.labelOpen ?? '';
		const closeLabel = toggle.dataset.labelClose ?? '';

		function setOpen(open: boolean) {
			toggle!.setAttribute('aria-expanded', String(open));
			toggle!.setAttribute('aria-label', open ? closeLabel : openLabel);
			panel!.toggleAttribute('data-open', open);
		}

		toggle.addEventListener('click', () => {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		panel.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) setOpen(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
				setOpen(false);
				toggle.focus();
			}
		});

		const desktopQuery = window.matchMedia('(min-width: 861px)');
		desktopQuery.addEventListener('change', (event) => {
			if (event.matches) setOpen(false);
		});
	}

	document.querySelectorAll('.main-nav').forEach(initMenu);
</script>
