---
import { tinaField } from '@tinacms/astro';
import type { PagesQuery } from '../../tina/__generated__/types';
import type { Lang } from '../data/ui-strings';
import Hero from './blocks/Hero.astro';
import PhotoCarousel from './blocks/PhotoCarousel.astro';
import StatsBar from './blocks/StatsBar.astro';
import SplitSection from './blocks/SplitSection.astro';
import CardGrid from './blocks/CardGrid.astro';
import ValuesGrid from './blocks/ValuesGrid.astro';
import RoleGrid from './blocks/RoleGrid.astro';
import CommitteeGrid from './blocks/CommitteeGrid.astro';
import EventsCalendar from './blocks/EventsCalendar.astro';
import NewsTicker from './blocks/NewsTicker.astro';
import NewsGrid from './blocks/NewsGrid.astro';
import CtaBanner from './blocks/CtaBanner.astro';
import PagePlaceholder from './blocks/PagePlaceholder.astro';
import LegalText from './blocks/LegalText.astro';
import { renderTinaMarkdown } from '../lib/tina-rich-text';
import ClubDirectory from './blocks/ClubDirectory.astro';
import RrdTimeline from './blocks/RrdTimeline.astro';
import EventsArchive from './blocks/EventsArchive.astro';
import NewsArchive from './blocks/NewsArchive.astro';
import MaterialsGrid from './blocks/MaterialsGrid.astro';
import ResourceArchive from './blocks/ResourceArchive.astro';
import InteractClubDirectory from './blocks/InteractClubDirectory.astro';
import InteractEventsCalendar from './blocks/InteractEventsCalendar.astro';
import InteractEventsArchive from './blocks/InteractEventsArchive.astro';

function nonNull<T>(value: T | null | undefined): value is T {
	return value != null;
}

type PersonClubRef = { name: string; zone?: { color?: string | null } | null; _sys?: { filename?: string | null } | null } | null | undefined;

/** A person's club tag: the referenced Rotaract Club (colored by its zone, linking to its page), or the free-text fallback for Rotary/Interact clubs not in the `clubs` collection. */
function personClub(club: PersonClubRef) {
	return club ? { name: club.name, zoneColor: club.zone?.color ?? null, slug: club._sys?.filename ?? null } : null;
}

type Block = NonNullable<NonNullable<PagesQuery['pages']['blocks']>[number]>;

interface Props {
	lang: Lang;
	block: Block;
}

const { lang, block } = Astro.props;

// Pages are a single file (IT + EN fields together, like clubs.story/storyEn) — every text field
// below picks the EN value when present, falling back to IT, same as ClubDetail.astro's
// story/storyEn ternary and news.ts's localizeNews().
const isEn = lang === 'en';
/** EN value if present, else IT — the standard per-field fallback used throughout this file. */
function loc(itValue: string | null | undefined, enValue: string | null | undefined): string {
	return ((isEn && enValue) || itValue || '') as string;
}
---

<div
	data-tina-field={tinaField(block)}
	data-reveal={[
		'PagesBlocksHero',
		'PagesBlocksRrdTimeline',
		'PagesBlocksInteractDirTimeline',
		'PagesBlocksStatsBar',
		'PagesBlocksSplitSection',
		'PagesBlocksCardGrid',
		'PagesBlocksNewsGrid',
		'PagesBlocksEventsCalendar',
	].includes(block.__typename) ? undefined : true}
>
	{block.__typename === 'PagesBlocksHero' && (
		<Hero
			lang={lang}
			ctaHref={block.ctaHref ?? ''}
			autoplay={block.autoplay ?? true}
			slides={(block.slides ?? []).filter(nonNull).map((s) => ({
				eyebrow: loc(s.eyebrow, s.eyebrowEn),
				title: loc(s.title, s.titleEn),
				subtitle: loc(s.subtitle, s.subtitleEn),
				ctaLabel: loc(s.ctaLabel, s.ctaLabelEn),
				image: s.image ?? undefined,
				imageFocalX: s.imageFocalX ?? undefined,
				imageFocalY: s.imageFocalY ?? undefined,
				tinaFieldAttr: tinaField(s),
			}))}
		/>
	)}
	{block.__typename === 'PagesBlocksPhotoCarousel' && (
		<PhotoCarousel
			autoplay={block.autoplay ?? true}
			slides={(block.images ?? []).filter(nonNull).map((s) => ({
				image: s.image ?? undefined,
				imageFocalX: s.imageFocalX ?? undefined,
				imageFocalY: s.imageFocalY ?? undefined,
				label: loc(s.label, s.labelEn),
				tinaFieldAttr: tinaField(s),
			}))}
		/>
	)}
	{block.__typename === 'PagesBlocksStatsBar' && (
		<StatsBar
			items={(block.items ?? []).filter(nonNull).map((i) => ({
				value: i.value ?? '',
				label: loc(i.label, i.labelEn),
				tinaFieldAttr: tinaField(i),
			}))}
		/>
	)}
	{block.__typename === 'PagesBlocksSplitSection' && (
		<SplitSection
			lang={lang}
			kicker={loc(block.kicker, block.kickerEn) || undefined}
			title={loc(block.title, block.titleEn)}
			quote={loc(block.quote, block.quoteEn) || undefined}
			body={loc(block.body, block.bodyEn)}
			subhead={loc(block.subhead, block.subheadEn) || undefined}
			quote2={loc(block.quote2, block.quote2En) || undefined}
			body2={loc(block.body2, block.body2En) || undefined}
			ctaLabel={loc(block.ctaLabel, block.ctaLabelEn) || undefined}
			ctaHref={block.ctaHref ?? undefined}
			image={block.image ?? undefined}
			imageFocalX={block.imageFocalX ?? undefined}
			imageFocalY={block.imageFocalY ?? undefined}
			imageLabel={loc(block.imageLabel, block.imageLabelEn)}
			imageSide={block.imageSide === 'left' ? 'left' : 'right'}
		/>
	)}
	{block.__typename === 'PagesBlocksCardGrid' && (
		<CardGrid
			lang={lang}
			title={loc(block.title, block.titleEn)}
			items={(block.items ?? []).filter(nonNull).map((i) => ({
				title: loc(i.title, i.titleEn),
				meta: loc(i.meta, i.metaEn),
				href: i.href ?? '',
				color: i.color ?? undefined,
				tinaFieldAttr: tinaField(i),
			}))}
		/>
	)}
	{block.__typename === 'PagesBlocksValuesGrid' && (
		<ValuesGrid
			title={loc(block.title, block.titleEn)}
			intro={loc(block.intro, block.introEn) || undefined}
			accent={block.accent ?? undefined}
			layout={(block.layout as 'badge' | 'path' | 'icon' | 'statement' | null) ?? undefined}
			items={(block.items ?? []).filter(nonNull).map((i) => ({
				letter: i.letter ?? '',
				icon: i.icon ?? undefined,
				title: loc(i.title, i.titleEn),
				description: loc(i.description, i.descriptionEn),
				tinaFieldAttr: tinaField(i),
			}))}
		/>
	)}
	{block.__typename === 'PagesBlocksRoleGrid' && (
		<RoleGrid
			lang={lang}
			title={loc(block.title, block.titleEn)}
			showDisclaimer={block.showDisclaimer ?? false}
			disclaimerText={loc(block.disclaimerText, block.disclaimerTextEn) || undefined}
			highlightFirst={block.highlightFirst ?? false}
			items={(block.items ?? []).filter(nonNull).map((i) => ({
				initials: i.initials ?? undefined,
				photo: i.photo ?? undefined,
				photoFocalX: i.photoFocalX ?? undefined,
				photoFocalY: i.photoFocalY ?? undefined,
				photoZoom: i.photoZoom ?? undefined,
				name: i.name ?? '',
				role: loc(i.role, i.roleEn),
				email: i.email ?? undefined,
				club: personClub(i.club),
				clubCustom: i.clubCustom ?? undefined,
				themeMotto: loc(i.themeMotto, i.themeMottoEn) || undefined,
				themeLogo: i.themeLogo ?? undefined,
				tinaFieldAttr: tinaField(i),
			}))}
		/>
	)}
	{block.__typename === 'PagesBlocksCommitteeGrid' && (
		<CommitteeGrid
			lang={lang}
			title={loc(block.title, block.titleEn)}
			showDisclaimer={block.showDisclaimer ?? false}
			disclaimerText={loc(block.disclaimerText, block.disclaimerTextEn) || undefined}
			items={(block.items ?? []).filter(nonNull).map((i) => ({
				name: loc(i.name, i.nameEn),
				nameFieldAttr: tinaField(i, isEn && i.nameEn ? 'nameEn' : 'name'),
				description: loc(i.description, i.descriptionEn) || undefined,
				descriptionFieldAttr: tinaField(i, isEn && i.descriptionEn ? 'descriptionEn' : 'description'),
				leadLabel: (isEn && i.leadLabelEn) || i.leadLabel || (isEn ? 'President' : 'Presidente'),
				membersLabel: (isEn && i.membersLabelEn) || i.membersLabel || (isEn ? 'Member' : 'Membro'),
				lead: {
					name: i.lead?.name ?? '',
					photo: i.lead?.photo ?? undefined,
					photoFocalX: i.lead?.photoFocalX ?? undefined,
					photoFocalY: i.lead?.photoFocalY ?? undefined,
					photoZoom: i.lead?.photoZoom ?? undefined,
					email: i.lead?.email ?? undefined,
					club: personClub(i.lead?.club),
					clubCustom: i.lead?.clubCustom ?? undefined,
					tinaFieldAttr: i.lead ? tinaField(i.lead) : undefined,
				},
				members: (i.members ?? []).filter(nonNull).map((m) => ({
					name: m.name ?? '',
					photo: m.photo ?? undefined,
					photoFocalX: m.photoFocalX ?? undefined,
					photoFocalY: m.photoFocalY ?? undefined,
					photoZoom: m.photoZoom ?? undefined,
					email: m.email ?? undefined,
					club: personClub(m.club),
					clubCustom: m.clubCustom ?? undefined,
					tinaFieldAttr: tinaField(m),
				})),
			}))}
		/>
	)}
	{block.__typename === 'PagesBlocksEventsCalendar' && (
		<EventsCalendar lang={lang} title={loc(block.title, block.titleEn)} calendarId={block.calendarId ?? undefined} />
	)}
	{block.__typename === 'PagesBlocksNewsTicker' && (
		<NewsTicker
			lang={lang}
			label={loc(block.label, block.labelEn)}
			feedUrl={block.feedUrl || 'https://www.rotary.org/rss.xml'}
			limit={block.limit ?? 12}
		/>
	)}
	{block.__typename === 'PagesBlocksNewsGrid' && (
		<NewsGrid lang={lang} title={loc(block.title, block.titleEn)} limit={block.limit ?? undefined} showDate={block.showDate ?? undefined} showYear={block.showYear ?? undefined} />
	)}
	{block.__typename === 'PagesBlocksCtaBanner' && (
		<CtaBanner
			lang={lang}
			title={loc(block.title, block.titleEn)}
			body={loc(block.body, block.bodyEn)}
			buttonLabel={loc(block.buttonLabel, block.buttonLabelEn)}
			buttonHref={block.buttonHref ?? ''}
			accent={block.accent}
		/>
	)}
	{block.__typename === 'PagesBlocksPagePlaceholder' && <PagePlaceholder message={loc(block.message, block.messageEn)} />}
	{block.__typename === 'PagesBlocksLegalText' && (
		<LegalText bodyHtml={renderTinaMarkdown(isEn && block.contentEn ? block.contentEn : block.content)} />
	)}
	{block.__typename === 'PagesBlocksClubDirectory' && (
		<ClubDirectory lang={lang} intro={loc(block.intro, block.introEn)} disclaimer={loc(block.disclaimer, block.disclaimerEn)} />
	)}
	{block.__typename === 'PagesBlocksInteractClubDirectory' && (
		<InteractClubDirectory lang={lang} intro={loc(block.intro, block.introEn)} disclaimer={loc(block.disclaimer, block.disclaimerEn)} />
	)}
	{block.__typename === 'PagesBlocksInteractEventsCalendar' && (
		<InteractEventsCalendar lang={lang} title={loc(block.title, block.titleEn)} calendarId={block.calendarId ?? undefined} />
	)}
	{block.__typename === 'PagesBlocksInteractEventsArchive' && (
		<InteractEventsArchive lang={lang} emptyMessage={loc(block.emptyMessage, block.emptyMessageEn) || undefined} />
	)}
	{block.__typename === 'PagesBlocksRrdTimeline' && (
		<RrdTimeline
			title={loc(block.title, block.titleEn)}
			showDisclaimer={block.showDisclaimer ?? false}
			disclaimerText={loc(block.disclaimerText, block.disclaimerTextEn) || undefined}
			items={(block.items ?? []).filter(nonNull).map((i) => ({
				yearRange: i.yearRange ?? '',
				name: i.name ?? '',
				surname: i.surname ?? '',
				clubName: i.clubName ?? undefined,
				motto: loc(i.motto, i.mottoEn),
				mottoDistretto: loc(i.mottoDistretto, i.mottoDistrettoEn) || undefined,
				eraLabel: loc(i.eraLabel, i.eraLabelEn) || undefined,
				tinaFieldAttr: tinaField(i),
			}))}
		/>
	)}
	{block.__typename === 'PagesBlocksInteractDirTimeline' && (
		// Reuses RrdTimeline.astro unmodified (pure props-in, no Rotaract-specific logic) — only
		// the Tina template differs (see interactDirTimelineTemplate in tina/config.ts), because
		// the RRD template's own label says "RRD" in the block picker, which would be wrong here.
		<RrdTimeline
			title={loc(block.title, block.titleEn)}
			showDisclaimer={block.showDisclaimer ?? false}
			disclaimerText={loc(block.disclaimerText, block.disclaimerTextEn) || undefined}
			items={(block.items ?? []).filter(nonNull).map((i) => ({
				yearRange: i.yearRange ?? '',
				name: i.name ?? '',
				surname: i.surname ?? '',
				clubName: i.clubName ?? undefined,
				motto: loc(i.motto, i.mottoEn),
				mottoDistretto: loc(i.mottoDistretto, i.mottoDistrettoEn) || undefined,
				eraLabel: loc(i.eraLabel, i.eraLabelEn) || undefined,
				tinaFieldAttr: tinaField(i),
			}))}
		/>
	)}
	{block.__typename === 'PagesBlocksEventsArchive' && (
		<EventsArchive lang={lang} emptyMessage={loc(block.emptyMessage, block.emptyMessageEn) || undefined} />
	)}
	{block.__typename === 'PagesBlocksNewsArchive' && (
		<NewsArchive lang={lang} emptyMessage={loc(block.emptyMessage, block.emptyMessageEn) || undefined} showDate={block.showDate ?? undefined} showYear={block.showYear ?? undefined} />
	)}
	{block.__typename === 'PagesBlocksMaterialsGrid' && (
		<MaterialsGrid lang={lang} title={loc(block.title, block.titleEn)} driveFolderId={block.driveFolderId ?? undefined} emptyMessage={loc(block.emptyMessage, block.emptyMessageEn) || undefined} />
	)}
	{block.__typename === 'PagesBlocksResourceArchive' && (
		<ResourceArchive lang={lang} emptyMessage={loc(block.emptyMessage, block.emptyMessageEn) || undefined} />
	)}
</div>
