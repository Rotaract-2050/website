---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../data/copy';
import type { PageKey } from '../data/routes';
import '../styles/global.css';

interface Props {
	lang: Lang;
	current: PageKey;
	title: string;
	description?: string;
}

const { lang, current, title, description } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		{description && <meta name="description" content={description} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<div class="page">
			<Header lang={lang} current={current} />
			<main>
				<slot />
			</main>
			<Footer lang={lang} />
		</div>
	</body>
</html>

<style>
	.page {
		background: var(--color-bg);
		min-height: 100vh;
	}
</style>
