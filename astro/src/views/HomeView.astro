---
import { getRelativeLocaleUrl } from 'astro:i18n';
import HeroCarousel from '../components/HeroCarousel.astro';
import ImageSlot from '../components/ImageSlot.astro';
import type { Lang } from '../data/copy';
import { translations, ZONES } from '../data/copy';
import { pageSlugs } from '../data/routes';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
const clubHref = getRelativeLocaleUrl(lang, pageSlugs.club);
const distrettoHref = getRelativeLocaleUrl(lang, pageSlugs.distretto);
---

<HeroCarousel slides={t.hero} ctaHref={clubHref} />

<section class="stats">
	{t.stats.map((stat) => (
		<div class="stat">
			<div class="stat-value">{stat.value}</div>
			<div class="stat-label">{stat.label}</div>
		</div>
	))}
</section>

<section class="mission">
	<div class="mission-inner">
		<div>
			<div class="eyebrow">{t.mission.eyebrow}</div>
			<h2 class="section-title">{t.mission.title}</h2>
			<p class="body-text">{t.mission.body1}</p>
			<h3 class="subhead">{t.mission.subhead}</h3>
			<p class="body-text">{t.mission.body2}</p>
			<a href={distrettoHref} class="text-link">{t.mission.cta} →</a>
		</div>
		<ImageSlot label="Foto socie/i in un progetto di servizio" shape="rounded" class="mission-image" />
	</div>
</section>

<section class="clubs-strip">
	<div class="section-inner">
		<h2 class="section-title center">{t.clubsSectionTitle}</h2>
		<div class="zone-row">
			{ZONES.map((zone) => (
				<a href={clubHref} class="zone-card">
					<div class="zone-name">{zone.name}</div>
					<div class="zone-count">{zone.clubs.length} {t.clubWord}</div>
				</a>
			))}
		</div>
	</div>
</section>

<section class="events">
	<div class="section-inner">
		<h2 class="section-title">{t.events.title}</h2>
		{t.events.items.map((ev) => (
			<div class="event-row">
				<div class="event-date">
					<div class="event-day">{ev.day}</div>
					<div class="event-month">{ev.month}</div>
				</div>
				<div class="event-body">
					<div class="event-title">{ev.title}</div>
					<div class="event-meta">{ev.time} · {ev.location}</div>
				</div>
				<div class="event-arrow">→</div>
			</div>
		))}
	</div>
</section>

<section class="news">
	<div class="section-inner">
		<h2 class="section-title">{t.news.title}</h2>
		<div class="news-grid">
			{t.news.items.map((n) => (
				<article class="news-card">
					<ImageSlot label="Foto news" class="news-image" />
					<div class="news-body">
						<div class="news-tag">{n.tag}</div>
						<h3 class="news-title">{n.title}</h3>
						<p class="news-excerpt">{n.excerpt}</p>
						<div class="news-date">{n.date}</div>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<section class="cta-banner">
	<h2 class="cta-title">{t.cta.title}</h2>
	<p class="cta-body">{t.cta.body}</p>
	<a href={clubHref} class="cta-button">{t.cta.button}</a>
</section>

<style>
	.stats {
		background: var(--color-navy);
		padding: 40px;
		display: flex;
		justify-content: center;
		gap: 70px;
		flex-wrap: wrap;
	}

	.stat {
		text-align: center;
	}

	.stat-value {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 42px;
		color: var(--color-gold);
		line-height: 1;
	}

	.stat-label {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 1px;
		color: rgba(255, 255, 255, 0.75);
		text-transform: uppercase;
		margin-top: 6px;
	}

	.mission {
		background: #fff;
		padding: 90px 40px;
	}

	.mission-inner {
		max-width: var(--content-max);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 60px;
		align-items: center;
	}

	.mission-inner :global(.mission-image) {
		width: 100%;
		height: 420px;
	}

	.eyebrow {
		color: var(--color-pink);
		font-weight: 700;
		font-size: 13px;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		margin-bottom: 10px;
	}

	.section-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 34px;
		color: var(--color-navy);
		text-transform: uppercase;
		margin: 0 0 20px;
	}

	.section-title.center {
		text-align: center;
		font-size: 28px;
	}

	.body-text {
		font-size: 16px;
		color: var(--color-text);
		line-height: 1.7;
		margin: 0 0 22px;
	}

	.subhead {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 18px;
		color: var(--color-navy);
		margin: 0 0 8px;
	}

	.text-link {
		display: inline-block;
		color: var(--color-pink);
		font-weight: 700;
		font-size: 14px;
		letter-spacing: 0.5px;
		text-transform: uppercase;
	}

	.clubs-strip {
		background: var(--color-bg);
		padding: 80px 40px;
	}

	.section-inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	.clubs-strip .section-title {
		margin-bottom: 34px;
	}

	.zone-row {
		display: flex;
		gap: 20px;
		overflow-x: auto;
		padding-bottom: 10px;
	}

	.zone-card {
		flex: 0 0 auto;
		min-width: 200px;
		background: #fff;
		border-radius: 14px;
		box-shadow: 0 4px 16px rgba(11, 37, 69, 0.07);
		padding: 24px 20px;
		text-align: center;
		color: inherit;
	}

	.zone-card:hover {
		box-shadow: 0 8px 24px rgba(11, 37, 69, 0.12);
	}

	.zone-name {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 17px;
		color: var(--color-navy);
		margin-bottom: 4px;
	}

	.zone-count {
		font-size: 13px;
		color: var(--color-text);
	}

	.events {
		background: #fff;
		padding: 80px 40px;
	}

	.event-row {
		display: flex;
		align-items: center;
		gap: 24px;
		border-bottom: 1px solid var(--color-border);
		padding: 22px 0;
	}

	.event-date {
		flex: 0 0 auto;
		width: 64px;
		background: var(--color-navy);
		border-radius: 10px;
		text-align: center;
		padding: 10px 0;
	}

	.event-day {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 22px;
		color: var(--color-gold);
		line-height: 1;
	}

	.event-month {
		font-size: 11px;
		color: #fff;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		margin-top: 2px;
	}

	.event-body {
		flex: 1;
	}

	.event-title {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 18px;
		color: var(--color-navy);
		margin-bottom: 4px;
	}

	.event-meta {
		font-size: 13px;
		color: var(--color-text);
	}

	.event-arrow {
		color: var(--color-pink);
		font-size: 20px;
	}

	.news {
		background: var(--color-bg);
		padding: 80px 40px;
	}

	.news .section-title {
		margin-bottom: 30px;
	}

	.news-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	.news-card {
		background: #fff;
		border-radius: 14px;
		overflow: hidden;
		box-shadow: 0 4px 16px rgba(11, 37, 69, 0.07);
	}

	.news-card :global(.news-image) {
		width: 100%;
		height: 170px;
	}

	.news-body {
		padding: 20px;
	}

	.news-tag {
		display: inline-block;
		background: rgba(212, 19, 103, 0.1);
		color: var(--color-pink);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		padding: 4px 10px;
		border-radius: 999px;
		margin-bottom: 12px;
	}

	.news-title {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 17px;
		color: var(--color-navy);
		line-height: 1.3;
		margin: 0 0 8px;
	}

	.news-excerpt {
		font-size: 14px;
		color: var(--color-text);
		line-height: 1.5;
		margin: 0 0 12px;
	}

	.news-date {
		font-size: 12px;
		color: var(--color-muted);
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.cta-banner {
		background: var(--color-pink);
		padding: 70px 40px;
		text-align: center;
		color: #fff;
	}

	.cta-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 32px;
		text-transform: uppercase;
		margin: 0 0 14px;
	}

	.cta-body {
		font-size: 16px;
		max-width: 560px;
		margin: 0 auto 28px;
		opacity: 0.92;
		line-height: 1.6;
	}

	.cta-button {
		display: inline-block;
		background: #fff;
		color: var(--color-pink);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 14px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		padding: 14px 30px;
		border-radius: 999px;
	}

	.cta-button:hover {
		background: var(--color-bg);
		color: var(--color-pink);
	}

	@media (max-width: 900px) {
		.mission-inner {
			grid-template-columns: 1fr;
		}

		.news-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.mission,
		.clubs-strip,
		.events,
		.news,
		.cta-banner {
			padding-left: 20px;
			padding-right: 20px;
		}
	}
</style>
