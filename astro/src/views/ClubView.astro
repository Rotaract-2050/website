---
import PageBanner from '../components/PageBanner.astro';
import type { Lang } from '../data/copy';
import { translations, ZONES } from '../data/copy';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
const c = t.club;
---

<PageBanner lang={lang} eyebrow={c.eyebrow} title={c.title} breadcrumbCurrent={c.breadcrumbCurrent} />

<section class="club-list">
	<div class="section-inner">
		<p class="intro">{c.intro}</p>
		<p class="disclaimer">{c.disclaimer}</p>

		{ZONES.map((zone) => (
			<div class="zone-block">
				<h2 class="zone-heading">{zone.name}</h2>
				<div class="club-grid">
					{zone.clubs.map((clubName) => (
						<div class="club-card">
							<div class="club-name">{clubName}</div>
							<div class="club-zone">{zone.name}</div>
							<div class="club-contact">{c.contactCta} →</div>
						</div>
					))}
				</div>
			</div>
		))}
	</div>
</section>

<style>
	.club-list {
		background: #fff;
		padding: 70px 40px 90px;
	}

	.section-inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	.intro {
		font-size: 16px;
		color: var(--color-text);
		line-height: 1.7;
		max-width: 720px;
		margin: 0 0 8px;
	}

	.disclaimer {
		font-size: 12px;
		color: var(--color-muted);
		font-style: italic;
		margin: 0 0 40px;
	}

	.zone-block {
		margin-bottom: 36px;
	}

	.zone-heading {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 20px;
		color: var(--color-navy);
		border-bottom: 3px solid var(--color-pink);
		display: inline-block;
		padding-bottom: 6px;
		margin: 0 0 18px;
	}

	.club-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 18px;
	}

	.club-card {
		background: var(--color-bg);
		border-radius: 12px;
		padding: 20px;
	}

	.club-name {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 16px;
		color: var(--color-navy);
		margin-bottom: 4px;
	}

	.club-zone {
		font-size: 13px;
		color: var(--color-text);
		margin-bottom: 10px;
	}

	.club-contact {
		color: var(--color-pink);
		font-size: 13px;
		font-weight: 600;
	}

	@media (max-width: 900px) {
		.club-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.club-list {
			padding: 50px 20px 70px;
		}

		.club-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
