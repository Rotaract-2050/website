---
import PageBanner from '../components/PageBanner.astro';
import ImageSlot from '../components/ImageSlot.astro';
import type { Lang } from '../data/copy';
import { translations } from '../data/copy';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
const d = t.distretto;
---

<PageBanner lang={lang} eyebrow={d.eyebrow} title={d.title} breadcrumbCurrent={d.breadcrumbCurrent} />

<section class="leader">
	<div class="leader-inner">
		<ImageSlot label="Foto Rappresentante Distrettuale" shape="rounded" class="leader-image" />
		<div>
			<div class="leader-role">{d.leaderRole}</div>
			<h2 class="leader-name">{d.leaderName}</h2>
			<blockquote class="leader-quote">{d.quote}</blockquote>
			<p class="body-text">{d.intro}</p>
			<h3 class="subhead">{d.missionTitle}</h3>
			<p class="body-text no-margin">{d.missionText}</p>
		</div>
	</div>
</section>

<section class="values">
	<div class="section-inner">
		<h2 class="section-title center">{d.valuesTitle}</h2>
		<div class="values-grid">
			{d.values.map((val) => (
				<div class="value-card">
					<div class="value-letter">{val.letter}</div>
					<div class="value-title">{val.title}</div>
					<div class="value-desc">{val.desc}</div>
				</div>
			))}
		</div>
	</div>
</section>

<section class="governance">
	<div class="section-inner">
		<h2 class="section-title center tight">{d.governanceTitle}</h2>
		<p class="disclaimer">{t.sampleDisclaimer}</p>
		<div class="roles-grid">
			{d.roles.map((role) => (
				<div class="role-card">
					<div class="role-initials">{role.initials}</div>
					<div class="role-name">{role.name}</div>
					<div class="role-title">{role.role}</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.leader {
		background: #fff;
		padding: 80px 40px;
	}

	.leader-inner {
		max-width: var(--content-max);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: 60px;
		align-items: start;
	}

	.leader-inner :global(.leader-image) {
		width: 100%;
		height: 380px;
	}

	.leader-role {
		color: var(--color-pink);
		font-weight: 700;
		font-size: 13px;
		letter-spacing: 1px;
		text-transform: uppercase;
		margin-bottom: 6px;
	}

	.leader-name {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 26px;
		color: var(--color-navy);
		margin: 0 0 16px;
	}

	.leader-quote {
		font-size: 17px;
		color: var(--color-navy);
		font-style: italic;
		border-left: 3px solid var(--color-pink);
		padding-left: 16px;
		margin: 0 0 22px;
		line-height: 1.6;
	}

	.body-text {
		font-size: 16px;
		color: var(--color-text);
		line-height: 1.7;
		margin: 0 0 18px;
	}

	.body-text.no-margin {
		margin-bottom: 0;
	}

	.subhead {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 18px;
		color: var(--color-navy);
		margin: 0 0 8px;
	}

	.section-inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	.section-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 28px;
		color: var(--color-navy);
		text-transform: uppercase;
		margin: 0 0 34px;
	}

	.section-title.center {
		text-align: center;
	}

	.section-title.tight {
		margin-bottom: 14px;
	}

	.disclaimer {
		font-size: 12px;
		color: var(--color-muted);
		font-style: italic;
		text-align: center;
		margin: 0 0 34px;
	}

	.values {
		background: var(--color-bg);
		padding: 80px 40px;
	}

	.values-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 24px;
	}

	.value-card {
		background: #fff;
		border-radius: 14px;
		padding: 28px 22px;
		text-align: center;
		box-shadow: 0 4px 16px rgba(11, 37, 69, 0.06);
	}

	.value-letter {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: var(--color-pink);
		color: #fff;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 20px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 14px;
	}

	.value-title {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 16px;
		color: var(--color-navy);
		margin-bottom: 8px;
	}

	.value-desc {
		font-size: 13px;
		color: var(--color-text);
		line-height: 1.5;
	}

	.governance {
		background: #fff;
		padding: 80px 40px;
	}

	.roles-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 24px;
	}

	.role-card {
		background: var(--color-bg);
		border-radius: 14px;
		padding: 26px 18px;
		text-align: center;
	}

	.role-initials {
		width: 56px;
		height: 56px;
		border-radius: 50%;
		background: var(--color-navy);
		color: #fff;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 18px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 14px;
	}

	.role-name {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 15px;
		color: var(--color-navy);
		margin-bottom: 4px;
	}

	.role-title {
		font-size: 12px;
		color: var(--color-text);
	}

	@media (max-width: 900px) {
		.leader-inner {
			grid-template-columns: 1fr;
		}

		.values-grid,
		.roles-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 720px) {
		.leader,
		.values,
		.governance {
			padding-left: 20px;
			padding-right: 20px;
		}
	}
</style>
