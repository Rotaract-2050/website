---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DistrettoView from '../../views/DistrettoView.astro';
import { translations } from '../../data/copy';

const lang = 'en';
const t = translations[lang];
---

<BaseLayout lang={lang} current="distretto" title={`${t.distretto.title} · Rotaract District 2050`} description={t.distretto.intro}>
	<DistrettoView lang={lang} />
</BaseLayout>
