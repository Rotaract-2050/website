---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../data/copy';
import { translations, SOCIAL_LINKS } from '../data/copy';
import { pageSlugs, type PageKey } from '../data/routes';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
const href = (page: PageKey) => getRelativeLocaleUrl(lang, pageSlugs[page]);
---

<footer class="site-footer">
	<div class="footer-grid">
		<div>
			<div class="footer-title">ROTARACT DISTRETTO 2050</div>
			<p class="footer-about">{t.footer.about}</p>
		</div>
		<div>
			<div class="footer-heading">{t.footer.linksTitle}</div>
			<div class="footer-links">
				<a href={href('home')}>{t.nav.home}</a>
				<a href={href('distretto')}>{t.nav.distrettoMenu}</a>
				<a href={href('club')}>{t.nav.club}</a>
				<a href={href('esecutivo')}>{t.nav.esecutivo}</a>
				<a href={href('delegati')}>{t.nav.delegati}</a>
				<a href={href('commissioni')}>{t.nav.commissioni}</a>
			</div>
		</div>
		<div>
			<div class="footer-heading">{t.footer.contactTitle}</div>
			<p class="footer-contact">{t.footer.address}<br />{t.footer.email}</p>
		</div>
		<div>
			<div class="footer-heading">{t.footer.socialTitle}</div>
			<div class="footer-social">
				{SOCIAL_LINKS.map((soc) => (
					<a href={soc.href} class="social-icon" aria-label={soc.label}>{soc.label}</a>
				))}
			</div>
		</div>
	</div>
	<div class="footer-bottom">
		<div>{t.footer.copyright}</div>
		<div>{t.footer.underRotary}</div>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-navy);
		color: #fff;
		padding: 60px 40px 0;
	}

	.footer-grid {
		max-width: var(--content-max);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.4fr 0.8fr 1fr 0.8fr;
		gap: 40px;
		padding-bottom: 40px;
	}

	.footer-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 20px;
		margin-bottom: 14px;
	}

	.footer-about {
		font-size: 14px;
		color: rgba(255, 255, 255, 0.65);
		line-height: 1.6;
		margin: 0;
	}

	.footer-heading {
		font-weight: 700;
		font-size: 12px;
		letter-spacing: 1px;
		text-transform: uppercase;
		margin-bottom: 16px;
		color: var(--color-gold);
	}

	.footer-links {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.footer-links a {
		font-size: 14px;
		color: rgba(255, 255, 255, 0.75);
	}

	.footer-links a:hover {
		color: #fff;
	}

	.footer-contact {
		font-size: 14px;
		color: rgba(255, 255, 255, 0.75);
		line-height: 1.7;
		margin: 0;
	}

	.footer-social {
		display: flex;
		gap: 10px;
	}

	.social-icon {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.1);
		color: #fff;
		font-size: 12px;
		font-weight: 700;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.social-icon:hover {
		background: rgba(255, 255, 255, 0.2);
		color: #fff;
	}

	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		padding: 20px 0;
		display: flex;
		justify-content: space-between;
		max-width: var(--content-max);
		margin: 0 auto;
		font-size: 12px;
		color: rgba(255, 255, 255, 0.5);
		flex-wrap: wrap;
		gap: 8px;
	}

	@media (max-width: 900px) {
		.site-footer {
			padding: 60px 20px 0;
		}

		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 540px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
