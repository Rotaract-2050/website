---
import { Image } from 'astro:assets';
import ImageSlot from '../ImageSlot.astro';

interface NewsItem {
	tag: string;
	title: string;
	excerpt: string;
	date: string;
	image?: string;
	imageLabel: string;
}

interface Props {
	title: string;
	items: NewsItem[];
}

const { title, items } = Astro.props;
---

<section class="news">
	<div class="section-inner">
		<h2 class="section-title">{title}</h2>
		<div class="news-grid">
			{items.map((n) => (
				<article class="news-card">
					{n.image ? <Image src={n.image} alt={n.imageLabel} width={400} height={170} class="news-image" /> : <ImageSlot label={n.imageLabel} class="news-image" />}
					<div class="news-body">
						<div class="news-tag">{n.tag}</div>
						<h3 class="news-title">{n.title}</h3>
						<p class="news-excerpt">{n.excerpt}</p>
						<div class="news-date">{n.date}</div>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.news {
		background: var(--color-bg);
		padding: 80px 40px;
	}

	.section-inner {
		max-width: var(--content-max);
		margin: 0 auto;
	}

	.section-title {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 34px;
		color: var(--color-navy);
		text-transform: uppercase;
		margin: 0 0 30px;
	}

	.news-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	.news-card {
		background: #fff;
		border-radius: 14px;
		overflow: hidden;
		box-shadow: 0 4px 16px rgba(11, 37, 69, 0.07);
	}

	.news-card :global(.news-image) {
		width: 100%;
		height: 170px;
		object-fit: cover;
	}

	.news-body {
		padding: 20px;
	}

	.news-tag {
		display: inline-block;
		background: rgba(212, 19, 103, 0.1);
		color: var(--color-pink);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		padding: 4px 10px;
		border-radius: 999px;
		margin-bottom: 12px;
	}

	.news-title {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 17px;
		color: var(--color-navy);
		line-height: 1.3;
		margin: 0 0 8px;
	}

	.news-excerpt {
		font-size: 14px;
		color: var(--color-text);
		line-height: 1.5;
		margin: 0 0 12px;
	}

	.news-date {
		font-size: 12px;
		color: var(--color-muted);
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	@media (max-width: 900px) {
		.news-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.news {
			padding-left: 20px;
			padding-right: 20px;
		}
	}
</style>
