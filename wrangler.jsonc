{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "website",
	// Set this to today's date when bumping
	"compatibility_date": "2026-08-11",
	"compatibility_flags": ["nodejs_compat"],
	// Powers astro:assets image resizing/conversion (see astro.config.mjs imageService).
	// remote: true makes `wrangler dev` hit the real Images API instead of the limited
	// local simulator, so resize/format previews match production.
	"images": {
		"binding": "IMAGES",
		"remote": true
	},
	// Self-hosted Tina backend (cms-backend/ on the District VPS) for runtime reads and the /api/tina/* proxy.
	// Not a secret; preview-dev.yml overrides it with --var so previews never touch main's backend.
	"vars": {
		"TINA_BACKEND_URL": "https://cms.rotaract2050.org"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true
		}
	}
}
