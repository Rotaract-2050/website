{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "website",
	// Set this to today's date when bumping
	"compatibility_date": "2026-08-11",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true
		}
	}
}
